<Project>

  <!--
    Banned API enforcement for every assembly we ship.

    Analyzers/BannedSymbols.txt has to be an AdditionalFile: Microsoft.CodeAnalysis.BannedApiAnalyzers
    reads it through the analyzer additional-files channel and silently enforces nothing when the file
    is passed as Content instead.

    This lives in Directory.Build.targets rather than Directory.Build.props because $(IsPackable) is
    not final until the project body has been evaluated, and $(IsPackable) is how this repository marks
    the projects that ship (tests, examples, benchmarks and Quartz.Server all set it to false).
  -->
  <ItemGroup Condition="'$(IsPackable)' == 'true' and $(MSBuildProjectName.Contains('BenchmarkDotNet.Autogenerated')) == false">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)Analyzers/BannedSymbols.txt" Link="BannedSymbols.txt" />
  </ItemGroup>

</Project>
