@page "/quartz/executing"
@using Microsoft.Extensions.Options
@using Quartz
@using Quartz.Dashboard.Components.Shared
@using Quartz.Dashboard.Services
@implements IDisposable
@inject IQuartzApiClient Api
@inject SchedulerState Scheduler
@inject SchedulerAuthorization Authorization
@inject ToastService Toasts
@inject DashboardActionLog ActionLog
@inject IOptions<QuartzDashboardOptions> Options

<div class="qz-page">
    <AutoRefresh Every="TimeSpan.FromSeconds(1)" Refresh="RefreshAsync" />
    <div class="qz-page-header">
        <h1>Currently Executing</h1>
        <span class="qz-muted" style="font-size: var(--qz-font-size-xs);">Auto-refreshes every 1s</span>
        <LastUpdated At="@_lastUpdatedAt" />
    </div>

    @if (_isLoading)
    {
        <p class="qz-muted">Loading currently executing jobs...</p>
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <ErrorAlert Message="@_error" OnRetry="LoadDataAsync" />
    }

    <div class="qz-table-scroll">
    <table class="qz-table">
        <thead>
            <tr>
                <th>Job</th>
                <th>Trigger</th>
                <th>Node</th>
                <th>Execution Group</th>
                <th>Fire Time</th>
                <th>Run Time</th>
                <th>Progress</th>
                <th>History</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (_fireInstances.Count == 0)
            {
                <tr>
                    <td colspan="@TableColumnCount" class="qz-muted">No jobs currently executing.</td>
                </tr>
            }
            else
            {
                @foreach (FireInstanceDto fireInstance in _fireInstances)
                {
                    @* Keyed by its firing, so a row keeps its elements, and Show log the reference its dialog gives focus
                       back to, however the listing reorders. *@
                    <tr @key="fireInstance.FireInstanceId">
                        <td>
                            @if (fireInstance.JobKey is not null)
                            {
                                <KeyBadge GroupName="@fireInstance.JobKey.Group" ItemName="@fireInstance.JobKey.Name" />
                            }
                            else
                            {
                                <span class="qz-muted">&#8212;</span>
                            }
                        </td>
                        <td><KeyBadge GroupName="@fireInstance.TriggerKey.Group" ItemName="@fireInstance.TriggerKey.Name" /></td>
                        <td>@fireInstance.SchedulerInstanceId</td>
                        <td>@(string.IsNullOrEmpty(fireInstance.ExecutionGroup) ? "—" : fireInstance.ExecutionGroup)</td>
                        <td>@FormatFireTime(fireInstance.FireTimeUtc)</td>
                        <td>
                            @FormatRunTime(fireInstance.FireTimeUtc)
                            @if (fireInstance.InterruptRequestedUtc is { } requestedAt)
                            {
                                @* Asked of another node, which acts after its next check-in: until the firing
                                   ends, the row has been told to stop and may still be running. *@
                                <div>
                                    <span class="qz-state-indicator qz-state-paused"
                                          data-testid="interrupt-requested"
                                          title="@("Interrupt requested at " + FormatFireTime(requestedAt) + "; the node running it acts after its next check-in")">
                                        <span class="qz-state-dot"></span>Interrupt requested
                                    </span>
                                </div>
                            }
                        </td>
                        <td>
                            @if (fireInstance.Progress is int percent)
                            {
                                <div class="qz-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@percent" aria-label="Progress">
                                    <div class="qz-progress-track">
                                        <div class="qz-progress-fill" style="width: @(percent)%;"></div>
                                    </div>
                                    <span class="qz-progress-value">@(percent)%</span>
                                </div>
                                @if (!string.IsNullOrEmpty(fireInstance.ProgressMessage))
                                {
                                    <div class="qz-progress-message qz-muted">@fireInstance.ProgressMessage</div>
                                }
                            }
                            else
                            {
                                <span class="qz-muted">&#8212;</span>
                            }
                        </td>
                        <td>
                            @* A firing's own execution page exists once it has finished and the history has a
                               row for it, so what a running row links to is its trigger's finished runs, each
                               of which opens its execution page with the log it captured. *@
                            <a class="qz-details-link"
                               data-testid="executing-history-link"
                               title="This firing gets an execution page of its own once it finishes"
                               href="@GetHistoryPathForTrigger(fireInstance.TriggerKey)">Past runs</a>
                        </td>
                        <td>
                            <div class="qz-actions">
                                @* A read, so every visitor who sees the scheduler gets it, read-only too: the lines are
                                   the ones Execution Detail shows once the run ends. *@
                                <button type="button"
                                        class="qz-button"
                                        data-testid="executing-show-log"
                                        @ref="_logButtons[fireInstance.FireInstanceId]"
                                        @onclick="() => OpenLog(fireInstance)">Show log</button>
                                @if (ShowInterrupt)
                                {
                                    <button type="button" class="qz-button qz-button-danger" @onclick="() => InterruptAsync(fireInstance.FireInstanceId)">Interrupt</button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
    </div>

    @if (_hasMore)
    {
        <p class="qz-muted">Showing the first @_fireInstances.Count of @_totalCount executions.</p>
    }

    @* Outside the table, with its own copy of the row: the refresh a second from now drops a firing that has ended,
       and the dialog stays to say so and point to its execution page. *@
    @if (_logFiring is { } firing && _logScheduler is { } logScheduler)
    {
        <FireInstanceLogDialog Firing="firing" SchedulerName="@logScheduler" ReturnFocus="_logOpener" OnClose="CloseLog" />
    }
</div>

@code {
    private readonly List<FireInstanceDto> _fireInstances = [];
    private bool _isLoading = true;
    private bool _loadingInProgress;
    private bool _hasMore;
    private int _totalCount;
    private string? _error;
    private DateTimeOffset? _lastUpdatedAt;

    /// <summary>
    /// Cancelled when the reader leaves the page, which stops the read in flight: its answer would be thrown away.
    /// </summary>
    private readonly CancellationTokenSource _cancellation = new();

    /// <summary>
    /// Whether the column is offered. A window onto an attached store offers it too, from 4.7: it asks the
    /// node running the firing through the firing's row, and says so when that node never reads one.
    /// </summary>
    private bool ShowInterrupt => Authorization.Allows(Scheduler.ActiveSchedulerName, Quartz.HttpApiContract.SchedulerRoutes.InterruptJobInstance);
    private const int TableColumnCount = 9;

    /// <summary>Each row's Show log, which focus goes back to as its dialog closes.</summary>
    private readonly Dictionary<string, ElementReference> _logButtons = new(StringComparer.Ordinal);

    /// <summary>The firing whose log is open, as its row was when Show log was pressed; null while none is.</summary>
    private FireInstanceDto? _logFiring;
    private string? _logScheduler;
    private ElementReference? _logOpener;

    protected override async Task OnInitializedAsync()
    {
        Scheduler.OnSchedulerChanged += OnSchedulerChanged;
        Scheduler.OnDisplayChanged += OnDisplayChanged;
        await LoadDataAsync();
    }

    private async void OnSchedulerChanged(object? sender, EventArgs e)
    {
        // A firing of the scheduler the page no longer shows.
        _logFiring = null;
        await LoadDataAsync();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>The time zone changed: draw the fire times again in it, and read nothing.</summary>
    private void OnDisplayChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// The once-a-second read, which <see cref="AutoRefresh" /> holds back while the tab is hidden.
    /// </summary>
    private async Task RefreshAsync()
    {
        await LoadDataAsync();
        StateHasChanged();
    }

    private async Task LoadDataAsync()
    {
        if (_loadingInProgress)
        {
            return;
        }

        _loadingInProgress = true;
        _error = null;

        try
        {
            string? schedulerName = Scheduler.ActiveSchedulerName;
            _fireInstances.Clear();
            _hasMore = false;
            _totalCount = 0;

            if (!string.IsNullOrWhiteSpace(schedulerName))
            {
                CancellationToken cancellationToken = _cancellation.Token;

                // Once per scheduler, so the Interrupt column renders from what the visitor's role allows.
                await Authorization.LoadOperations(schedulerName, cancellationToken);

                PagedResult<FireInstanceDto> page = await Api.QueryFireInstances(schedulerName, new DashboardFireInstanceQuery(), cancellationToken);
                _fireInstances.AddRange(page.Items);
                _hasMore = page.HasMore;
                _totalCount = page.TotalCount ?? page.Items.Count;
            }
        }
        catch (OperationCanceledException) when (_cancellation.IsCancellationRequested)
        {
            // The reader left. A read nobody is waiting for is not a failure.
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            ForgetShowLogButtonsOfFiringsGone();
            _lastUpdatedAt = DateTimeOffset.UtcNow;
            _isLoading = false;
            _loadingInProgress = false;
        }
    }

    /// <summary>
    /// Drops the Show log references of the firings no longer listed, and keeps the rest.
    /// </summary>
    /// <remarks>
    /// Blazor captures an element's reference once, as it creates the element, and each row is keyed by its
    /// firing, so a listed firing's button, and its reference, outlive every refresh. Clearing them all would
    /// leave nothing to give focus back to once the page had read again.
    /// </remarks>
    private void ForgetShowLogButtonsOfFiringsGone()
    {
        HashSet<string> listed = new(_fireInstances.Select(firing => firing.FireInstanceId), StringComparer.Ordinal);
        foreach (string gone in _logButtons.Keys.Where(id => !listed.Contains(id)).ToList())
        {
            _logButtons.Remove(gone);
        }
    }

    private async Task InterruptAsync(string fireInstanceId)
    {
        if (!ShowInterrupt || string.IsNullOrWhiteSpace(Scheduler.ActiveSchedulerName))
        {
            return;
        }

        try
        {
            // The one execution the row shows, not every execution of its job: the fire instance id is
            // what tells them apart.
            bool interrupted = await Api.InterruptFireInstance(Scheduler.ActiveSchedulerName, fireInstanceId);

            // Recorded whichever way it went, and recorded as node-local: an interrupt has to reach the
            // node running the firing, so the record of it is only honest if it says which node that was.
            ActionLog.Record(
                Scheduler.ActiveSchedulerName,
                "InterruptFireInstance",
                fireInstanceId,
                succeeded: interrupted,
                interrupted ? null : "the firing is no longer running on this node",
                nodeLocal: true);

            if (!interrupted)
            {
                // The row is a snapshot of a list that moves: by the time the button is pressed the
                // firing may have finished, and a page that said nothing would look as though the
                // interrupt had been delivered.
                Toasts.Info("Execution " + fireInstanceId + " was not interrupted - it is no longer running on this node.");
            }

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            ActionLog.Failed(
                Scheduler.ActiveSchedulerName,
                "InterruptFireInstance",
                fireInstanceId,
                ex,
                nodeLocal: true);

            // Said where every other page says a failed action, as a toast. An error on the page would be
            // cleared by the refresh a second later, before anyone had read it; a refusal for the visitor's
            // role is one of these too, because the button was offered when the page last asked.
            Toasts.Error(ex.Message);
        }
    }

    private void OpenLog(FireInstanceDto fireInstance)
    {
        if (string.IsNullOrWhiteSpace(Scheduler.ActiveSchedulerName))
        {
            return;
        }

        _logScheduler = Scheduler.ActiveSchedulerName;
        _logOpener = _logButtons.TryGetValue(fireInstance.FireInstanceId, out ElementReference opener) ? opener : null;
        _logFiring = fireInstance;
    }

    private void CloseLog()
    {
        _logFiring = null;
    }

    private string GetHistoryPathForTrigger(TriggerKeyDto triggerKey)
    {
        return DashboardLink.HistoryOfTrigger(Options.Value, triggerKey.Group, triggerKey.Name);
    }

    private string FormatFireTime(DateTimeOffset? fireTime)
    {
        return Scheduler.FormatInSelectedTimeZone(fireTime, "u");
    }

    private static string FormatRunTime(DateTimeOffset? fireTime)
    {
        if (!fireTime.HasValue)
        {
            return "n/a";
        }

        // Observer clock minus the firing node's, so a cluster with skewed clocks can produce a negative
        // elapsed time. Clamped rather than shown, because a negative run time is never the truth.
        TimeSpan runTime = DateTimeOffset.UtcNow - fireTime.Value;
        if (runTime < TimeSpan.Zero)
        {
            runTime = TimeSpan.Zero;
        }

        return DisplayValueHelper.FormatClock(runTime);
    }

    public void Dispose()
    {
        Scheduler.OnSchedulerChanged -= OnSchedulerChanged;
        Scheduler.OnDisplayChanged -= OnDisplayChanged;
        _cancellation.Cancel();
        _cancellation.Dispose();
    }
}
