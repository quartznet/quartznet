@page "/quartz/executing"
@using Microsoft.Extensions.Options
@using Quartz
@using Quartz.Dashboard.Components.Shared
@using Quartz.Dashboard.Services
@implements IDisposable
@inject IQuartzApiClient Api
@inject SchedulerState Scheduler
@inject IOptions<QuartzDashboardOptions> Options

<div class="qz-page">
    <div class="qz-page-header">
        <h1>Currently Executing</h1>
        <span class="qz-muted" style="font-size: var(--qz-font-size-xs);">Auto-refreshes every 1s</span>
        <span class="qz-muted" style="font-size: var(--qz-font-size-xs);">Last updated: @FormatLastUpdated(_lastUpdatedAt)</span>
    </div>

    @if (_isLoading)
    {
        <p class="qz-muted">Loading currently executing jobs...</p>
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <ErrorAlert Message="@_error" OnRetry="LoadDataAsync" />
    }

    <table class="qz-table">
        <thead>
            <tr>
                <th>Job</th>
                <th>Trigger</th>
                <th>Node</th>
                <th>Execution Group</th>
                <th>Fire Time</th>
                <th>Run Time</th>
                @if (!IsReadOnly)
                {
                    <th>Actions</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (_fireInstances.Count == 0)
            {
                <tr>
                    <td colspan="@TableColumnCount" class="qz-muted">No jobs currently executing.</td>
                </tr>
            }
            else
            {
                @foreach (FireInstanceDto fireInstance in _fireInstances)
                {
                    <tr>
                        <td>
                            @if (fireInstance.JobKey is not null)
                            {
                                <KeyBadge GroupName="@fireInstance.JobKey.Group" ItemName="@fireInstance.JobKey.Name" />
                            }
                            else
                            {
                                <span class="qz-muted">&#8212;</span>
                            }
                        </td>
                        <td><KeyBadge GroupName="@fireInstance.TriggerKey.Group" ItemName="@fireInstance.TriggerKey.Name" /></td>
                        <td>@fireInstance.SchedulerInstanceId</td>
                        <td>@(string.IsNullOrEmpty(fireInstance.ExecutionGroup) ? "—" : fireInstance.ExecutionGroup)</td>
                        <td>@FormatFireTime(fireInstance.FireTimeUtc)</td>
                        <td>@FormatRunTime(fireInstance.FireTimeUtc)</td>
                        @if (!IsReadOnly)
                        {
                            <td>
                                <button type="button" class="qz-button qz-button-danger" @onclick="() => InterruptAsync(fireInstance.FireInstanceId)">Interrupt</button>
                            </td>
                        }
                    </tr>
                }
            }
        </tbody>
    </table>

    @if (_hasMore)
    {
        <p class="qz-muted">Showing the first @_fireInstances.Count of @_totalCount executions.</p>
    }
</div>

@code {
    private readonly List<FireInstanceDto> _fireInstances = [];
    private bool _isLoading = true;
    private bool _loadingInProgress;
    private bool _hasMore;
    private int _totalCount;
    private string? _error;
    private PeriodicTimer? _refreshTimer;
    private CancellationTokenSource? _refreshLoopCancellation;
    private DateTimeOffset? _lastUpdatedAt;

    private bool IsReadOnly => Options.Value.ReadOnly;
    private int TableColumnCount => IsReadOnly ? 6 : 7;

    protected override async Task OnInitializedAsync()
    {
        Scheduler.OnSchedulerChanged += OnSchedulerChanged;
        _refreshLoopCancellation = new CancellationTokenSource();
        _refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _ = RunRefreshLoopAsync(_refreshLoopCancellation.Token);
        await LoadDataAsync();
    }

    private async void OnSchedulerChanged(object? sender, EventArgs e)
    {
        await LoadDataAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RunRefreshLoopAsync(CancellationToken cancellationToken)
    {
        if (_refreshTimer is null)
        {
            return;
        }

        try
        {
            while (await _refreshTimer.WaitForNextTickAsync(cancellationToken))
            {
                try
                {
                    await InvokeAsync(async () =>
                    {
                        await LoadDataAsync();
                        StateHasChanged();
                    });
                }
                catch (OperationCanceledException)
                {
                    break;
                }
                catch (ObjectDisposedException)
                {
                    break;
                }
                catch (InvalidOperationException)
                {
                }
                catch (Exception ex)
                {
                    _error = ex.Message;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private async Task LoadDataAsync()
    {
        if (_loadingInProgress)
        {
            return;
        }

        _loadingInProgress = true;
        _error = null;

        try
        {
            string? schedulerName = Scheduler.ActiveSchedulerName;
            _fireInstances.Clear();
            _hasMore = false;
            _totalCount = 0;

            if (!string.IsNullOrWhiteSpace(schedulerName))
            {
                PagedResult<FireInstanceDto> page = await Api.QueryFireInstances(schedulerName, new DashboardFireInstanceQuery());
                _fireInstances.AddRange(page.Items);
                _hasMore = page.HasMore;
                _totalCount = page.TotalCount ?? page.Items.Count;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _lastUpdatedAt = DateTimeOffset.UtcNow;
            _isLoading = false;
            _loadingInProgress = false;
        }
    }

    private async Task InterruptAsync(string fireInstanceId)
    {
        if (IsReadOnly || string.IsNullOrWhiteSpace(Scheduler.ActiveSchedulerName))
        {
            return;
        }

        try
        {
            // The one execution the row shows, not every execution of its job: the fire instance id is
            // what tells them apart.
            await Api.InterruptFireInstance(Scheduler.ActiveSchedulerName, fireInstanceId);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private string FormatFireTime(DateTimeOffset? fireTime)
    {
        return Scheduler.FormatInSelectedTimeZone(fireTime, "u");
    }

    private static string FormatRunTime(DateTimeOffset? fireTime)
    {
        if (!fireTime.HasValue)
        {
            return "n/a";
        }

        // Observer clock minus the firing node's, so a cluster with skewed clocks can produce a negative
        // elapsed time. Clamped rather than shown, because a negative run time is never the truth.
        TimeSpan runTime = DateTimeOffset.UtcNow - fireTime.Value;
        if (runTime < TimeSpan.Zero)
        {
            runTime = TimeSpan.Zero;
        }

        return runTime.ToString(@"hh\:mm\:ss");
    }

    private string FormatLastUpdated(DateTimeOffset? lastUpdatedAt)
    {
        return Scheduler.FormatInSelectedTimeZone(lastUpdatedAt, "HH:mm:ss");
    }

    public void Dispose()
    {
        Scheduler.OnSchedulerChanged -= OnSchedulerChanged;
        _refreshLoopCancellation?.Cancel();
        _refreshLoopCancellation?.Dispose();
        _refreshTimer?.Dispose();
    }
}
