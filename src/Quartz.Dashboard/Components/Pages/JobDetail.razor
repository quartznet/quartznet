@page "/quartz/jobs/{Group}/{Name}"
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Options
@using Quartz
@using Quartz.Dashboard.Components.Shared
@using Quartz.Dashboard.Services
@implements IDisposable
@inject IQuartzApiClient Api
@inject SchedulerState Scheduler
@inject IOptions<QuartzDashboardOptions> Options
@inject NavigationManager Navigation
@inject ToastService Toasts
@inject DashboardActionLog ActionLog
@inject IServiceProvider Services

<div class="qz-page">
    <h1>Job Detail</h1>

    @if (_isLoading)
    {
        <LoadingSpinner />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <ErrorAlert Message="@_error" OnRetry="LoadDataAsync" />
    }
    else if (_job is null)
    {
        <p class="qz-muted">Job not found.</p>
    }
    else
    {
        <div class="qz-row">
            <KeyBadge GroupName="@Group" ItemName="@Name" />
            <PauseNote Pause="@_groupPause" />
            <a class="qz-details-link" href="@GetHistoryPathForJob(Group, Name)">View execution history</a>
            @if (!IsReadOnly)
            {
                <div class="qz-actions">
                    <button type="button" class="qz-button" @onclick="PromptPause">Pause</button>
                    <button type="button" class="qz-button" @onclick="ResumeAsync">Resume</button>
                    <button type="button" class="qz-button qz-button-primary" @onclick="TriggerAsync">Trigger now</button>
                    <button type="button" class="qz-button qz-button-danger" @onclick="PromptDelete">Delete</button>
                </div>
            }
        </div>

        <table class="qz-table">
            <tbody>
                <tr><th>Type</th><td>@_job.JobType</td></tr>
                <tr><th>Description</th><td>@_job.Description</td></tr>
                <tr><th>Durable</th><td>@_job.Durable</td></tr>
                <tr><th>Requests Recovery</th><td>@_job.RequestsRecovery</td></tr>
                <tr><th>Disallow Concurrent Execution</th><td>@_job.ConcurrentExecutionDisallowed</td></tr>
                <tr><th>Persist JobDataAfterExecution</th><td>@_job.PersistJobDataAfterExecution</td></tr>
            </tbody>
        </table>

        @if (_statusKept)
        {
            <h2>Runs</h2>
            @if (_status is null)
            {
                <p class="qz-muted" data-testid="job-run-status-none">No run of this job has been recorded.</p>
            }
            else
            {
                <table class="qz-table" data-testid="job-run-status">
                    <tbody>
                        <tr>
                            <th>Last run</th>
                            <td class="qz-job-status-last-run">
                                <span class="qz-run-summary">
                                    <StateIndicator State="@RunResultDisplay.Label(_status.LastResult)" />
                                    @if (_status.LastEntryId is { Length: > 0 } entryId)
                                    {
                                        <a class="qz-details-link" href="@GetExecutionPath(entryId)">@Scheduler.FormatInSelectedTimeZone(_status.LastFiredAtUtc)</a>
                                    }
                                    else
                                    {
                                        <span>@Scheduler.FormatInSelectedTimeZone(_status.LastFiredAtUtc)</span>
                                    }
                                    <span class="qz-muted">on @(_status.LastSchedulerInstanceId ?? "—")</span>
                                </span>
                            </td>
                        </tr>
                        <tr><th>Last summary</th><td>@(string.IsNullOrEmpty(_status.LastSummary) ? "—" : _status.LastSummary)</td></tr>
                        <tr><th>Last success</th><td class="qz-job-status-last-success">@(_status.LastSucceededAtUtc is { } succeeded ? Scheduler.FormatInSelectedTimeZone(succeeded) : "never")</td></tr>
                        <tr>
                            <th>Last failure</th>
                            <td class="qz-job-status-last-failure">
                                @if (_status.LastFailedAtUtc is { } failed)
                                {
                                    <span class="qz-run-summary">
                                        <span>@Scheduler.FormatInSelectedTimeZone(failed)</span>
                                        <span class="qz-muted">@_status.LastFailureMessage</span>
                                    </span>
                                }
                                else
                                {
                                    @("never")
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>Failing</th>
                            <td class="qz-job-status-failing">
                                @if (_status.ConsecutiveFailures > 0)
                                {
                                    <span class="qz-failing-badge">@("failing ×" + _status.ConsecutiveFailures.ToString(System.Globalization.CultureInfo.InvariantCulture))</span>
                                }
                                else
                                {
                                    @("no")
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>Recorded</th>
                            <td class="qz-job-status-counts">@_status.RunCount run(s), @_status.FailureCount failed for good, since @Scheduler.FormatInSelectedTimeZone(_status.FirstFiredAtUtc)</td>
                        </tr>
                    </tbody>
                </table>
            }
        }

        @* The job's runs over time, read with the window chosen here; left out where the source cannot count. *@
        <RunStatisticsChart Statistics="@_statistics?.Statistics"
                            From="@_statistics?.From"
                            Before="@(_statistics?.Before ?? default)"
                            Scope="@_window.Scope"
                            HeadingId="job-run-statistics">
            <Controls>
                <span class="qz-run-window">
                    <label class="qz-form-label" for="job-run-window">Window</label>
                    <select id="job-run-window"
                            class="qz-select"
                            data-testid="job-run-window"
                            value="@_window.Key"
                            @onchange="OnWindowChangedAsync">
                        @foreach (RunStatisticsWindow window in RunStatisticsWindow.Offered)
                        {
                            <option value="@window.Key">@window.Label</option>
                        }
                    </select>
                </span>
            </Controls>
        </RunStatisticsChart>

        <h2>JobDataMap</h2>
        <JobDataMapEditor DataMap="@JobDataMap" ReadOnly="true" />
        @if (!IsReadOnly)
        {
            <h2>Trigger with JobDataMap overrides</h2>
            <p class="qz-muted">Provide optional override values that will be merged for this trigger run.</p>
            <JobDataMapEditor DataMap="@_triggerDataMap" ReadOnly="false" />
            <div class="qz-actions qz-group-actions">
                <button type="button" class="qz-button qz-button-primary" @onclick="TriggerWithDataAsync">Trigger with overrides</button>
                <button type="button" class="qz-button" @onclick="ResetTriggerDataMapAsync">Reset</button>
            </div>
        }

        <h2>Associated triggers</h2>
        @if (_triggers.Count == 0)
        {
            <p class="qz-muted">No associated triggers.</p>
        }
        else
        {
            <table class="qz-table">
                <thead>
                    <tr>
                        <th>Trigger</th>
                        <th>Type</th>
                        <th>Schedule</th>
                        <th>State</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (TriggerHeaderDto trigger in _triggers)
                    {
                        string triggerGroup = trigger.Group;
                        string triggerName = trigger.Name;
                        string triggerType = trigger.TriggerType ?? string.Empty;
                        string triggerSchedule = trigger.ScheduleSummary ?? string.Empty;
                        string triggerState = trigger.State?.ToString() ?? "Unknown";
                        <tr>
                            <td>
                                <a href="@GetTriggerPath(triggerGroup, triggerName)">
                                    <KeyBadge GroupName="@triggerGroup" ItemName="@triggerName" />
                                </a>
                            </td>
                            <td>@(triggerType is { Length: > 0 } ? triggerType : "—")</td>
                            <td>@(triggerSchedule is { Length: > 0 } ? triggerSchedule : "—")</td>
                            <td>
                                <StateIndicator State="@triggerState" />
                                <PauseNote Pause="@trigger.Pause" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
</div>

<ConfirmDialog IsOpen="@_showDeleteConfirm"
               Title="Delete job"
               Message="@($"Delete {DisplayValueHelper.FormatKey(Group, Name)}? This cannot be undone.")"
               OnConfirm="DeleteAsync"
               OnCancel="CancelDeleteAsync" />

<PauseDialog IsOpen="@_showPausePrompt"
             Title="Pause job"
             Message="@($"Pause every trigger of {DisplayValueHelper.FormatKey(Group, Name)}?")"
             OnConfirm="PauseAsync"
             OnCancel="CancelPauseAsync" />

@code {
    private bool _isLoading = true;
    private string? _error;
    private JobDetailDto? _job;
    private readonly List<TriggerHeaderDto> _triggers = [];
    private bool _showDeleteConfirm;
    private bool _showPausePrompt;
    private PauseInfo? _groupPause;
    private JobDataMap _triggerDataMap = new();

    /// <summary>
    /// How the job's runs have gone, or <see langword="null" /> when none has been recorded.
    /// </summary>
    private JobRunStatus? _status;

    /// <summary>
    /// Whether the data source keeps per-job run statuses at all. When it does not, the panel is left out
    /// rather than saying the job has never run.
    /// </summary>
    private bool _statusKept;

    /// <summary>The window the chart covers: the whole history until one is chosen.</summary>
    private RunStatisticsWindow _window = RunStatisticsWindow.All;

    /// <summary>
    /// The job's runs over the window, or <see langword="null" /> when the data source cannot count them and
    /// the chart is left out.
    /// </summary>
    private RunStatisticsView? _statistics;

    private TimeProvider Clock => Services.GetService<TimeProvider>() ?? TimeProvider.System;

    [Parameter]
    public string Group { get; set; } = string.Empty;

    [Parameter]
    public string Name { get; set; } = string.Empty;

    private bool IsReadOnly => Options.Value.ReadOnly;

    private JobKeyDto JobKey => new(Group, Name);

    private JobDataMap? JobDataMap => _job?.JobDataMap;

    protected override async Task OnInitializedAsync()
    {
        Scheduler.OnSchedulerChanged += OnSchedulerChanged;
        await LoadDataAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadDataAsync();
    }

    private async void OnSchedulerChanged(object? sender, EventArgs e)
    {
        await LoadDataAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            _job = null;
            _groupPause = null;
            _status = null;
            _statusKept = false;
            _statistics = null;
            _triggers.Clear();

            string? schedulerName = Scheduler.ActiveSchedulerName;
            if (string.IsNullOrWhiteSpace(schedulerName))
            {
                return;
            }

            _job = await Api.GetJobDetail(schedulerName, JobKey);
            _triggerDataMap = CloneJobDataMap(JobDataMap);
            _triggers.AddRange(await Api.GetTriggersOfJob(schedulerName, JobKey));

            // A job is paused through its triggers, each of which says why; its group's pause says it for
            // the triggers the group paused and for the ones added to it later.
            _groupPause = await Api.GetJobGroupPause(schedulerName, Group);

            await LoadStatusAsync(schedulerName);
            await LoadStatisticsAsync(schedulerName);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetTriggerPath(string group, string name)
    {
        return DashboardLink.To(Options.Value, "triggers/" + Uri.EscapeDataString(group) + "/" + Uri.EscapeDataString(name));
    }

    /// <summary>
    /// Reads the job's run status for the panel.
    /// </summary>
    /// <remarks>
    /// A data source that keeps no per-job status raises <see cref="NotSupportedException" />, and the panel
    /// is left out; the rest of the page does not depend on it.
    /// </remarks>
    private async Task LoadStatusAsync(string schedulerName)
    {
        try
        {
            _status = await Api.GetJobRunStatus(schedulerName, JobKey);
            _statusKept = true;
        }
        catch (NotSupportedException)
        {
            _status = null;
        }
    }

    /// <summary>
    /// Reads the job's runs over the chosen window for the chart.
    /// </summary>
    /// <remarks>
    /// A data source that cannot count raises <see cref="NotSupportedException" />, and the chart is left out,
    /// as the status panel is; so is it after any other failure, because the rest of the page does not depend
    /// on it.
    /// </remarks>
    private async Task LoadStatisticsAsync(string schedulerName)
    {
        try
        {
            _statistics = await _window.Read(
                Api,
                new ExecutionStatisticsQuery { SchedulerName = schedulerName, Job = new Quartz.JobKey(Name, Group) },
                Clock.GetUtcNow());
        }
        catch (Exception)
        {
            _statistics = null;
        }
    }

    private async Task OnWindowChangedAsync(ChangeEventArgs args)
    {
        _window = RunStatisticsWindow.Parse(args.Value?.ToString());

        if (Scheduler.ActiveSchedulerName is { Length: > 0 } schedulerName)
        {
            await LoadStatisticsAsync(schedulerName);
        }
    }

    /// <summary>
    /// The History page narrowed to this job exactly: a text filter would also list <c>nightly-2</c> for
    /// <c>nightly</c>.
    /// </summary>
    private string GetHistoryPathForJob(string group, string name)
    {
        return DashboardLink.To(Options.Value, "history?jobGroup=" + Uri.EscapeDataString(group) + "&jobName=" + Uri.EscapeDataString(name));
    }

    private string GetExecutionPath(string entryId)
    {
        return DashboardLink.To(Options.Value, "history/" + Uri.EscapeDataString(entryId));
    }

    private void PromptPause()
    {
        _showPausePrompt = true;
    }

    private Task CancelPauseAsync()
    {
        _showPausePrompt = false;
        return Task.CompletedTask;
    }

    private Task PauseAsync(string? reason)
    {
        _showPausePrompt = false;
        PauseDetails details = ActionLog.PauseDetailsFor(reason);
        return ExecuteMutatingActionAsync(
            () => Api.PauseJobWith(Scheduler.ActiveSchedulerName!, JobKey, details),
            "Paused job " + DisplayValueHelper.FormatKey(Group, Name) + ".",
            "Job " + DisplayValueHelper.FormatKey(Group, Name) + " was not paused - it no longer exists.",
            actionName: "PauseJob",
            target: DisplayValueHelper.FormatKey(Group, Name),
            note: DashboardActionLog.PauseNote(details));
    }

    private Task ResumeAsync()
    {
        return ExecuteMutatingActionAsync(
            () => Api.ResumeJob(Scheduler.ActiveSchedulerName!, JobKey),
            "Resumed job " + DisplayValueHelper.FormatKey(Group, Name) + ".",
            "Job " + DisplayValueHelper.FormatKey(Group, Name) + " was not resumed - it no longer exists.",
            actionName: "ResumeJob",
            target: DisplayValueHelper.FormatKey(Group, Name));
    }

    private Task TriggerAsync()
    {
        return ExecuteMutatingActionAsync(
            () => Api.TriggerJob(Scheduler.ActiveSchedulerName!, JobKey),
            "Triggered job " + DisplayValueHelper.FormatKey(Group, Name) + ".",
            actionName: "TriggerJob",
            target: DisplayValueHelper.FormatKey(Group, Name));
    }

    private Task TriggerWithDataAsync()
    {
        return ExecuteMutatingActionAsync(
            () => Api.TriggerJob(Scheduler.ActiveSchedulerName!, JobKey, _triggerDataMap),
            "Triggered job " + DisplayValueHelper.FormatKey(Group, Name) + " with overrides.",
            actionName: "TriggerJobWithData",
            target: DisplayValueHelper.FormatKey(Group, Name));
    }

    private Task ResetTriggerDataMapAsync()
    {
        _triggerDataMap = CloneJobDataMap(JobDataMap);
        return Task.CompletedTask;
    }

    private void PromptDelete()
    {
        _showDeleteConfirm = true;
    }

    private async Task DeleteAsync()
    {
        bool deleted = await ExecuteMutatingActionAsync(
            () => Api.DeleteJob(Scheduler.ActiveSchedulerName!, JobKey),
            "Deleted job " + DisplayValueHelper.FormatKey(Group, Name) + ".",
            "Job " + DisplayValueHelper.FormatKey(Group, Name) + " was not deleted - it no longer exists.",
            actionName: "DeleteJob",
            target: DisplayValueHelper.FormatKey(Group, Name));
        _showDeleteConfirm = false;
        if (deleted)
        {
            Navigation.NavigateTo(DashboardLink.To(Options.Value, "jobs"));
        }
    }

    private Task CancelDeleteAsync()
    {
        _showDeleteConfirm = false;
        return Task.CompletedTask;
    }

    private async Task<bool> ExecuteMutatingActionAsync(
        Func<ValueTask> operation,
        string successMessage,
        string actionName,
        string target)
    {
        string? schedulerName = Scheduler.ActiveSchedulerName;
        if (IsReadOnly || string.IsNullOrWhiteSpace(schedulerName))
        {
            return false;
        }

        try
        {
            await operation();
            ActionLog.Record(schedulerName, actionName, target, succeeded: true);
            Toasts.Success(successMessage);
            await LoadDataAsync();
            return true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            ActionLog.Record(schedulerName, actionName, target, succeeded: false, ex.Message);
            Toasts.Error(ex.Message);
            return false;
        }
    }

    private async Task<bool> ExecuteMutatingActionAsync(
        Func<ValueTask<bool>> operation,
        string successMessage,
        string noOpMessage,
        string actionName,
        string target,
        string? note = null)
    {
        string? schedulerName = Scheduler.ActiveSchedulerName;
        if (IsReadOnly || string.IsNullOrWhiteSpace(schedulerName))
        {
            return false;
        }

        try
        {
            bool applied = await operation();
            ActionLog.Record(schedulerName, actionName, target, succeeded: applied, note);
            if (applied)
            {
                Toasts.Success(successMessage);
            }
            else
            {
                Toasts.Info(noOpMessage);
            }
            await LoadDataAsync();
            return applied;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            ActionLog.Record(schedulerName, actionName, target, succeeded: false, DashboardActionLog.MessageOf(note, ex.Message));
            Toasts.Error(ex.Message);
            return false;
        }
    }

    private static JobDataMap CloneJobDataMap(JobDataMap? source)
    {
        JobDataMap clone = new();
        if (source is null)
        {
            return clone;
        }

        foreach (KeyValuePair<string, object?> entry in source)
        {
            clone[entry.Key] = entry.Value;
        }

        clone.ClearDirtyFlag();
        return clone;
    }

    public void Dispose()
    {
        Scheduler.OnSchedulerChanged -= OnSchedulerChanged;
    }
}
