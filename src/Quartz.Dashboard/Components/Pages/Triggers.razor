        return _applied.State == state ? "qz-button-primary" : string.Empty;
    }

    private void PromptUnschedule(string group, string name)
    {
        _pendingGroup = group;
        _pendingName = name;
        _pendingTriggerKey = DisplayValueHelper.FormatKey(group, name);
        _showUnscheduleConfirm = true;
    }

    private async Task ConfirmUnscheduleAsync()
    {
        if (string.IsNullOrWhiteSpace(_pendingGroup) || string.IsNullOrWhiteSpace(_pendingName))
        {
            _showUnscheduleConfirm = false;
            return;
        }

        await ExecuteMutatingActionAsync(
            () => Api.UnscheduleJob(Scheduler.ActiveSchedulerName!, new TriggerKeyDto(_pendingGroup, _pendingName)),
            "Unscheduled trigger " + DisplayValueHelper.FormatKey(_pendingGroup, _pendingName) + ".",
            "Trigger " + DisplayValueHelper.FormatKey(_pendingGroup, _pendingName) + " was not unscheduled - it no longer exists.",
            actionName: "UnscheduleTrigger",
            target: DisplayValueHelper.FormatKey(_pendingGroup, _pendingName));
        _showUnscheduleConfirm = false;
    }

    private Task CancelUnscheduleAsync()
    {
        _showUnscheduleConfirm = false;
        return Task.CompletedTask;
    }

    private void ToggleSelection(TriggerKeyDto key, ChangeEventArgs args)
    {
        if (IsChecked(args))
        {
            _selected.Add(key);
        }
        else
        {
            _selected.Remove(key);
        }
    }

    private void ToggleGroupSelection(List<TriggerHeaderDto> rows, ChangeEventArgs args)
    {
        bool isChecked = IsChecked(args);
        foreach (TriggerHeaderDto row in rows)
        {
            TriggerKeyDto key = new(row.Group, row.Name);
            if (isChecked)
            {
                _selected.Add(key);
            }
            else
            {
                _selected.Remove(key);
            }
        }
    }

    private bool AllSelected(List<TriggerHeaderDto> rows)
    {
        foreach (TriggerHeaderDto row in rows)
        {
            if (!_selected.Contains(new TriggerKeyDto(row.Group, row.Name)))
            {
                return false;
            }
        }

        return rows.Count > 0;
    }

    private static bool IsChecked(ChangeEventArgs args)
    {
        return args.Value switch
        {
            bool value => value,
            string text => bool.TryParse(text, out bool parsed) && parsed,
            _ => false
        };
    }

    private void ClearSelection()
    {
        _selected.Clear();
    }

    private void DismissBulkResult()
    {
        _bulkResult = null;
    }

    /// <summary>
    /// The selection in a stable order: the order the listing shows keys in, group then name.
    /// </summary>
    private List<TriggerKeyDto> SelectedKeys()
    {
        List<TriggerKeyDto> keys = [.. _selected];
        keys.Sort(static (left, right) =>
        {
            int byGroup = string.CompareOrdinal(left.Group, right.Group);
            return byGroup != 0 ? byGroup : string.CompareOrdinal(left.Name, right.Name);
        });
        return keys;
    }

    private void PromptPauseSelection()
    {
        int count = _selected.Count;
        _pauseTitle = "Pause selected triggers";
        _pauseMessage = "Pause " + count.ToString(CultureInfo.InvariantCulture) + " selected trigger(s)?";
        _pauseAction = PauseSelectionAsync;
    }

    /// <summary>
    /// Pauses the selection, with the one reason the prompt asked for once.
    /// </summary>
    /// <remarks>
    /// One call whatever the prompt was told — over HTTP one <c>…/triggers/keys/pause</c> request, carrying
    /// the reason when there is one. A pause that says nothing is the reasonless key-set pause.
    /// </remarks>
    private Task PauseSelectionAsync(string? reason)
    {
        PauseDetails details = ActionLog.PauseDetailsFor(reason);
        return ExecuteBulkAsync(
            "PauseTrigger",
            "Paused",
            "not paused - it no longer exists or was already paused",
            (schedulerName, keys) => Api.PauseTriggersWith(schedulerName, keys, details));
    }

    private Task ResumeSelectionAsync()
    {
        return ExecuteBulkAsync(
            "ResumeTrigger",
            "Resumed",
            "not resumed - it no longer exists or was not paused",
            (schedulerName, keys) => Api.ResumeTriggers(schedulerName, keys));
    }

