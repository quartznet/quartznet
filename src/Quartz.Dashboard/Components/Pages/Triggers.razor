    /// <summary>
    /// Runs one bulk action over the selection and reports it: a toast for the count, a panel for the keys
    /// it did not reach and why, and an action-log entry per key in the shape the single-row action
    /// records — so "who paused this trigger" finds a bulk pause under the trigger's own key.
    /// </summary>
    private async Task ExecuteBulkAsync(
        string actionName,
        string verb,
        string missedReason,
        Func<string, List<TriggerKeyDto>, ValueTask<List<TriggerKeyDto>>> operation)
    {
        string? schedulerName = Scheduler.ActiveSchedulerName;
        List<TriggerKeyDto> keys = SelectedKeys();
        if (IsReadOnly || string.IsNullOrWhiteSpace(schedulerName) || keys.Count == 0)
        {
            return;
        }

        string batch = "one of " + keys.Count.ToString(CultureInfo.InvariantCulture) + " selected";

        HashSet<TriggerKeyDto> applied;
        string? failure = null;
        try
        {
            applied = [.. await operation(schedulerName, keys)];
        }
        catch (Exception ex)
        {
            // The key-set call is one request and one store transaction, so a refusal is the whole
            // batch's: nothing it names was applied.
            applied = [];
            failure = ex.Message;
        }

        List<(TriggerKeyDto Key, string Reason)> misses = [];
        foreach (TriggerKeyDto key in keys)
        {
            string target = DisplayValueHelper.FormatKey(key.Group, key.Name);
            if (applied.Contains(key))
            {
                ActionLog.Record(schedulerName, actionName, target, succeeded: true, batch);
            }
            else if (failure is not null)
            {
                misses.Add((key, failure));
                ActionLog.Record(schedulerName, actionName, target, succeeded: false, batch + "; " + failure);
            }
            else
            {
                misses.Add((key, missedReason));
                ActionLog.Record(schedulerName, actionName, target, succeeded: false, batch + "; " + missedReason);
            }
        }

        string summary = verb + " " + applied.Count.ToString(CultureInfo.InvariantCulture) + " of "
            + keys.Count.ToString(CultureInfo.InvariantCulture) + " selected trigger(s).";

        if (misses.Count == 0)
        {
            _bulkResult = null;
            Toasts.Success(summary);
        }
        else
        {
            _bulkResult = new BulkResult(summary, misses);
            if (failure is not null)
            {
                Toasts.Error(summary + " " + keys.Count.ToString(CultureInfo.InvariantCulture) + " failed.");
            }
            else
            {
                Toasts.Info(summary);
            }
        }

        _selected.Clear();
        await LoadDataAsync();
    }

    private async Task ExecuteMutatingActionAsync(
        Func<ValueTask<bool>> operation,
        string successMessage,
        string noOpMessage,
        string actionName,
        string target)
    {
        if (IsReadOnly || string.IsNullOrWhiteSpace(Scheduler.ActiveSchedulerName))
        {
            return;
        }

        try
        {
            bool applied = await operation();
            ActionLog.Record(Scheduler.ActiveSchedulerName, actionName, target, succeeded: applied);
            if (applied)
            {
                Toasts.Success(successMessage);
            }
            else
            {
                Toasts.Info(noOpMessage);
            }
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            ActionLog.Record(Scheduler.ActiveSchedulerName, actionName, target, succeeded: false, ex.Message);
            Toasts.Error(ex.Message);
        }
    }

    private async Task ExecuteGroupMutatingActionAsync(
        string group,
        Func<string, TriggerKeyDto, ValueTask<bool>> operation,
        string actionVerb)
    {
        string? schedulerName = Scheduler.ActiveSchedulerName;
        if (IsReadOnly || string.IsNullOrWhiteSpace(schedulerName))
        {
            return;
        }

        try
        {
            // The group filter matches groups that contain it, so the exact group is selected here. A
            // page at a time, because a group with more triggers in it than the server's MaxPageSize is
            // a group an unbounded Take could not read at all over HTTP.
            List<TriggerHeaderDto> triggersInGroup = [];
            DashboardTriggerQuery groupQuery = new() { GroupContains = group, Take = PagedQuery.DefaultTake };
            while (true)
            {
                PagedResult<TriggerHeaderDto> groupPage = await Api.QueryTriggers(schedulerName, groupQuery);
                foreach (TriggerHeaderDto trigger in groupPage.Items)
                {
                    if (string.Equals(trigger.Group, group, StringComparison.Ordinal))
                    {
                        triggersInGroup.Add(trigger);
                    }
                }

                if (!groupPage.HasMore || groupPage.Items.Count == 0)
                {
                    break;
                }

                groupQuery = groupQuery with { Skip = groupQuery.Skip + groupPage.Items.Count };
            }

            int appliedCount = 0;
            foreach (TriggerHeaderDto trigger in triggersInGroup)
            {
                if (await operation(schedulerName, new TriggerKeyDto(trigger.Group, trigger.Name)))
                {
                    appliedCount++;
                }
            }

            ActionLog.Record(
                schedulerName,
                actionVerb + "TriggerGroup",
                group,
                succeeded: true,
                appliedCount + " of " + triggersInGroup.Count + " trigger(s)");
            Toasts.Success(actionVerb + " " + appliedCount + " of " + triggersInGroup.Count + " trigger(s) in group " + group + ".");
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            ActionLog.Record(schedulerName, actionVerb + "TriggerGroup", group, succeeded: false, ex.Message);
            Toasts.Error(ex.Message);
        }
    }

    public void Dispose()
    {
        Scheduler.OnSchedulerChanged -= OnSchedulerChanged;
    }

    /// <summary>
    /// The filters the listing is narrowed by, as the address carries them. Empty strings are "any".
    /// </summary>
    /// <remarks>
    /// A record, so that "is this what is already applied" is one comparison.
    /// </remarks>
    private sealed record TriggerFilters(
        string Group,
        string Name,
        string JobGroup,
        string JobName,
        string Calendar,
        TriggerState? State,
        DateTimeOffset? NextFireBefore)
    {
        public static readonly TriggerFilters None = new(string.Empty, string.Empty, string.Empty, string.Empty, string.Empty, null, null);

        public bool IsEmpty => this == None;
    }

    /// <summary>
    /// What a bulk action reports once it is done: the count, and each key it did not reach with why.
    /// </summary>
    private sealed record BulkResult(string Summary, List<(TriggerKeyDto Key, string Reason)> Misses);
}
