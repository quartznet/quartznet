@page "/quartz/cluster"
@using Microsoft.Extensions.Options
@using Quartz
@using Quartz.Configuration
@using Quartz.Dashboard.Components.Shared
@using Quartz.Dashboard.Services
@implements IDisposable
@inject IQuartzApiClient Api
@inject SchedulerState Scheduler
@inject IOptions<QuartzDashboardOptions> Options
@inject ToastService Toasts
@inject DashboardActionLog ActionLog

<div class="qz-page">
    <div class="qz-page-header">
        <h1>Cluster</h1>
        <span class="qz-muted" style="font-size: var(--qz-font-size-xs);">Auto-refreshes every 5s</span>
        <span class="qz-muted" style="font-size: var(--qz-font-size-xs);">Last updated: @FormatLastUpdated(_lastUpdatedAt)</span>
    </div>

    @if (_isLoading)
    {
        <LoadingSpinner />
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <ErrorAlert Message="@_error" OnRetry="LoadDataAsync" />
    }

    @if (_isWindow)
    {
        @* A window is not one of these nodes and never appears among them, so the page says whose
           check-ins it is showing. An empty list here is the one thing an operator must not read as
           "the cluster is fine": a scheduler whose store is not clustered writes no check-in row at
           all, and is indistinguishable from one that has stopped. *@
        <p class="qz-muted">
            These are the nodes of the cluster this window reads, from the check-ins they write. The
            dashboard is not one of them. A scheduler whose store is not clustered writes no check-in
            row, so it shows no nodes here however well it is running.
        </p>
    }
    else if (_isCluster)
    {
        @* A cluster fronted by several targets: the nodes are the store's, and the ones a member target
           fronts are reachable through that target for what belongs to one process. *@
        <p class="qz-muted">
            These are the nodes of the cluster fronted by <strong>@_clusterTarget</strong>, from the
            check-ins they write to the store every node shares. A node reached through one of the
            targets offers the actions that belong to one process — start, stand-by, shutdown, and
            interrupting what it is running — through that target. A node no target fronts shows a dash.
        </p>
    }
    else if (_isClustered == false)
    {
        <p class="qz-muted">
            This scheduler is not clustered: its job store keeps no check-in state, so the only node is this one.
        </p>
    }

    <table class="qz-table">
        <thead>
            <tr>
                <th>Node</th>
                <th>State</th>
                <th>Last check-in</th>
                <th>Check-in interval</th>
                <th>Acquired</th>
                <th>Executing</th>
                @if (_isCluster)
                {
                    <th>Target</th>
                    @if (!IsReadOnly)
                    {
                        <th>Actions</th>
                    }
                }
            </tr>
        </thead>
        <tbody>
            @if (_nodes.Count == 0)
            {
                <tr>
                    <td colspan="@ColumnCount" class="qz-muted">No nodes to show.</td>
                </tr>
            }
            else
            {
                @foreach (ClusterNodeDto node in _nodes)
                {
                    string? memberKey = MemberKeyOf(node.InstanceId);
                    <tr>
                        <td>
                            @node.InstanceId
                            @if (node.IsCurrentNode && !_isCluster)
                            {
                                <span class="qz-muted">&nbsp;(this node)</span>
                            }
                        </td>
                        <td><StateIndicator State="@node.State.ToString()" /></td>
                        <td>
                            @if (node.LastCheckInUtc.HasValue)
                            {
                                @Scheduler.FormatInSelectedTimeZone(node.LastCheckInUtc, "u")
                                <span class="qz-muted">&nbsp;(<TimeAgo Timestamp="node.LastCheckInUtc" />)</span>
                            }
                            else
                            {
                                <span class="qz-muted">&#8212;</span>
                            }
                        </td>
                        <td>@FormatInterval(node.CheckInInterval)</td>
                        <td>@AcquiredOn(node.InstanceId)</td>
                        <td>@ExecutingOn(node.InstanceId)</td>
                        @if (_isCluster)
                        {
                            <td>
                                @if (memberKey is not null)
                                {
                                    @SchedulerRef.Parse(memberKey).Target
                                }
                                else
                                {
                                    <span class="qz-muted">&#8212;</span>
                                }
                            </td>
                            @if (!IsReadOnly)
                            {
                                <td>
                                    @if (memberKey is not null)
                                    {
                                        <div class="qz-actions">
                                            <button type="button" class="qz-button" @onclick="() => StartNodeAsync(memberKey)">Start</button>
                                            <button type="button" class="qz-button" @onclick="() => StandbyNodeAsync(memberKey)">Standby</button>
                                            <button type="button" class="qz-button qz-button-danger" @onclick="() => ShutdownNodeAsync(memberKey)">Shutdown</button>
                                            <button type="button" class="qz-button" disabled="@(ExecutingOn(node.InstanceId) == 0)" @onclick="() => InterruptNodeAsync(memberKey, node.InstanceId)">Interrupt</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="qz-muted">&#8212;</span>
                                    }
                                </td>
                            }
                        }
                    </tr>
                }
            }
        </tbody>
    </table>

    @if (_firingCountsArePartial)
    {
        <p class="qz-muted">
            The per-node counts are taken from the first @_firingsCounted firings; there are more in flight.
        </p>
    }
</div>

@code {
    private readonly List<ClusterNodeDto> _nodes = [];
    private readonly Dictionary<string, NodeFirings> _firingsByNode = new(StringComparer.Ordinal);
    private readonly List<FireInstanceDto> _executing = [];
    private bool _isLoading = true;
    private bool _loadingInProgress;
    private bool _firingCountsArePartial;
    private int _firingsCounted;
    private string? _error;
    private PeriodicTimer? _refreshTimer;
    private CancellationTokenSource? _refreshLoopCancellation;
    private DateTimeOffset? _lastUpdatedAt;

    /// <summary>
    /// Whether the scheduler's job store is clustered, as the scheduler itself reports it, or null while
    /// nothing has been read.
    /// </summary>
    /// <remarks>
    /// This used to be inferred from the node list — one node, current, with no check-in history — which
    /// is the shape a store that keeps no cluster state takes. It is also the shape a clustered store
    /// takes for the first check-in interval after a node starts, so the page told an operator their
    /// brand new cluster was not one. The scheduler's metadata is the answer, and it is never ambiguous.
    /// </remarks>
    private bool? _isClustered;

    /// <summary>
    /// Whether the scheduler is a window onto an attached store, which changes whose nodes these are
    /// and what an empty list means.
    /// </summary>
    private bool _isWindow;

    /// <summary>
    /// Whether the scheduler is a cluster fronted by several targets, whose nodes are each reachable
    /// through the target that fronts them.
    /// </summary>
    private bool _isCluster;

    /// <summary>The cluster's target, <c>a+b+c</c>, for the sentence that explains the page.</summary>
    private string? _clusterTarget;

    /// <summary>
    /// The key of the member that fronts each node, by the node's instance id: what the per-node
    /// actions are sent through. Filled from each member's own details, and refilled for a member whose
    /// node is no longer listed.
    /// </summary>
    private readonly Dictionary<string, string> _memberByNode = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>The node each member last answered as, so a refresh asks nothing twice.</summary>
    private readonly Dictionary<string, string> _nodeByMember = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>The scheduler the member map was built for, so a switch rebuilds it.</summary>
    private string? _membersFor;

    private bool IsReadOnly => Options.Value.ReadOnly;

    private int ColumnCount => 6 + (_isCluster ? 1 : 0) + (_isCluster && !IsReadOnly ? 1 : 0);

    protected override async Task OnInitializedAsync()
    {
        Scheduler.OnSchedulerChanged += OnSchedulerChanged;
        _refreshLoopCancellation = new CancellationTokenSource();
        // Every tick is a database read on a persistent store, so this is deliberately slower than the
        // one-second cadence of the executing-jobs page: a cluster's membership changes on the scale of
        // its check-in interval, not of a job's duration.
        _refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        _ = RunRefreshLoopAsync(_refreshLoopCancellation.Token);
        await LoadDataAsync();
    }

    private async void OnSchedulerChanged(object? sender, EventArgs e)
    {
        await LoadDataAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RunRefreshLoopAsync(CancellationToken cancellationToken)
    {
        if (_refreshTimer is null)
        {
            return;
        }

        try
        {
            while (await _refreshTimer.WaitForNextTickAsync(cancellationToken))
            {
                try
                {
                    await InvokeAsync(async () =>
                    {
                        await LoadDataAsync();
                        StateHasChanged();
                    });
                }
                catch (OperationCanceledException)
                {
                    break;
                }
                catch (ObjectDisposedException)
                {
                    break;
                }
                catch (InvalidOperationException)
                {
                }
                catch (Exception ex)
                {
                    _error = ex.Message;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private async Task LoadDataAsync()
    {
        if (_loadingInProgress)
        {
            return;
        }

        _loadingInProgress = true;
        _error = null;

        try
        {
            string? schedulerName = Scheduler.ActiveSchedulerName;
            Reset();

            SchedulerHeaderDto? header = Scheduler.Find(schedulerName);
            _isWindow = header?.IsWindow == true;
            _isCluster = header?.IsCluster == true;
            _clusterTarget = header is { IsCluster: true } ? header.Target : null;

            if (!string.Equals(_membersFor, schedulerName, StringComparison.OrdinalIgnoreCase))
            {
                _memberByNode.Clear();
                _nodeByMember.Clear();
                _membersFor = schedulerName;
            }

            if (!string.IsNullOrWhiteSpace(schedulerName))
            {
                await ReadAsync(schedulerName);

                if (header is { IsCluster: true })
                {
                    await ResolveMembersAsync(header);
                }
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _lastUpdatedAt = DateTimeOffset.UtcNow;
            _isLoading = false;
            _loadingInProgress = false;
        }
    }

    private void Reset()
    {
        _nodes.Clear();
        _firingsByNode.Clear();
        _executing.Clear();
        _firingCountsArePartial = false;
        _firingsCounted = 0;
        _isClustered = null;
    }

    /// <summary>
    /// The scheduler's nodes and the firings they hold and run.
    /// </summary>
    private async Task ReadAsync(string schedulerName)
    {
        SchedulerDetailDto scheduler = await Api.GetScheduler(schedulerName);
        _isClustered = scheduler.Clustered;

        _nodes.AddRange(await Api.QueryClusterNodes(schedulerName));

        // Both states, because the two columns are what a node is holding and what it is
        // running: a reservation left behind by a node that died is exactly the thing an
        // operator comes to this page to see.
        PagedResult<FireInstanceDto> firings = await Api.QueryFireInstances(
            schedulerName,
            new DashboardFireInstanceQuery { State = null });

        foreach (FireInstanceDto firing in firings.Items)
        {
            Count(firing);
        }

        _firingsCounted = firings.Items.Count;
        _firingCountsArePartial = firings.HasMore;
    }

    private void Count(FireInstanceDto firing)
    {
        NodeFirings counts = _firingsByNode.TryGetValue(firing.SchedulerInstanceId, out NodeFirings existing)
            ? existing
            : default;

        _firingsByNode[firing.SchedulerInstanceId] = firing.State == FireInstanceState.Acquired
            ? counts with { Acquired = counts.Acquired + 1 }
            : counts with { Executing = counts.Executing + 1 };

        if (firing.State == FireInstanceState.Executing)
        {
            _executing.Add(firing);
        }
    }

    /// <summary>
    /// Asks each member of the cluster which node it fronts: the member's own details name its instance
    /// id, and that id is what the store's node rows are keyed by.
    /// </summary>
    /// <remarks>
    /// Asked under the listing's deadline, so a member that does not answer cannot hold the page. One
    /// that cannot answer is asked again on the next refresh, and its node shows a dash until it does;
    /// so is one whose node is no longer listed, because a node that restarted under a new instance id is
    /// the same member fronting a different row.
    /// </remarks>
    private async Task ResolveMembersAsync(SchedulerHeaderDto cluster)
    {
        foreach (string member in cluster.Members)
        {
            if (_nodeByMember.TryGetValue(member, out string? node) && _nodes.Exists(x => string.Equals(x.InstanceId, node, StringComparison.OrdinalIgnoreCase)))
            {
                continue;
            }

            string memberKey = new SchedulerRef(cluster.SchedulerName, member).Key;
            using CancellationTokenSource deadline = new(ContainerSchedulerRegistry.StatusTimeout);
            try
            {
                SchedulerDetailDto detail = await Api.GetScheduler(memberKey, deadline.Token);
                Map(member, memberKey, detail.SchedulerInstanceId);
            }
            catch (Exception)
            {
                // Unreachable this time; the node it fronts shows a dash until it answers.
            }
        }
    }

    private void Map(string member, string memberKey, string instanceId)
    {
        if (_nodeByMember.TryGetValue(member, out string? previous))
        {
            _memberByNode.Remove(previous);
        }

        _nodeByMember[member] = instanceId;
        _memberByNode[instanceId] = memberKey;
    }

    private string? MemberKeyOf(string instanceId)
    {
        return _memberByNode.TryGetValue(instanceId, out string? memberKey) ? memberKey : null;
    }

    private Task StartNodeAsync(string memberKey)
    {
        return ExecuteNodeActionAsync(memberKey, key => Api.Start(key), "StartScheduler", "Started node.");
    }

    private Task StandbyNodeAsync(string memberKey)
    {
        return ExecuteNodeActionAsync(memberKey, key => Api.Standby(key), "StandbyScheduler", "Node is in standby.");
    }

    private Task ShutdownNodeAsync(string memberKey)
    {
        return ExecuteNodeActionAsync(memberKey, key => Api.Shutdown(key), "ShutdownScheduler", "Shutdown node.");
    }

    /// <summary>
    /// Interrupts every firing the node is running, through the member that fronts it.
    /// </summary>
    private Task InterruptNodeAsync(string memberKey, string instanceId)
    {
        List<string> firings = _executing
            .Where(firing => string.Equals(firing.SchedulerInstanceId, instanceId, StringComparison.Ordinal))
            .Select(firing => firing.FireInstanceId)
            .ToList();

        return ExecuteNodeActionAsync(
            memberKey,
            async key =>
            {
                foreach (string fireInstanceId in firings)
                {
                    await Api.InterruptFireInstance(key, fireInstanceId);
                }
            },
            "InterruptFireInstance",
            "Interrupted " + firings.Count + (firings.Count == 1 ? " firing." : " firings."));
    }

    /// <summary>
    /// Runs one node-local action through a member's own key, and records it against that member: the
    /// record of an action that reached one node is only honest if it names which.
    /// </summary>
    private async Task ExecuteNodeActionAsync(string memberKey, Func<string, ValueTask> operation, string actionName, string successMessage)
    {
        if (IsReadOnly)
        {
            return;
        }

        try
        {
            await operation(memberKey);
            ActionLog.Record(memberKey, actionName, memberKey, succeeded: true, nodeLocal: true);
            Toasts.Success(successMessage);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            ActionLog.Record(memberKey, actionName, memberKey, succeeded: false, ex.Message, nodeLocal: true);
            Toasts.Error(ex.Message);
        }

        await LoadDataAsync();
    }

    private int AcquiredOn(string instanceId)
    {
        return _firingsByNode.TryGetValue(instanceId, out NodeFirings counts) ? counts.Acquired : 0;
    }

    private int ExecutingOn(string instanceId)
    {
        return _firingsByNode.TryGetValue(instanceId, out NodeFirings counts) ? counts.Executing : 0;
    }

    private static string FormatInterval(TimeSpan? interval)
    {
        return interval.HasValue ? interval.Value.ToString(@"hh\:mm\:ss") : "—";
    }

    private string FormatLastUpdated(DateTimeOffset? lastUpdatedAt)
    {
        return Scheduler.FormatInSelectedTimeZone(lastUpdatedAt, "HH:mm:ss");
    }

    public void Dispose()
    {
        Scheduler.OnSchedulerChanged -= OnSchedulerChanged;
        _refreshLoopCancellation?.Cancel();
        _refreshLoopCancellation?.Dispose();
        _refreshTimer?.Dispose();
    }

    /// <summary>
    /// What one node is holding and what it is running, as the firing listing reports it.
    /// </summary>
    private readonly record struct NodeFirings(int Acquired, int Executing);
}
