@page "/quartz/actions"
@using Quartz.AspNetCore
@using Quartz.Dashboard.Components.Shared
@using Quartz.Dashboard.Services
@implements IDisposable
@inject DashboardActionLog ActionLogs
@inject SchedulerState Scheduler

<div class="qz-page">
    <h1>Action Log</h1>

    <div class="qz-live-filters qz-action-log-filters">
        <div class="qz-live-filter-grid">
            <div class="qz-form-group">
                <label class="qz-form-label" for="action-log-via-filter">Via</label>
                @* Applies on its own, as the History page's dropdowns do. What a script did through this
                   process's HTTP API is entered here beside what the pages did, so this is how to read
                   either alone. *@
                <select id="action-log-via-filter"
                        class="qz-select"
                        data-testid="action-log-via-filter"
                        value="@(_via?.ToString() ?? "")"
                        @onchange="OnViaChanged">
                    <option value="">Every surface</option>
                    @foreach (OperatorChannel channel in Enum.GetValues<OperatorChannel>())
                    {
                        <option value="@channel">@ViaLabel(channel)</option>
                    }
                </select>
            </div>
        </div>
    </div>

    @if (_entries.Count == 0)
    {
        <p class="qz-muted">@(_via is null ? "No recorded admin actions yet." : $"No recorded actions through {ViaLabel(_via.Value)} yet.")</p>
    }
    else
    {
        @* Scrolls inside its card rather than pushing the page wider: the Via column takes the table past a
           narrow viewport, as the dashboard's other wide tables do. *@
        <div class="qz-table-scroll" data-testid="action-log-scroll">
            <table class="qz-table">
                <thead>
                    <tr>
                        <th class="qz-action-log-time">Time</th>
                        <th>Via</th>
                        <th class="qz-action-log-scheduler">Scheduler</th>
                        <th>User</th>
                        <th>Action</th>
                        <th>Target</th>
                        <th>Status</th>
                        <th class="qz-action-log-message">Message</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (DashboardActionLogEntry entry in _entries)
                    {
                        <tr>
                            <td class="qz-action-log-time">@Scheduler.FormatInSelectedTimeZone(entry.Timestamp, "u")</td>
                            <td>
                                @* The client's name is its own claim, so it is shown as stated and never as the
                                   user, who is the identity the action was authorized for. *@
                                <span class="qz-tag @ViaClass(entry.Via)"
                                      data-testid="action-log-via"
                                      title="@(entry.Client is null ? null : $"Client, as stated: {entry.Client}")">@ViaLabel(entry.Via)</span>
                                @if (entry.Client is { } client)
                                {
                                    <div class="qz-muted qz-action-log-client" style="font-size: var(--qz-font-size-xs);">@client (as stated)</div>
                                }
                            </td>
                            <td class="qz-action-log-scheduler">
                                @entry.SchedulerName

                                @* Where the scheduler was, as the listing had it when the action was taken.
                                   An action on a remote scheduler ran in another process, which is what
                                   decides where to look for the rest of the story about it. *@
                                @if (entry.Origin is { } origin)
                                {
                                    <span class="qz-tag">@origin.ToString()</span>
                                }
                            </td>
                            <td class="qz-action-log-user">@(entry.User ?? "—")</td>
                            <td>@entry.Action</td>
                            <td>
                                @entry.Target

                                @if (entry.Origin is SchedulerOrigin.Remote or SchedulerOrigin.Agent)
                                {
                                    <div class="qz-muted" style="font-size: var(--qz-font-size-xs);">in another process</div>
                                }
                                else if (entry.Origin is SchedulerOrigin.Cluster)
                                {
                                    <div class="qz-muted" style="font-size: var(--qz-font-size-xs);">on a cluster, in whichever node's process</div>
                                }

                                @* Only for an action that landed on one node: pausing a trigger writes the
                                   store and binds the whole cluster, so naming the node that served the click
                                   would suggest the other nodes were unaffected. *@
                                @if (entry.NodeLocal)
                                {
                                    <div class="qz-muted" style="font-size: var(--qz-font-size-xs);">on node @(entry.SchedulerInstanceId ?? "(unknown)")</div>
                                }
                            </td>
                            <td><StateIndicator State="@(entry.Refused ? "Refused" : entry.Succeeded ? "Complete" : "Error")" /></td>
                            <td class="qz-action-log-message">@(entry.Message ?? string.Empty)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private readonly List<DashboardActionLogEntry> _entries = [];
    private OperatorChannel? _via;

    protected override void OnInitialized()
    {
        Scheduler.OnSchedulerChanged += OnSchedulerChanged;
        Scheduler.OnDisplayChanged += OnDisplayChanged;
        RefreshEntries();
    }

    private void OnSchedulerChanged(object? sender, EventArgs e)
    {
        RefreshEntries();
        InvokeAsync(StateHasChanged);
    }

    /// <summary>The time zone changed: draw the times again in it.</summary>
    private void OnDisplayChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void RefreshEntries()
    {
        _entries.Clear();
        _entries.AddRange(ActionLogs.GetLatest(Scheduler.ActiveSchedulerName, _via, 100));
    }

    private void OnViaChanged(ChangeEventArgs args)
    {
        _via = Enum.TryParse(args.Value?.ToString(), out OperatorChannel channel) ? channel : null;
        RefreshEntries();
    }

    private static string ViaLabel(OperatorChannel channel) => channel switch
    {
        OperatorChannel.HttpApi => "HTTP API",
        OperatorChannel.Mcp => "MCP",
        _ => "Dashboard",
    };

    private static string ViaClass(OperatorChannel channel) => channel switch
    {
        OperatorChannel.HttpApi => "qz-tag-via-api",
        OperatorChannel.Mcp => "qz-tag-via-mcp",
        _ => "qz-tag-via-dashboard",
    };

    public void Dispose()
    {
        Scheduler.OnSchedulerChanged -= OnSchedulerChanged;
        Scheduler.OnDisplayChanged -= OnDisplayChanged;
    }
}
