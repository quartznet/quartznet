@page "/quartz/jobs"
@using Microsoft.Extensions.Options
@using Quartz
@using Quartz.Dashboard.Components.Shared
@using Quartz.Dashboard.Services
@implements IDisposable
@inject IQuartzApiClient Api
@inject SchedulerState Scheduler
@inject IOptions<QuartzDashboardOptions> Options
@inject ToastService Toasts
@inject NavigationManager Navigation
@inject DashboardActionLog ActionLog

<div class="qz-page">
    <h1>Jobs</h1>

    <div class="qz-actions qz-group-actions qz-job-filters">
        <SearchFilter Id="job-filter-group" Placeholder="Filter by group" Value="@_filter" OnFilterChanged="OnFilterChangedAsync" />
        <SearchFilter Id="job-filter-name" Placeholder="Filter by name" Value="@_nameFilter" OnFilterChanged="OnNameFilterChangedAsync" />
    </div>

    @if (_isLoading)
    {
        <LoadingSpinner />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <ErrorAlert Message="@_error" OnRetry="LoadDataAsync" />
    }
    else if (_jobs.Count == 0)
    {
        <p class="qz-muted">@(HasFilters ? "No jobs matched the current filters." : "No jobs found.")</p>
    }
    else
    {
        @foreach (IGrouping<string, JobKeyDto> group in GroupedJobs)
        {
            <section class="qz-section">
                <div class="qz-row">
                    <h2>@group.Key</h2>
                    <StateIndicator State="@GetGroupState(group.Key)" />
                    <PauseNote Pause="@_groupPauses.GetValueOrDefault(group.Key)" />
                </div>
                @if (!IsReadOnly)
                {
                    <div class="qz-actions qz-group-actions">
                        <button type="button" class="qz-button" @onclick="() => PromptPauseGroup(group.Key)">Pause group</button>
                        <button type="button" class="qz-button" @onclick="() => ResumeGroup(group.Key)">Resume group</button>
                        <button type="button" class="qz-button qz-button-primary" @onclick="() => TriggerGroup(group.Key)">Trigger group</button>
                    </div>
                }
                <table class="qz-table qz-entity-table">
                    <thead>
                        <tr>
                            <th class="qz-col-key">Job</th>
                            <th class="qz-col-details">Details</th>
                            @if (!IsReadOnly)
                            {
                                <th class="qz-col-actions">Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (JobKeyDto job in group)
                        {
                            string jobGroup = job.Group;
                            string jobName = job.Name;
                            <tr class="qz-row-link"
                                tabindex="0"
                                role="link"
                                @onclick="() => NavigateToJob(jobGroup, jobName)"
                                @onkeydown="args => OnJobRowKeyDown(args, jobGroup, jobName)">
                                <td class="qz-col-key">
                                    <KeyBadge GroupName="@jobGroup" ItemName="@jobName" />
                                </td>
                                <td class="qz-col-details">
                                    <a class="qz-details-link" href="@GetJobDetailPath(jobGroup, jobName)" @onclick:stopPropagation="true">View details</a>
                                </td>
                                @if (!IsReadOnly)
                                {
                                    <td class="qz-col-actions">
                                        <div class="qz-actions" @onclick:stopPropagation="true">
                                            <button type="button" class="qz-button" @onclick="() => PromptPauseJob(jobGroup, jobName)">Pause</button>
                                            <button type="button" class="qz-button" @onclick="() => ResumeJob(jobGroup, jobName)">Resume</button>
                                            <button type="button" class="qz-button qz-button-primary" @onclick="() => TriggerJob(jobGroup, jobName)">Trigger now</button>
                                            <button type="button" class="qz-button qz-button-danger" @onclick="() => PromptDelete(jobGroup, jobName)">Delete</button>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }

        <Pagination TotalItems="@_totalJobs"
                    PageSize="@_pageSize"
                    CurrentPage="@_currentPage"
                    OnPageChanged="OnPageChangedAsync" />
    }
</div>

<ConfirmDialog IsOpen="@_showDeleteConfirm"
               Title="Delete job"
               Message="@($"Delete {_pendingDeleteKey}? This cannot be undone.")"
               OnConfirm="ConfirmDeleteAsync"
               OnCancel="CancelDeleteAsync" />

<PauseDialog IsOpen="@(_pauseAction is not null)"
             Title="@_pauseTitle"
             Message="@_pauseMessage"
             OnConfirm="ConfirmPauseAsync"
             OnCancel="CancelPauseAsync" />

@code {
    private readonly List<JobKeyDto> _jobs = [];
    private readonly Dictionary<string, string> _groupStates = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, PauseInfo> _groupPauses = new(StringComparer.Ordinal);
    private Func<string?, Task>? _pauseAction;
    private string _pauseTitle = string.Empty;
    private string _pauseMessage = string.Empty;
    private bool _isLoading = true;
    private string? _error;
    private int _currentPage = 1;
    private int _totalJobs;
    private readonly int _pageSize = 25;
    private string _filter = string.Empty;
    private string _nameFilter = string.Empty;
    private bool _loaded;
    private bool _showDeleteConfirm;
    private string? _pendingDeleteGroup;
    private string? _pendingDeleteName;
    private string _pendingDeleteKey = string.Empty;

    /// <summary>
    /// The group fragment to open on. Both filters are query parameters, so a narrowed listing is a link
    /// someone can send or bookmark.
    /// </summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "group")]
    public string? GroupQuery { get; set; }

    /// <summary>
    /// The job-name fragment to open on.
    /// </summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "name")]
    public string? NameQuery { get; set; }

    private bool IsReadOnly => Options.Value.ReadOnly;

    private bool HasFilters => _filter.Length > 0 || _nameFilter.Length > 0;

    private IEnumerable<IGrouping<string, JobKeyDto>> GroupedJobs => _jobs.GroupBy(job => job.Group);

    /// <summary>
    /// The 1-based page the pager speaks, as the <c>Skip</c>/<c>Take</c> the API speaks.
    /// </summary>
    private DashboardJobQuery PageQuery(string? groupFilter, int page) => new()
    {
        GroupContains = groupFilter,
        NameContains = _nameFilter.Length == 0 ? null : _nameFilter,
        Skip = Math.Max(0, page - 1) * _pageSize,
        Take = _pageSize
    };

    protected override void OnInitialized()
    {
        Scheduler.OnSchedulerChanged += OnSchedulerChanged;
    }

    /// <remarks>
    /// The listing is read again only when the address names other filters than the ones applied: a
    /// filter typed here writes the address itself, and the parameters the router hands back for it are
    /// the ones already applied.
    /// </remarks>
    protected override async Task OnParametersSetAsync()
    {
        string group = GroupQuery?.Trim() ?? string.Empty;
        string name = NameQuery?.Trim() ?? string.Empty;
        if (_loaded && group == _filter && name == _nameFilter)
        {
            return;
        }

        _loaded = true;
        _filter = group;
        _nameFilter = name;
        _currentPage = 1;
        await LoadDataAsync();
    }

    private async void OnSchedulerChanged(object? sender, EventArgs e)
    {
        await LoadDataAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            _jobs.Clear();
            _groupStates.Clear();
            _groupPauses.Clear();
            _totalJobs = 0;

            string? schedulerName = Scheduler.ActiveSchedulerName;
            if (string.IsNullOrWhiteSpace(schedulerName))
            {
                return;
            }

            string? groupFilter = string.IsNullOrWhiteSpace(_filter) ? null : _filter;
            PagedResult<JobKeyDto> page = await Api.QueryJobs(schedulerName, PageQuery(groupFilter, _currentPage));

            int totalCount = page.TotalCount ?? page.Items.Count;
            int totalPages = Math.Max(1, (int) Math.Ceiling((double) totalCount / _pageSize));
            if (_currentPage > totalPages)
            {
                _currentPage = totalPages;
                page = await Api.QueryJobs(schedulerName, PageQuery(groupFilter, _currentPage));
                totalCount = page.TotalCount ?? page.Items.Count;
            }

            _jobs.AddRange(page.Items);
            _totalJobs = totalCount;

            // Every group, because the page labels each of the ones its current page shows, and it
            // cannot know which those are before it has them. Read a page at a time rather than with one
            // unbounded Take: over HTTP that travels as take=all, which a server with MaxPageSize set
            // answers with that many rows and a hasMore the client refuses to hand back as everything.
            DashboardGroupQuery groupQuery = new() { Take = PagedQuery.DefaultTake };
            while (true)
            {
                PagedResult<JobGroupDto> groups = await Api.QueryJobGroups(schedulerName, groupQuery);
                foreach (JobGroupDto group in groups.Items)
                {
                    _groupStates[group.Name] = group.Paused ? "Paused" : "Normal";
                }

                if (!groups.HasMore || groups.Items.Count == 0)
                {
                    break;
                }

                groupQuery = groupQuery with { Skip = groupQuery.Skip + groups.Items.Count };
            }

            // Why each paused group on this page is paused: asked of those alone, which are few.
            foreach (string group in _jobs.Select(job => job.Group).Distinct(StringComparer.Ordinal))
            {
                if (GetGroupState(group) == "Paused" && await Api.GetJobGroupPause(schedulerName, group) is { } pause)
                {
                    _groupPauses[group] = pause;
                }
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _jobs.Clear();
            _groupStates.Clear();
            _groupPauses.Clear();
            _totalJobs = 0;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Task OnFilterChangedAsync(string filter)
    {
        _filter = filter.Trim();
        return ApplyFiltersAsync();
    }

    private Task OnNameFilterChangedAsync(string filter)
    {
        _nameFilter = filter.Trim();
        return ApplyFiltersAsync();
    }

    private Task ApplyFiltersAsync()
    {
        _currentPage = 1;

        List<string> parts = [];
        if (_filter.Length > 0)
        {
            parts.Add("group=" + Uri.EscapeDataString(_filter));
        }

        if (_nameFilter.Length > 0)
        {
            parts.Add("name=" + Uri.EscapeDataString(_nameFilter));
        }

        string target = parts.Count == 0
            ? DashboardLink.To(Options.Value, "jobs")
            : DashboardLink.To(Options.Value, "jobs?" + string.Join("&", parts));
        string current = (DashboardLink.ToBaseRelative(Navigation.Uri, Navigation.BaseUri) ?? string.Empty).TrimStart('/');
        if (!string.Equals(target, current, StringComparison.Ordinal))
        {
            Navigation.NavigateTo(target, replace: true);
        }

        return LoadDataAsync();
    }

    private Task OnPageChangedAsync(int page)
    {
        _currentPage = page;
        return LoadDataAsync();
    }

    private string GetJobDetailPath(string group, string name)
    {
        return DashboardLink.To(Options.Value, "jobs/" + Uri.EscapeDataString(group) + "/" + Uri.EscapeDataString(name));
    }

    private string GetGroupState(string group)
    {
        return _groupStates.TryGetValue(group, out string? state) ? state : "Unknown";
    }

    private void OnJobRowKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args, string group, string name)
    {
        if (args.Key is "Enter" or " " or "Spacebar")
        {
            NavigateToJob(group, name);
        }
    }

    private void NavigateToJob(string group, string name)
    {
        Navigation.NavigateTo(GetJobDetailPath(group, name));
    }

    private void PromptPauseJob(string group, string name)
    {
        _pauseTitle = "Pause job";
        _pauseMessage = "Pause every trigger of " + DisplayValueHelper.FormatKey(group, name) + "?";
        _pauseAction = reason => PauseJob(group, name, reason);
    }

    private void PromptPauseGroup(string group)
    {
        _pauseTitle = "Pause job group";
        _pauseMessage = "Pause every job in " + group + "?";
        _pauseAction = reason => PauseGroup(group, reason);
    }

    private Task ConfirmPauseAsync(string? reason)
    {
        Func<string?, Task>? pause = _pauseAction;
        _pauseAction = null;
        return pause is null ? Task.CompletedTask : pause(reason);
    }

    private Task CancelPauseAsync()
    {
        _pauseAction = null;
        return Task.CompletedTask;
    }

    private async Task PauseJob(string group, string name, string? reason)
    {
        if (IsReadOnly)
        {
            return;
        }

        PauseDetails details = ActionLog.PauseDetailsFor(reason);
        await ExecuteMutatingActionAsync(
            () => Api.PauseJobWith(Scheduler.ActiveSchedulerName!, new JobKeyDto(group, name), details),
            "Paused job " + DisplayValueHelper.FormatKey(group, name) + ".",
            "Job " + DisplayValueHelper.FormatKey(group, name) + " was not paused - it no longer exists.",
            actionName: "PauseJob",
            target: DisplayValueHelper.FormatKey(group, name));
    }

    private async Task ResumeJob(string group, string name)
    {
        if (IsReadOnly)
        {
            return;
        }

        await ExecuteMutatingActionAsync(
            () => Api.ResumeJob(Scheduler.ActiveSchedulerName!, new JobKeyDto(group, name)),
            "Resumed job " + DisplayValueHelper.FormatKey(group, name) + ".",
            "Job " + DisplayValueHelper.FormatKey(group, name) + " was not resumed - it no longer exists.",
            actionName: "ResumeJob",
            target: DisplayValueHelper.FormatKey(group, name));
    }

    private async Task TriggerJob(string group, string name)
    {
        if (IsReadOnly)
        {
            return;
        }

        await ExecuteMutatingActionAsync(
            () => Api.TriggerJob(Scheduler.ActiveSchedulerName!, new JobKeyDto(group, name)),
            "Triggered job " + DisplayValueHelper.FormatKey(group, name) + ".",
            actionName: "TriggerJob",
            target: DisplayValueHelper.FormatKey(group, name));
    }

    private Task PauseGroup(string group, string? reason)
    {
        PauseDetails details = ActionLog.PauseDetailsFor(reason);
        return ExecuteGroupMutatingActionAsync(
            group,
            (schedulerName, jobKey) => Api.PauseJobWith(schedulerName, jobKey, details),
            "Paused");
    }

    private Task ResumeGroup(string group)
    {
        return ExecuteGroupMutatingActionAsync(
            group,
            (schedulerName, jobKey) => Api.ResumeJob(schedulerName, jobKey),
            "Resumed");
    }

    private Task TriggerGroup(string group)
    {
        return ExecuteGroupMutatingActionAsync(
            group,
            (schedulerName, jobKey) => Api.TriggerJob(schedulerName, jobKey),
            "Triggered");
    }

    private void PromptDelete(string group, string name)
    {
        _pendingDeleteGroup = group;
        _pendingDeleteName = name;
        _pendingDeleteKey = DisplayValueHelper.FormatKey(group, name);
        _showDeleteConfirm = true;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (IsReadOnly || string.IsNullOrWhiteSpace(_pendingDeleteGroup) || string.IsNullOrWhiteSpace(_pendingDeleteName))
        {
            _showDeleteConfirm = false;
            return;
        }

        await ExecuteMutatingActionAsync(
            () => Api.DeleteJob(Scheduler.ActiveSchedulerName!, new JobKeyDto(_pendingDeleteGroup, _pendingDeleteName)),
            "Deleted job " + DisplayValueHelper.FormatKey(_pendingDeleteGroup, _pendingDeleteName) + ".",
            "Job " + DisplayValueHelper.FormatKey(_pendingDeleteGroup, _pendingDeleteName) + " was not deleted - it no longer exists.",
            actionName: "DeleteJob",
            target: DisplayValueHelper.FormatKey(_pendingDeleteGroup, _pendingDeleteName));
        _showDeleteConfirm = false;
    }

    private Task CancelDeleteAsync()
    {
        _showDeleteConfirm = false;
        return Task.CompletedTask;
    }

    private async Task ExecuteMutatingActionAsync(
        Func<ValueTask> operation,
        string successMessage,
        string actionName,
        string target)
    {
        string? schedulerName = Scheduler.ActiveSchedulerName;
        if (IsReadOnly || string.IsNullOrWhiteSpace(schedulerName))
        {
            return;
        }

        try
        {
            await operation();
            ActionLog.Record(schedulerName, actionName, target, succeeded: true);
            Toasts.Success(successMessage);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            ActionLog.Record(schedulerName, actionName, target, succeeded: false, ex.Message);
            Toasts.Error(ex.Message);
        }
    }

    private async Task ExecuteMutatingActionAsync(
        Func<ValueTask<bool>> operation,
        string successMessage,
        string noOpMessage,
        string actionName,
        string target)
    {
        string? schedulerName = Scheduler.ActiveSchedulerName;
        if (IsReadOnly || string.IsNullOrWhiteSpace(schedulerName))
        {
            return;
        }

        try
        {
            bool applied = await operation();
            ActionLog.Record(schedulerName, actionName, target, succeeded: applied);
            if (applied)
            {
                Toasts.Success(successMessage);
            }
            else
            {
                Toasts.Info(noOpMessage);
            }
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            ActionLog.Record(schedulerName, actionName, target, succeeded: false, ex.Message);
            Toasts.Error(ex.Message);
        }
    }

    private async Task ExecuteGroupMutatingActionAsync(
        string group,
        Func<string, JobKeyDto, ValueTask> operation,
        string actionVerb)
    {
        await ExecuteGroupMutatingActionAsync(
            group,
            async (schedulerName, jobKey) =>
            {
                await operation(schedulerName, jobKey);
                return true;
            },
            actionVerb);
    }

    private async Task ExecuteGroupMutatingActionAsync(
        string group,
        Func<string, JobKeyDto, ValueTask<bool>> operation,
        string actionVerb)
    {
        string? schedulerName = Scheduler.ActiveSchedulerName;
        if (IsReadOnly || string.IsNullOrWhiteSpace(schedulerName))
        {
            return;
        }

        try
        {
            // The group filter matches groups that contain it, so the exact group is selected here. A
            // page at a time, because a group with more jobs in it than the server's MaxPageSize is a
            // group an unbounded Take could not read at all over HTTP.
            List<JobKeyDto> jobsInGroup = [];
            DashboardJobQuery groupQuery = new() { GroupContains = group, Take = PagedQuery.DefaultTake };
            while (true)
            {
                PagedResult<JobKeyDto> groupPage = await Api.QueryJobs(schedulerName, groupQuery);
                foreach (JobKeyDto job in groupPage.Items)
                {
                    if (string.Equals(job.Group, group, StringComparison.Ordinal))
                    {
                        jobsInGroup.Add(job);
                    }
                }

                if (!groupPage.HasMore || groupPage.Items.Count == 0)
                {
                    break;
                }

                groupQuery = groupQuery with { Skip = groupQuery.Skip + groupPage.Items.Count };
            }

            int appliedCount = 0;
            foreach (JobKeyDto job in jobsInGroup)
            {
                if (await operation(schedulerName, job))
                {
                    appliedCount++;
                }
            }

            ActionLog.Record(
                schedulerName,
                actionVerb + "JobGroup",
                group,
                succeeded: true,
                appliedCount + " of " + jobsInGroup.Count + " job(s)");
            Toasts.Success(actionVerb + " " + appliedCount + " of " + jobsInGroup.Count + " job(s) in group " + group + ".");
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            ActionLog.Record(schedulerName, actionVerb + "JobGroup", group, succeeded: false, ex.Message);
            Toasts.Error(ex.Message);
        }
    }

    public void Dispose()
    {
        Scheduler.OnSchedulerChanged -= OnSchedulerChanged;
    }
}
