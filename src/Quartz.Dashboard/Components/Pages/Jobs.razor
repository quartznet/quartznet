@page "/quartz/jobs"
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Options
@using Quartz
@using Quartz.Dashboard.Components.Shared
@using Quartz.Dashboard.Services
@using Routes = Quartz.HttpApiContract.SchedulerRoutes
@using WireRoute = Quartz.HttpApiContract.WireRoute
@implements IDisposable
@inject IQuartzApiClient Api
@inject SchedulerState Scheduler
@inject SchedulerAuthorization Authorization
@inject IOptions<QuartzDashboardOptions> Options
@inject ToastService Toasts
@inject NavigationManager Navigation
@inject DashboardActionLog ActionLog
@inject IServiceProvider Services

<div class="qz-page">
    <div class="qz-page-header">
        <h1>Jobs</h1>
        <LastUpdated At="@_lastUpdatedAt" StaleReason="@_staleReason" OnRefresh="RefreshAsync" RefreshDisabled="@_refreshing" />
    </div>

    <div class="qz-actions qz-group-actions qz-job-filters">
        <SearchFilter Id="job-filter-group" Placeholder="Filter by group" Value="@_filter" OnFilterChanged="OnFilterChangedAsync" />
        <SearchFilter Id="job-filter-name" Placeholder="Filter by name" Value="@_nameFilter" OnFilterChanged="OnNameFilterChangedAsync" />
    </div>

    @if (_isLoading)
    {
        <LoadingSpinner />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <ErrorAlert Message="@_error" OnRetry="LoadDataAsync" />
    }
    else if (_jobs.Count == 0)
    {
        <p class="qz-muted">@(HasFilters ? "No jobs matched the current filters." : "No jobs found.")</p>
    }
    else
    {
        @foreach (IGrouping<string, JobKeyDto> group in GroupedJobs)
        {
            <section class="qz-section">
                <div class="qz-row">
                    <h2>@group.Key</h2>
                    <StateIndicator State="@GetGroupState(group.Key)" />
                    <PauseNote Pause="@_groupPauses.GetValueOrDefault(group.Key)" />
                </div>
                @if (CanPauseGroup || CanResumeGroup || CanTrigger)
                {
                    <div class="qz-actions qz-group-actions">
                        @if (CanPauseGroup)
                        {
                            <button type="button" class="qz-button" @onclick="() => PromptPauseGroup(group.Key)">Pause group</button>
                        }
                        @if (CanResumeGroup)
                        {
                            <button type="button" class="qz-button" @onclick="() => ResumeGroup(group.Key)">Resume group</button>
                        }
                        @if (CanTrigger)
                        {
                            <button type="button" class="qz-button qz-button-primary" disabled="@(_triggering.Contains((group.Key, null)))" @onclick="() => TriggerGroup(group.Key)">Trigger group</button>
                        }
                    </div>
                }
                <table class="qz-table qz-entity-table qz-jobs-table">
                    <thead>
                        <tr>
                            <th class="qz-col-key">Job</th>
                            <th class="qz-col-details">Details</th>
                            @if (_statusesShown)
                            {
                                <th class="qz-col-run">Last run</th>
                                <th class="qz-col-run qz-col-last-success">Last success</th>
                                <th class="qz-col-failing">Failing</th>
                            }
                            @if (HasRowActions)
                            {
                                <th class="qz-col-actions">Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (JobKeyDto job in group)
                        {
                            string jobGroup = job.Group;
                            string jobName = job.Name;
                            <tr class="qz-row-link"
                                tabindex="0"
                                role="link"
                                @onclick="() => NavigateToJob(jobGroup, jobName)"
                                @onkeydown="args => OnJobRowKeyDown(args, jobGroup, jobName)">
                                @* A key pressed on a control in the row is that control's: Enter on Delete deletes, it does not
                                   also open the job. Only a key pressed on the row itself navigates. *@
                                <td class="qz-col-key" @onkeydown:stopPropagation="true">
                                    <KeyBadge GroupName="@jobGroup" ItemName="@jobName" />
                                </td>
                                <td class="qz-col-details" @onkeydown:stopPropagation="true">
                                    <a class="qz-details-link" href="@GetJobDetailPath(jobGroup, jobName)" @onclick:stopPropagation="true">View details</a>
                                </td>
                                @if (_statusesShown)
                                {
                                    JobRunStatus? status = _statuses.GetValueOrDefault(job);
                                    <td class="qz-col-run qz-job-last-run">
                                        @if (status is not null)
                                        {
                                            <span class="qz-run-summary">
                                                <StateIndicator State="@RunResultDisplay.Label(status.LastResult)" />
                                                <span class="qz-muted">@Scheduler.FormatInSelectedTimeZone(status.LastFiredAtUtc)</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="qz-muted" title="No run of this job has been recorded">&#8212;</span>
                                        }
                                    </td>
                                    <td class="qz-col-run qz-col-last-success qz-job-last-success">
                                        @if (status?.LastSucceededAtUtc is { } lastSuccess)
                                        {
                                            @Scheduler.FormatInSelectedTimeZone(lastSuccess)
                                        }
                                        else
                                        {
                                            <span class="qz-muted">&#8212;</span>
                                        }
                                    </td>
                                    <td class="qz-col-failing qz-job-failing" @onkeydown:stopPropagation="true">
                                        @if (status is { ConsecutiveFailures: > 0 })
                                        {
                                            <a class="qz-failing-badge"
                                               href="@GetFailuresPath(jobGroup, jobName)"
                                               title="@status.LastFailureMessage"
                                               @onclick:stopPropagation="true">@DisplayValueHelper.FormatFailing(status.ConsecutiveFailures)</a>
                                        }
                                    </td>
                                }
                                @if (HasRowActions)
                                {
                                    <td class="qz-col-actions" @onkeydown:stopPropagation="true">
                                        <div class="qz-actions" @onclick:stopPropagation="true">
                                            @if (CanPause)
                                            {
                                                <button type="button" class="qz-button" @onclick="() => PromptPauseJob(jobGroup, jobName)">Pause</button>
                                            }
                                            @if (CanResume)
                                            {
                                                <button type="button" class="qz-button" @onclick="() => ResumeJob(jobGroup, jobName)">Resume</button>
                                            }
                                            @if (CanTrigger)
                                            {
                                                <button type="button" class="qz-button qz-button-primary" disabled="@(_triggering.Contains((jobGroup, jobName)))" @onclick="() => TriggerJob(jobGroup, jobName)">Trigger now</button>
                                            }
                                            @if (CanDelete)
                                            {
                                                <button type="button" class="qz-button qz-button-danger" @onclick="() => PromptDelete(jobGroup, jobName)">Delete</button>
                                            }
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }

        <Pagination TotalItems="@_totalJobs"
                    PageSize="@_pageSize"
                    CurrentPage="@_currentPage"
                    OnPageChanged="OnPageChangedAsync" />
    }
</div>

<ConfirmDialog IsOpen="@_showDeleteConfirm"
               Title="Delete job"
               ConfirmText="Delete"
               Message="@($"Delete {_pendingDeleteKey}? This cannot be undone.")"
               OnConfirm="ConfirmDeleteAsync"
               OnCancel="CancelDeleteAsync" />

<PauseDialog IsOpen="@(_pauseAction is not null)"
             Title="@_pauseTitle"
             Message="@_pauseMessage"
             OnConfirm="ConfirmPauseAsync"
             OnCancel="CancelPauseAsync" />

@code {
    private readonly List<JobKeyDto> _jobs = [];
    private readonly Dictionary<string, string> _groupStates = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, PauseInfo> _groupPauses = new(StringComparer.Ordinal);
    private Func<string?, Task>? _pauseAction;
    private string _pauseTitle = string.Empty;
    private string _pauseMessage = string.Empty;
    private bool _isLoading = true;
    private string? _error;
    private int _currentPage = 1;
    private int _totalJobs;
    private readonly int _pageSize = 25;
    private string _filter = string.Empty;
    private string _nameFilter = string.Empty;
    private bool _loaded;
    private bool _showDeleteConfirm;
    private string? _pendingDeleteGroup;
    private string? _pendingDeleteName;
    private string _pendingDeleteKey = string.Empty;

    /// <summary>
    /// The <em>Trigger now</em> and <em>Trigger group</em> requests that are out: a job by its group and name,
    /// a group by its name alone. Each button is disabled while its own request is out, so a double click
    /// fires once.
    /// </summary>
    private readonly HashSet<(string Group, string? Name)> _triggering = [];

    /// <summary>
    /// When the listing on screen was read, or <see langword="null" /> while it holds nothing read.
    /// </summary>
    private DateTimeOffset? _lastUpdatedAt;

    /// <summary>
    /// Why the last read failed while there was a listing to keep, or <see langword="null" />.
    /// </summary>
    private string? _staleReason;

    /// <summary>
    /// Cancelled when the reader leaves the page, which stops the read in flight: its answer would be thrown away.
    /// </summary>
    private readonly CancellationTokenSource _cancellation = new();

    /// <summary>Whether the read the Refresh button asked for is out.</summary>
    private bool _refreshing;

    /// <summary>
    /// The run status of each job on the page that has one, from one read per page.
    /// </summary>
    private readonly Dictionary<JobKeyDto, JobRunStatus> _statuses = [];

    /// <summary>
    /// Whether the data source keeps per-job run statuses. When it does not, the three columns are left
    /// out rather than shown empty, since a dash would say the job never ran.
    /// </summary>
    private bool _statusesShown;

    /// <summary>
    /// The group fragment to open on. Both filters are query parameters, so a narrowed listing is a link
    /// someone can send or bookmark.
    /// </summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "group")]
    public string? GroupQuery { get; set; }

    /// <summary>
    /// The job-name fragment to open on.
    /// </summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "name")]
    public string? NameQuery { get; set; }

    private bool IsReadOnly => Options.Value.ReadOnly;

    /// <summary>The clock the page says it read the listing at.</summary>
    private TimeProvider Clock => Services.GetService<TimeProvider>() ?? TimeProvider.System;

    /// <summary>
    /// Whether the visitor may call <paramref name="route" /> on the active scheduler: never while the
    /// dashboard is read-only, and only at their role's level under an operation policy.
    /// </summary>
    private bool Can(WireRoute route) => Authorization.Allows(Scheduler.ActiveSchedulerName, route);

    private bool CanPause => Can(Routes.PauseJob);

    private bool CanResume => Can(Routes.ResumeJob);

    private bool CanPauseGroup => Can(Routes.PauseJobs);

    private bool CanResumeGroup => Can(Routes.ResumeJobs);

    private bool CanTrigger => Can(Routes.TriggerJob);

    private bool CanDelete => Can(Routes.DeleteJob);

    private bool HasRowActions => CanPause || CanResume || CanTrigger || CanDelete;

    private bool HasFilters => _filter.Length > 0 || _nameFilter.Length > 0;

    private IEnumerable<IGrouping<string, JobKeyDto>> GroupedJobs => _jobs.GroupBy(job => job.Group);

    /// <summary>
    /// The 1-based page the pager speaks, as the <c>Skip</c>/<c>Take</c> the API speaks.
    /// </summary>
    private DashboardJobQuery PageQuery(string? groupFilter, int page) => new()
    {
        GroupContains = groupFilter,
        NameContains = _nameFilter.Length == 0 ? null : _nameFilter,
        Skip = Math.Max(0, page - 1) * _pageSize,
        Take = _pageSize
    };

    protected override void OnInitialized()
    {
        Scheduler.OnSchedulerChanged += OnSchedulerChanged;
        Scheduler.OnDisplayChanged += OnDisplayChanged;
    }

    /// <summary>The time zone changed: draw the run times again in it, and read nothing.</summary>
    private void OnDisplayChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    /// <remarks>
    /// The listing is read again only when the address names other filters than the ones applied: a
    /// filter typed here writes the address itself, and the parameters the router hands back for it are
    /// the ones already applied.
    /// </remarks>
    protected override async Task OnParametersSetAsync()
    {
        string group = GroupQuery?.Trim() ?? string.Empty;
        string name = NameQuery?.Trim() ?? string.Empty;
        if (_loaded && group == _filter && name == _nameFilter)
        {
            return;
        }

        _loaded = true;
        _filter = group;
        _nameFilter = name;
        _currentPage = 1;
        await LoadDataAsync();
    }

    private async void OnSchedulerChanged(object? sender, EventArgs e)
    {
        // Another scheduler's listing is not one to keep: a read of this one that fails has nothing to show.
        ClearListing();
        await LoadDataAsync();
        await InvokeAsync(StateHasChanged);
    }

    /// <remarks>
    /// The listing on screen is replaced when the new one arrives rather than emptied before the read, so a
    /// read that fails keeps it, marked stale beside the time it was read. Only a page with nothing read to
    /// show has the error in its place.
    /// </remarks>
    private async Task LoadDataAsync()
    {
        // A refresh keeps the listing on screen until the new one arrives; the spinner is for a page with
        // nothing read to show.
        _isLoading = !_refreshing || _lastUpdatedAt is null;
        _error = null;

        try
        {
            string? schedulerName = Scheduler.ActiveSchedulerName;
            if (string.IsNullOrWhiteSpace(schedulerName))
            {
                ClearListing();
                return;
            }

            // What the visitor's role allows here, asked once per scheduler, so the controls below render
            // from an answer rather than offering what would be refused.
            CancellationToken cancellationToken = _cancellation.Token;
            await Authorization.LoadOperations(schedulerName, cancellationToken);

            string? groupFilter = string.IsNullOrWhiteSpace(_filter) ? null : _filter;
            PagedResult<JobKeyDto> page = await Api.QueryJobs(schedulerName, PageQuery(groupFilter, _currentPage), cancellationToken);

            int totalCount = page.TotalCount ?? page.Items.Count;
            int totalPages = Math.Max(1, (int) Math.Ceiling((double) totalCount / _pageSize));
            if (_currentPage > totalPages)
            {
                _currentPage = totalPages;
                page = await Api.QueryJobs(schedulerName, PageQuery(groupFilter, _currentPage), cancellationToken);
                totalCount = page.TotalCount ?? page.Items.Count;
            }

            _jobs.Clear();
            _jobs.AddRange(page.Items);
            _totalJobs = totalCount;

            await LoadStatusesAsync(schedulerName, cancellationToken);

            // Every group, because the page labels each of the ones its current page shows, and it
            // cannot know which those are before it has them. Read a page at a time rather than with one
            // unbounded Take: over HTTP that travels as take=all, which a server with MaxPageSize set
            // answers with that many rows and a hasMore the client refuses to hand back as everything.
            DashboardGroupQuery groupQuery = new() { Take = PagedQuery.DefaultTake };
            while (true)
            {
                PagedResult<JobGroupDto> groups = await Api.QueryJobGroups(schedulerName, groupQuery, cancellationToken);
                foreach (JobGroupDto group in groups.Items)
                {
                    _groupStates[group.Name] = group.Paused ? "Paused" : "Normal";
                }

                if (!groups.HasMore || groups.Items.Count == 0)
                {
                    break;
                }

                groupQuery = groupQuery with { Skip = groupQuery.Skip + groups.Items.Count };
            }

            // Why each paused group on this page is paused: asked of those alone, which are few.
            _groupPauses.Clear();
            foreach (string group in _jobs.Select(job => job.Group).Distinct(StringComparer.Ordinal))
            {
                if (GetGroupState(group) == "Paused" && await Api.GetJobGroupPause(schedulerName, group, cancellationToken) is { } pause)
                {
                    _groupPauses[group] = pause;
                }
            }

            _lastUpdatedAt = Clock.GetUtcNow();
            _staleReason = null;
        }
        catch (OperationCanceledException) when (_cancellation.IsCancellationRequested)
        {
            // The reader left. A read nobody is waiting for is not a failure: no stale mark, no error.
        }
        catch (Exception ex) when (_lastUpdatedAt is not null)
        {
            _staleReason = ex.Message;
        }
        catch (Exception ex)
        {
            ClearListing();
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// The Refresh button: the listing read again, kept on screen until the new one arrives, and the header's
    /// status read with it. The page reads nothing on its own after it has loaded.
    /// </summary>
    private async Task RefreshAsync()
    {
        if (_refreshing)
        {
            return;
        }

        _refreshing = true;
        try
        {
            await LoadDataAsync();
        }
        finally
        {
            _refreshing = false;
        }

        if (!_cancellation.IsCancellationRequested)
        {
            Scheduler.NotifyRefreshed();
        }
    }

    /// <summary>
    /// Empties the listing, for a scheduler of which there is nothing read to keep showing.
    /// </summary>
    private void ClearListing()
    {
        _jobs.Clear();
        _groupStates.Clear();
        _groupPauses.Clear();
        _statuses.Clear();
        _statusesShown = false;
        _totalJobs = 0;
        _lastUpdatedAt = null;
        _staleReason = null;
    }

    /// <summary>
    /// Reads the run status of every job on the page in one call.
    /// </summary>
    /// <remarks>
    /// A data source that keeps no per-job status — a history store of the application's own, or a
    /// scheduler in another process whose host is older than 4.4 — raises
    /// <see cref="NotSupportedException" />, and the columns are left out.
    /// </remarks>
    private async Task LoadStatusesAsync(string schedulerName, CancellationToken cancellationToken)
    {
        if (_jobs.Count == 0)
        {
            _statuses.Clear();
            _statusesShown = false;
            return;
        }

        try
        {
            List<JobRunStatus> statuses = await Api.GetJobRunStatuses(schedulerName, _jobs, cancellationToken);
            _statuses.Clear();
            foreach (JobRunStatus status in statuses)
            {
                _statuses[new JobKeyDto(status.Job.Group, status.Job.Name)] = status;
            }

            _statusesShown = true;
        }
        catch (NotSupportedException)
        {
            _statuses.Clear();
            _statusesShown = false;
        }
    }

    private Task OnFilterChangedAsync(string filter)
    {
        _filter = filter.Trim();
        return ApplyFiltersAsync();
    }

    private Task OnNameFilterChangedAsync(string filter)
    {
        _nameFilter = filter.Trim();
        return ApplyFiltersAsync();
    }

    private Task ApplyFiltersAsync()
    {
        _currentPage = 1;

        List<string> parts = [];
        if (_filter.Length > 0)
        {
            parts.Add("group=" + Uri.EscapeDataString(_filter));
        }

        if (_nameFilter.Length > 0)
        {
            parts.Add("name=" + Uri.EscapeDataString(_nameFilter));
        }

        string target = parts.Count == 0
            ? DashboardLink.To(Options.Value, "jobs")
            : DashboardLink.To(Options.Value, "jobs?" + string.Join("&", parts));
        string current = (DashboardLink.ToBaseRelative(Navigation.Uri, Navigation.BaseUri) ?? string.Empty).TrimStart('/');
        if (!string.Equals(target, current, StringComparison.Ordinal))
        {
            Navigation.NavigateTo(target, replace: true);
        }

        return LoadDataAsync();
    }

    private Task OnPageChangedAsync(int page)
    {
        _currentPage = page;
        return LoadDataAsync();
    }

    private string GetJobDetailPath(string group, string name)
    {
        return DashboardLink.To(Options.Value, "jobs/" + Uri.EscapeDataString(group) + "/" + Uri.EscapeDataString(name));
    }

    /// <summary>
    /// The job's final failures on the History page: that job only, failed results only, the ones that
    /// gave up.
    /// </summary>
    private string GetFailuresPath(string group, string name)
    {
        return DashboardLink.To(
            Options.Value,
            "history?outcome=failed&jobGroup=" + Uri.EscapeDataString(group) + "&jobName=" + Uri.EscapeDataString(name) + "&result=failed");
    }

    private string GetGroupState(string group)
    {
        return _groupStates.TryGetValue(group, out string? state) ? state : "Unknown";
    }

    private void OnJobRowKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args, string group, string name)
    {
        if (args.Key is "Enter" or " " or "Spacebar")
        {
            NavigateToJob(group, name);
        }
    }

    private void NavigateToJob(string group, string name)
    {
        Navigation.NavigateTo(GetJobDetailPath(group, name));
    }

    private void PromptPauseJob(string group, string name)
    {
        _pauseTitle = "Pause job";
        _pauseMessage = "Pause every trigger of " + DisplayValueHelper.FormatKey(group, name) + "?";
        _pauseAction = reason => PauseJob(group, name, reason);
    }

    private void PromptPauseGroup(string group)
    {
        _pauseTitle = "Pause job group";
        _pauseMessage = "Pause every job in " + group + "?";
        _pauseAction = reason => PauseGroup(group, reason);
    }

    private Task ConfirmPauseAsync(string? reason)
    {
        Func<string?, Task>? pause = _pauseAction;
        _pauseAction = null;
        return pause is null ? Task.CompletedTask : pause(reason);
    }

    private Task CancelPauseAsync()
    {
        _pauseAction = null;
        return Task.CompletedTask;
    }

    private async Task PauseJob(string group, string name, string? reason)
    {
        if (!CanPause)
        {
            return;
        }

        PauseDetails details = ActionLog.PauseDetailsFor(reason);
        await ExecuteMutatingActionAsync(
            () => Api.PauseJobWith(Scheduler.ActiveSchedulerName!, new JobKeyDto(group, name), details),
            "Paused job " + DisplayValueHelper.FormatKey(group, name) + ".",
            "Job " + DisplayValueHelper.FormatKey(group, name) + " was not paused - it no longer exists.",
            actionName: "PauseJob",
            target: DisplayValueHelper.FormatKey(group, name),
            note: DashboardActionLog.PauseNote(details));
    }

    private async Task ResumeJob(string group, string name)
    {
        if (!CanResume)
        {
            return;
        }

        await ExecuteMutatingActionAsync(
            () => Api.ResumeJob(Scheduler.ActiveSchedulerName!, new JobKeyDto(group, name)),
            "Resumed job " + DisplayValueHelper.FormatKey(group, name) + ".",
            "Job " + DisplayValueHelper.FormatKey(group, name) + " was not resumed - it no longer exists.",
            actionName: "ResumeJob",
            target: DisplayValueHelper.FormatKey(group, name));
    }

    private async Task TriggerJob(string group, string name)
    {
        if (!CanTrigger || !_triggering.Add((group, name)))
        {
            return;
        }

        try
        {
            await ExecuteMutatingActionAsync(
                () => Api.TriggerJob(Scheduler.ActiveSchedulerName!, new JobKeyDto(group, name)),
                "Triggered job " + DisplayValueHelper.FormatKey(group, name) + ".",
                actionName: "TriggerJob",
                target: DisplayValueHelper.FormatKey(group, name));
        }
        finally
        {
            _triggering.Remove((group, name));
        }
    }

    private Task PauseGroup(string group, string? reason)
    {
        PauseDetails details = ActionLog.PauseDetailsFor(reason);
        return ExecuteGroupActionAsync(
            group,
            schedulerName => Api.PauseJobGroupWith(schedulerName, group, details),
            "Paused",
            DashboardActionLog.PauseNote(details));
    }

    private Task ResumeGroup(string group)
    {
        return ExecuteGroupActionAsync(
            group,
            schedulerName => Api.ResumeJobGroup(schedulerName, group),
            "Resumed");
    }

    /// <remarks>
    /// A loop over the group's jobs: <see cref="IScheduler" /> has no group-level trigger.
    /// </remarks>
    private async Task TriggerGroup(string group)
    {
        if (!_triggering.Add((group, null)))
        {
            return;
        }

        try
        {
            await ExecuteForEachJobInGroupAsync(
                group,
                (schedulerName, jobKey) => Api.TriggerJob(schedulerName, jobKey),
                "Triggered");
        }
        finally
        {
            _triggering.Remove((group, null));
        }
    }

    private void PromptDelete(string group, string name)
    {
        _pendingDeleteGroup = group;
        _pendingDeleteName = name;
        _pendingDeleteKey = DisplayValueHelper.FormatKey(group, name);
        _showDeleteConfirm = true;
    }

    private async Task ConfirmDeleteAsync()
    {
        // Closed before the call rather than after it, as the Timeline's dialogs are, so a second click on
        // Confirm sends nothing: one that reaches the page before the dialog is drawn closed finds it shut.
        if (!_showDeleteConfirm)
        {
            return;
        }

        _showDeleteConfirm = false;
        string? group = _pendingDeleteGroup;
        string? name = _pendingDeleteName;
        if (!CanDelete || string.IsNullOrWhiteSpace(group) || string.IsNullOrWhiteSpace(name))
        {
            return;
        }

        await ExecuteMutatingActionAsync(
            () => Api.DeleteJob(Scheduler.ActiveSchedulerName!, new JobKeyDto(group, name)),
            "Deleted job " + DisplayValueHelper.FormatKey(group, name) + ".",
            "Job " + DisplayValueHelper.FormatKey(group, name) + " was not deleted - it no longer exists.",
            actionName: "DeleteJob",
            target: DisplayValueHelper.FormatKey(group, name));
    }

    private Task CancelDeleteAsync()
    {
        _showDeleteConfirm = false;
        return Task.CompletedTask;
    }

    private async Task ExecuteMutatingActionAsync(
        Func<ValueTask> operation,
        string successMessage,
        string actionName,
        string target)
    {
        string? schedulerName = Scheduler.ActiveSchedulerName;
        if (IsReadOnly || string.IsNullOrWhiteSpace(schedulerName))
        {
            return;
        }

        try
        {
            await operation();
            ActionLog.Record(schedulerName, actionName, target, succeeded: true);
            Toasts.Success(successMessage);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            ActionLog.Failed(schedulerName, actionName, target, ex);
            Toasts.Error(ex.Message);
        }
    }

    private async Task ExecuteMutatingActionAsync(
        Func<ValueTask<bool>> operation,
        string successMessage,
        string noOpMessage,
        string actionName,
        string target,
        string? note = null)
    {
        string? schedulerName = Scheduler.ActiveSchedulerName;
        if (IsReadOnly || string.IsNullOrWhiteSpace(schedulerName))
        {
            return;
        }

        try
        {
            bool applied = await operation();
            ActionLog.Record(schedulerName, actionName, target, succeeded: applied, note);
            if (applied)
            {
                Toasts.Success(successMessage);
            }
            else
            {
                Toasts.Info(noOpMessage);
            }
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            ActionLog.Failed(schedulerName, actionName, target, ex, note);
            Toasts.Error(ex.Message);
        }
    }

    /// <summary>
    /// One call on the group itself, and one Action Log entry with the group as its target: what
    /// <em>Pause group</em> and <em>Resume group</em> make.
    /// </summary>
    private async Task ExecuteGroupActionAsync(
        string group,
        Func<string, ValueTask> operation,
        string actionVerb,
        string? note = null)
    {
        string? schedulerName = Scheduler.ActiveSchedulerName;
        if (IsReadOnly || string.IsNullOrWhiteSpace(schedulerName))
        {
            return;
        }

        try
        {
            await operation(schedulerName);

            ActionLog.Record(schedulerName, actionVerb + "JobGroup", group, succeeded: true, note);
            Toasts.Success(actionVerb + " job group " + group + ".");
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            ActionLog.Failed(schedulerName, actionVerb + "JobGroup", group, ex, note);
            Toasts.Error(ex.Message);
        }
    }

    /// <summary>
    /// <paramref name="operation" /> on each job in the group, and one Action Log entry with the group as its
    /// target: what <em>Trigger group</em> makes, because a scheduler has no group-level trigger.
    /// </summary>
    private async Task ExecuteForEachJobInGroupAsync(
        string group,
        Func<string, JobKeyDto, ValueTask> operation,
        string actionVerb)
    {
        string? schedulerName = Scheduler.ActiveSchedulerName;
        if (IsReadOnly || string.IsNullOrWhiteSpace(schedulerName))
        {
            return;
        }

        try
        {
            // The group filter matches groups that contain it, so the exact group is selected here. A
            // page at a time, because a group with more jobs in it than the server's MaxPageSize is a
            // group an unbounded Take could not read at all over HTTP.
            List<JobKeyDto> jobsInGroup = [];
            DashboardJobQuery groupQuery = new() { GroupContains = group, Take = PagedQuery.DefaultTake };
            while (true)
            {
                PagedResult<JobKeyDto> groupPage = await Api.QueryJobs(schedulerName, groupQuery);
                foreach (JobKeyDto job in groupPage.Items)
                {
                    if (string.Equals(job.Group, group, StringComparison.Ordinal))
                    {
                        jobsInGroup.Add(job);
                    }
                }

                if (!groupPage.HasMore || groupPage.Items.Count == 0)
                {
                    break;
                }

                groupQuery = groupQuery with { Skip = groupQuery.Skip + groupPage.Items.Count };
            }

            foreach (JobKeyDto job in jobsInGroup)
            {
                await operation(schedulerName, job);
            }

            ActionLog.Record(schedulerName, actionVerb + "JobGroup", group, succeeded: true, jobsInGroup.Count + " job(s)");
            Toasts.Success(actionVerb + " " + jobsInGroup.Count + " job(s) in group " + group + ".");
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            ActionLog.Failed(schedulerName, actionVerb + "JobGroup", group, ex);
            Toasts.Error(ex.Message);
        }
    }

    public void Dispose()
    {
        Scheduler.OnSchedulerChanged -= OnSchedulerChanged;
        Scheduler.OnDisplayChanged -= OnDisplayChanged;
        _cancellation.Cancel();
        _cancellation.Dispose();
    }
