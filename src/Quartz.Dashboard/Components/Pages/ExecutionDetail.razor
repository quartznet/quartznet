@page "/quartz/history/{EntryId}"
@using System.Globalization
@using Microsoft.Extensions.Options
@using Quartz.Dashboard.Components.Shared
@using Quartz.Dashboard.Services
@implements IDisposable
@inject IQuartzApiClient Api
@inject SchedulerState Scheduler
@inject IOptions<QuartzDashboardOptions> Options
@inject ToastService Toasts
@inject DashboardActionLog ActionLog

<div class="qz-page">
    <h1>Execution</h1>

    <div class="qz-row">
        <a class="qz-details-link" href="@DashboardLink.To(Options.Value, "history")">Back to execution history</a>
        @* Only on a final failure, as on the history page; the label says whether the run's input goes with it.
           A job no longer stored cannot be fired, so the button is disabled and its title says why. *@
        @if (OffersRunAgain(_entry))
        {
            <button type="button"
                    class="qz-button qz-button-primary"
                    data-testid="execution-run-again"
                    disabled="@(_running || _jobGone)"
                    title="@(_jobGone ? RunAgainInput.JobGone(Target(_entry)) : null)"
                    @onclick="RunAgainAsync">Run again @RunAgainInput.Label(_entry)</button>
        }
    </div>

    @if (_isLoading)
    {
        <LoadingSpinner />
    }
    else if (_historyUnavailable)
    {
        <p class="qz-muted" data-testid="execution-unavailable">
            This scheduler runs in another process and its Quartz HTTP API does not serve single executions.
            Upgrade that host to read an execution's captured log here.
        </p>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <ErrorAlert Message="@_error" OnRetry="LoadDataAsync" />
    }
    else if (_entry is null)
    {
        <p class="qz-muted" data-testid="execution-not-found">
            Execution not found. It may have been trimmed from the history since the listing was read.
        </p>
    }
    else
    {
        <table class="qz-table">
            <tbody>
                <tr><th>Job</th><td><KeyBadge GroupName="@_entry.JobGroup" ItemName="@_entry.JobName" /></td></tr>
                <tr><th>Trigger</th><td><KeyBadge GroupName="@_entry.TriggerGroup" ItemName="@_entry.TriggerName" /></td></tr>
                <tr><th>Node</th><td class="qz-table-cell-mono">@_entry.SchedulerInstanceId</td></tr>
                <tr><th>Fired</th><td>@Scheduler.FormatInSelectedTimeZone(_entry.FiredAtUtc, "u")</td></tr>
                <tr><th>Duration</th><td>@FormatDuration(_entry.Duration)</td></tr>
                <tr><th>Result</th><td><StateIndicator State="@RunResultDisplay.Label(_entry)" /></td></tr>
                <tr><th>Summary</th><td data-testid="execution-summary">@(string.IsNullOrEmpty(_entry.Summary) ? "—" : _entry.Summary)</td></tr>
                <tr><th>Manual</th><td data-testid="execution-manual">@(_entry.Manual ? "Yes: asked for with Trigger now or TriggerJob" : "No: fired by its schedule")</td></tr>
                <tr><th>Attempt</th><td>@AttemptLabel(_entry)</td></tr>
                <tr><th>Error</th><td>@(string.IsNullOrEmpty(_entry.ExceptionMessage) ? "—" : _entry.ExceptionMessage)</td></tr>
                <tr><th>Fire instance</th><td class="qz-table-cell-mono" data-testid="execution-fire-instance">@(string.IsNullOrEmpty(_entry.FireInstanceId) ? "—" : _entry.FireInstanceId)</td></tr>
                <tr><th>Input</th><td data-testid="execution-input-state">@RunAgainInput.State(_entry)</td></tr>
            </tbody>
        </table>

        @if (_entry.Input is { } input)
        {
            <h2>Input</h2>
            <pre class="qz-execution-log" data-testid="execution-input">@input</pre>
        }

        <h2>Metrics</h2>
        @if (_metrics.Count == 0)
        {
            <p class="qz-muted" data-testid="execution-no-metrics">
                The job reported no metrics for this run. A job reports them with
                <code>context.Result = JobRunReport.Succeeded().With(name, value)</code>.
            </p>
        }
        else
        {
            <table class="qz-table" data-testid="execution-metrics">
                <thead>
                    <tr><th>Metric</th><th>Value</th></tr>
                </thead>
                <tbody>
                    @foreach (KeyValuePair<string, string> metric in _metrics)
                    {
                        <tr><td class="qz-table-cell-mono">@metric.Key</td><td class="qz-table-cell-mono">@metric.Value</td></tr>
                    }
                </tbody>
            </table>
        }

        <h2>Captured log</h2>
        @if (string.IsNullOrEmpty(_entry.Log))
        {
            <p class="qz-muted" data-testid="execution-no-log">
                No log lines were captured for this execution. A scheduler keeps them when it calls
                <code>UseExecutionLogCapture()</code>.
            </p>
        }
        else
        {
            <pre class="qz-execution-log" data-testid="execution-log">@_entry.Log</pre>
        }
    }
</div>

@code {
    private bool _isLoading = true;
    private string? _error;
    private bool _historyUnavailable;
    private DashboardHistoryEntry? _entry;
    private List<KeyValuePair<string, string>> _metrics = [];
    private bool _running;
    private bool _jobGone;

    [Parameter]
    public string EntryId { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        Scheduler.OnSchedulerChanged += OnSchedulerChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadDataAsync();
    }

    private async void OnSchedulerChanged(object? sender, EventArgs e)
    {
        await LoadDataAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _error = null;
        _historyUnavailable = false;
        _entry = null;
        _metrics = [];
        _jobGone = false;

        try
        {
            string? schedulerName = Scheduler.ActiveSchedulerName;
            if (string.IsNullOrWhiteSpace(schedulerName) || string.IsNullOrWhiteSpace(EntryId))
            {
                return;
            }

            _entry = await Api.GetExecution(schedulerName, EntryId);
            _metrics = RunResultDisplay.Metrics(_entry?.MetricsJson);

            // One question, and only when the button is offered: a page shows one run, so asking whether
            // its job is still stored costs a single read.
            if (OffersRunAgain(_entry))
            {
                _jobGone = await RunAgainInput.IsJobGone(Api, schedulerName, new JobKeyDto(_entry.JobGroup, _entry.JobName));
            }
        }
        catch (NotSupportedException)
        {
            // A fact about the target, as on the history page: it serves no single executions, and a
            // retry button would invite a reader to ask again for something that will not arrive.
            _historyUnavailable = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// Fires the run's job again, by hand, with its recorded input when it has one, as the history page's
    /// <em>Run again</em> does and under the same action-log names.
    /// </summary>
    private async Task RunAgainAsync()
    {
        string? schedulerName = Scheduler.ActiveSchedulerName;
        if (_entry is not { } run || Options.Value.ReadOnly || string.IsNullOrWhiteSpace(schedulerName))
        {
            return;
        }

        string target = Target(run);
        JobKeyDto job = new(run.JobGroup, run.JobName);
        JobDataMap? input = RunAgainInput.DataFor(run);
        string action = input is null ? "TriggerJob" : "TriggerJobWithData";

        _running = true;
        try
        {
            await Api.TriggerJob(schedulerName, job, input);
            ActionLog.Record(schedulerName, action, target, succeeded: true);
            Toasts.Success("Triggered job " + target + " " + RunAgainInput.Describe(run) + ".");
        }
        catch (Exception ex)
        {
            // The job may have gone since the page was loaded; then the button is disabled from here on.
            _jobGone = await RunAgainInput.FailedForAJobGone(Api, schedulerName, job, ex);
            ActionLog.Record(schedulerName, action, target, succeeded: false, ex.Message);
            Toasts.Error(_jobGone ? RunAgainInput.JobGone(target) : ex.Message);
        }
        finally
        {
            _running = false;
        }
    }

    /// <summary>
    /// Whether the page offers <em>Run again</em>: a final failure, on a dashboard that may change things.
    /// </summary>
    private bool OffersRunAgain([System.Diagnostics.CodeAnalysis.NotNullWhen(true)] DashboardHistoryEntry? entry)
    {
        return entry is not null && !Options.Value.ReadOnly && !entry.Succeeded && !entry.RetryScheduled;
    }

    private static string Target(DashboardHistoryEntry entry) => DisplayValueHelper.FormatKey(entry.JobGroup, entry.JobName);

    private static string AttemptLabel(DashboardHistoryEntry entry)
    {
        return entry.RetryAttempt == 0
            ? "the regular fire"
            : "retry " + entry.RetryAttempt.ToString(CultureInfo.InvariantCulture);
    }

    private static string FormatDuration(TimeSpan duration)
    {
        if (duration <= TimeSpan.Zero)
        {
            return "n/a";
        }

        if (duration < TimeSpan.FromSeconds(1))
        {
            return duration.TotalMilliseconds.ToString("0.###", CultureInfo.InvariantCulture) + " ms";
        }

        if (duration < TimeSpan.FromMinutes(1))
        {
            return duration.TotalSeconds.ToString("0.##", CultureInfo.InvariantCulture) + " s";
        }

        return duration.ToString("g", CultureInfo.InvariantCulture);
    }

    public void Dispose()
    {
        Scheduler.OnSchedulerChanged -= OnSchedulerChanged;
    }
}
