@page "/quartz/calendars"
@using Microsoft.Extensions.Options
@using Quartz.Dashboard.Components.Shared
@using Quartz.Dashboard.Services
@using Quartz.Impl.Calendar
@implements IDisposable
@inject IQuartzApiClient Api
@inject SchedulerState Scheduler
@inject SchedulerAuthorization Authorization
@inject IOptions<QuartzDashboardOptions> Options
@inject ToastService Toasts
@inject DashboardActionLog ActionLog

<div class="qz-page">
    <h1>Calendars</h1>

    @if (CanAdd)
    {
        <section class="qz-section">
            <h2>Create or replace cron calendar</h2>
            <div class="qz-form-group">
                <label class="qz-form-label" for="calendar-name">Calendar name</label>
                <input id="calendar-name" class="qz-input" @bind="_newCalendarName" />
            </div>
            <div class="qz-form-group">
                <label class="qz-form-label" for="calendar-cron">Cron expression</label>
                <input id="calendar-cron" class="qz-input qz-input-mono" @bind="_newCalendarCronExpression" />
            </div>
            <div class="qz-form-group">
                <label class="qz-form-label" for="calendar-description">Description</label>
                <input id="calendar-description" class="qz-input" @bind="_newCalendarDescription" />
            </div>
            <div class="qz-live-filter-grid">
                <label class="qz-live-filter-item">
                    <input type="checkbox" @bind="_replaceCalendar" />
                    <span>Replace if existing</span>
                </label>
                <label class="qz-live-filter-item">
                    <input type="checkbox" @bind="_updateTriggers" />
                    <span>Update associated triggers</span>
                </label>
            </div>
            <div class="qz-actions qz-group-actions">
                <button type="button" class="qz-button qz-button-primary" @onclick="CreateOrUpdateCalendarAsync">Save calendar</button>
                <button type="button" class="qz-button" @onclick="ResetNewCalendarForm">Reset</button>
            </div>
        </section>
    }

    @if (_isLoading)
    {
        <LoadingSpinner />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <ErrorAlert Message="@_error" OnRetry="LoadDataAsync" />
    }
    else if (_calendarNames.Count == 0)
    {
        <p class="qz-muted">No calendars found.</p>
    }
    else
    {
        <ul class="qz-list">
            @foreach (string calendarName in _calendarNames)
            {
                <li>
                    <div class="qz-list-item-main">
                        <a href="@GetCalendarPath(calendarName)">@calendarName</a>
                    </div>
                    @if (CanDelete)
                    {
                        <div class="qz-list-item-actions">
                            <button type="button" class="qz-button qz-button-danger" @onclick="() => PromptDelete(calendarName)">Delete</button>
                        </div>
                    }
                </li>
            }
        </ul>
    }
</div>

<ConfirmDialog IsOpen="@_showDeleteConfirm"
               Title="Delete calendar"
               Message="@($"Delete {_pendingCalendarName}? This cannot be undone.")"
               OnConfirm="ConfirmDeleteAsync"
               OnCancel="CancelDeleteAsync" />

@code {
    private readonly List<string> _calendarNames = [];
    private bool _isLoading = true;
    private string? _error;
    private bool _showDeleteConfirm;
    private string _pendingCalendarName = string.Empty;
    private string _newCalendarName = string.Empty;
    private string _newCalendarCronExpression = "0 0/5 * ? * *";
    private string _newCalendarDescription = string.Empty;
    private bool _replaceCalendar = true;
    private bool _updateTriggers;

    /// <summary>
    /// Cancelled when the reader leaves the page, which stops the read in flight: its answer would be thrown away.
    /// </summary>
    private readonly CancellationTokenSource _cancellation = new();

    /// <summary>
    /// Whether the visitor may add or replace a calendar on the active scheduler: never while the dashboard
    /// is read-only, and only at their role's level under an operation policy.
    /// </summary>
    private bool CanAdd => Authorization.Allows(Scheduler.ActiveSchedulerName, Quartz.HttpApiContract.SchedulerRoutes.AddCalendar);

    /// <inheritdoc cref="CanAdd" />
    private bool CanDelete => Authorization.Allows(Scheduler.ActiveSchedulerName, Quartz.HttpApiContract.SchedulerRoutes.DeleteCalendar);

    protected override async Task OnInitializedAsync()
    {
        Scheduler.OnSchedulerChanged += OnSchedulerChanged;
        await LoadDataAsync();
    }

    private async void OnSchedulerChanged(object? sender, EventArgs e)
    {
        await LoadDataAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            _calendarNames.Clear();
            string? schedulerName = Scheduler.ActiveSchedulerName;
            if (!string.IsNullOrWhiteSpace(schedulerName))
            {
                CancellationToken cancellationToken = _cancellation.Token;
                await Authorization.LoadOperations(schedulerName, cancellationToken);

                IReadOnlyList<string> names = await Api.GetCalendarNames(schedulerName, cancellationToken);
                _calendarNames.AddRange(names);
            }
        }
        catch (OperationCanceledException) when (_cancellation.IsCancellationRequested)
        {
            // The reader left. A read nobody is waiting for is not a failure.
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetCalendarPath(string name)
    {
        return DashboardLink.To(Options.Value, "calendars/" + Uri.EscapeDataString(name));
    }

    private async Task CreateOrUpdateCalendarAsync()
    {
        string? schedulerName = Scheduler.ActiveSchedulerName;
        if (!CanAdd || string.IsNullOrWhiteSpace(schedulerName))
        {
            return;
        }

        string calendarName = _newCalendarName.Trim();
        if (string.IsNullOrWhiteSpace(calendarName))
        {
            Toasts.Error("Calendar name is required.");
            return;
        }

        string cronExpression = _newCalendarCronExpression.Trim();
        if (string.IsNullOrWhiteSpace(cronExpression))
        {
            Toasts.Error("Cron expression is required.");
            return;
        }

        try
        {
            CronCalendar calendar = new(baseCalendar: null, cronExpression, TimeZoneInfo.Utc)
            {
                Description = string.IsNullOrWhiteSpace(_newCalendarDescription) ? null : _newCalendarDescription.Trim()
            };

            AddCalendarRequest request = new(calendarName, calendar, _replaceCalendar, _updateTriggers);
            await Api.AddCalendar(schedulerName, request);
            ActionLog.Record(
                schedulerName,
                _replaceCalendar ? "UpsertCalendar" : "CreateCalendar",
                calendarName,
                succeeded: true,
                _updateTriggers ? "updateTriggers=true" : null);
            Toasts.Success("Saved calendar " + calendarName + ".");
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            ActionLog.Failed(
                schedulerName,
                _replaceCalendar ? "UpsertCalendar" : "CreateCalendar",
                calendarName,
                ex);
            Toasts.Error(ex.Message);
        }
    }

    private Task ResetNewCalendarForm()
    {
        _newCalendarName = string.Empty;
        _newCalendarCronExpression = "0 0/5 * ? * *";
        _newCalendarDescription = string.Empty;
        _replaceCalendar = true;
        _updateTriggers = false;
        return Task.CompletedTask;
    }

    private void PromptDelete(string calendarName)
    {
        _pendingCalendarName = calendarName;
        _showDeleteConfirm = true;
    }

    private async Task ConfirmDeleteAsync()
    {
        // Closed before the call rather than after it, as the Timeline's dialogs are, so a second click on
        // Confirm sends nothing: one that reaches the page before the dialog is drawn closed finds it shut.
        if (!_showDeleteConfirm)
        {
            return;
        }

        _showDeleteConfirm = false;
        string? schedulerName = Scheduler.ActiveSchedulerName;
        string calendarName = _pendingCalendarName;
        if (!CanDelete || string.IsNullOrWhiteSpace(schedulerName) || string.IsNullOrWhiteSpace(calendarName))
        {
            return;
        }

        try
        {
            bool deleted = await Api.DeleteCalendar(schedulerName, calendarName);
            ActionLog.Record(schedulerName, "DeleteCalendar", calendarName, succeeded: deleted);
            if (deleted)
            {
                Toasts.Success("Deleted calendar " + calendarName + ".");
            }
            else
            {
                Toasts.Info("Calendar " + calendarName + " was not deleted - it no longer exists.");
            }

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            ActionLog.Failed(schedulerName, "DeleteCalendar", calendarName, ex);
            Toasts.Error(ex.Message);
        }
    }

    private Task CancelDeleteAsync()
    {
        _showDeleteConfirm = false;
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        Scheduler.OnSchedulerChanged -= OnSchedulerChanged;
        _cancellation.Cancel();
        _cancellation.Dispose();
    }
}
