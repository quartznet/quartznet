@page "/quartz/calendars"
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Options
@using Quartz.Dashboard.Components.Shared
@using Quartz.Dashboard.Services
@implements IDisposable
@inject IQuartzApiClient Api
@inject SchedulerState Scheduler
@inject SchedulerAuthorization Authorization
@inject IOptions<QuartzDashboardOptions> Options
@inject ToastService Toasts
@inject DashboardActionLog ActionLog
@inject IServiceProvider Services
@inject IJSRuntime JS

<div class="qz-page qz-calendars-page">
    <div class="qz-page-header">
        <h1>Calendars</h1>
        <LastUpdated At="@_lastUpdatedAt" StaleReason="@_staleReason" OnRefresh="RefreshAsync" RefreshDisabled="@_refreshing" />
    </div>

    @* The listing comes first; the form to create a calendar opens on asking, above it, and closes once it has
       saved, with the new calendar's row picked out. *@
    @if (CanAdd)
    {
        @if (_creating)
        {
            @* A name the listing holds is a replace, and the editor asks about it as one. *@
            <CalendarEditor ExistingNames="@_calendarNames" OnSaved="OnCalendarSavedAsync" OnCancel="StopCreating" />
        }
        else
        {
            <div class="qz-actions qz-group-actions">
                <button type="button" class="qz-button qz-button-primary" data-testid="calendar-new" @onclick="StartCreating">New calendar</button>
            </div>
        }
    }

    @if (_isLoading)
    {
        <LoadingSpinner />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <ErrorAlert Message="@_error" OnRetry="LoadDataAsync" />
    }
    else if (_calendarNames.Count == 0)
    {
        <p class="qz-muted">No calendars found.</p>
    }
    else
    {
        @* Scrolls inside its card when a name is wider than a phone leaves it, rather than clipping the actions. *@
        <div class="qz-table-scroll">
            <table class="qz-table qz-calendars-table" data-testid="calendars-table">
                <thead>
                    <tr>
                        <th scope="col">Name</th>
                        <th scope="col" class="qz-col-type">Type</th>
                        @if (CanDelete)
                        {
                            <th scope="col"><span class="qz-sr-only">Actions</span></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (int index = 0; index < _calendarNames.Count; index++)
                    {
                        string calendarName = _calendarNames[index];
                        CalendarType type = TypeOf(calendarName);
                        bool justSaved = string.Equals(calendarName, _justSaved, StringComparison.Ordinal);
                        <tr id="@RowId(index)" class="@(justSaved ? "qz-row-new" : null)" data-testid="calendar-row">
                            <td>
                                <a href="@GetCalendarPath(calendarName)">@calendarName</a>
                                @* Under the name on a phone, where the Type column gives its width to the actions. *@
                                <div class="qz-muted qz-calendar-type-inline">@type.Text</div>
                            </td>
                            <td class="qz-col-type" data-testid="calendar-type" title="@type.Reason">@type.Text</td>
                            @if (CanDelete)
                            {
                                <td class="qz-table-cell-actions">
                                    <button type="button" class="qz-button qz-button-danger" @onclick="() => PromptDelete(calendarName)">Delete</button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_calendarNames.Count > TypeReadLimit)
        {
            <p class="qz-muted" data-testid="calendar-types-capped">The type is read for the first @TypeReadLimit calendars only.</p>
        }
    }
</div>

<ConfirmDialog IsOpen="@_showDeleteConfirm"
               Title="Delete calendar"
               ConfirmText="Delete"
               Message="@($"Delete {_pendingCalendarName}? This cannot be undone.")"
               OnConfirm="ConfirmDeleteAsync"
               OnCancel="CancelDeleteAsync" />

@code {
    /// <summary>The most calendars whose type the listing reads; a scheduler holding more lists the rest without one.</summary>
    private const int TypeReadLimit = 200;

    /// <summary>How many of those reads are out at once.</summary>
    private const int TypeReadConcurrency = 8;

    private readonly List<string> _calendarNames = [];

    /// <summary>Whether the form to create a calendar is open.</summary>
    private bool _creating;

    /// <summary>The calendar the form last saved, whose row is picked out until the form is opened again.</summary>
    private string? _justSaved;

    /// <summary>Whether the next render scrolls to the row of the calendar just saved.</summary>
    private bool _revealSaved;

    /// <summary>Each listed calendar's type, by name, read with the names.</summary>
    private Dictionary<string, CalendarType> _types = new(StringComparer.Ordinal);
    private bool _isLoading = true;
    private string? _error;
    private bool _showDeleteConfirm;
    private string _pendingCalendarName = string.Empty;

    /// <summary>
    /// Cancelled when the reader leaves the page, which stops the read in flight: its answer would be thrown away.
    /// </summary>
    private readonly CancellationTokenSource _cancellation = new();

    /// <summary>
    /// When the listing on screen was read, or <see langword="null" /> while it holds nothing read.
    /// </summary>
    private DateTimeOffset? _lastUpdatedAt;

    /// <summary>
    /// Why the last read failed while there was a listing to keep, or <see langword="null" />.
    /// </summary>
    private string? _staleReason;

    /// <summary>Whether the read the Refresh button asked for is out.</summary>
    private bool _refreshing;

    /// <summary>The clock the page says it read the listing at.</summary>
    private TimeProvider Clock => Services.GetService<TimeProvider>() ?? TimeProvider.System;

    /// <summary>
    /// Whether the visitor may add or replace a calendar on the active scheduler: never while the dashboard
    /// is read-only, and only at their role's level under an operation policy.
    /// </summary>
    private bool CanAdd => Authorization.Allows(Scheduler.ActiveSchedulerName, Quartz.HttpApiContract.SchedulerRoutes.AddCalendar);

    /// <inheritdoc cref="CanAdd" />
    private bool CanDelete => Authorization.Allows(Scheduler.ActiveSchedulerName, Quartz.HttpApiContract.SchedulerRoutes.DeleteCalendar);

    protected override async Task OnInitializedAsync()
    {
        Scheduler.OnSchedulerChanged += OnSchedulerChanged;
        Scheduler.OnDisplayChanged += OnDisplayChanged;
        await LoadDataAsync();
    }

    /// <summary>The time zone changed: draw the last-updated time again in it, and read nothing.</summary>
    private void OnDisplayChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async void OnSchedulerChanged(object? sender, EventArgs e)
    {
        // Another scheduler's calendars are not ones to keep: a read of this one that fails has nothing to show.
        ClearListing();
        await LoadDataAsync();
        await InvokeAsync(StateHasChanged);
    }

    /// <remarks>
    /// The names on screen are replaced when the new ones arrive rather than emptied before the read, so a
    /// read that fails keeps them, marked stale beside the time they were read. Only a page with nothing read
    /// to show has the error in its place.
    /// </remarks>
    private async Task LoadDataAsync()
    {
        // A refresh keeps the listing on screen until the new one arrives; the spinner is for a page with
        // nothing read to show.
        _isLoading = !_refreshing || _lastUpdatedAt is null;
        _error = null;

        try
        {
            string? schedulerName = Scheduler.ActiveSchedulerName;
            if (string.IsNullOrWhiteSpace(schedulerName))
            {
                ClearListing();
                return;
            }

            CancellationToken cancellationToken = _cancellation.Token;
            await Authorization.LoadOperations(schedulerName, cancellationToken);

            IReadOnlyList<string> names = await Api.GetCalendarNames(schedulerName, cancellationToken);
            Dictionary<string, CalendarType> types = await ReadTypesAsync(schedulerName, names, cancellationToken);
            _calendarNames.Clear();
            _calendarNames.AddRange(names);
            _types = types;
            _lastUpdatedAt = Clock.GetUtcNow();
            _staleReason = null;
        }
        catch (OperationCanceledException) when (_cancellation.IsCancellationRequested)
        {
            // The reader left. A read nobody is waiting for is not a failure.
        }
        catch (Exception ex) when (_lastUpdatedAt is not null)
        {
            _staleReason = ex.Message;
        }
        catch (Exception ex)
        {
            ClearListing();
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// The Refresh button: the names read again, kept on screen until the new ones arrive, and the header's
    /// status read with them. The page reads nothing on its own after it has loaded.
    /// </summary>
    private async Task RefreshAsync()
    {
        if (_refreshing)
        {
            return;
        }

        _refreshing = true;
        try
        {
            await LoadDataAsync();
        }
        finally
        {
            _refreshing = false;
        }

        if (!_cancellation.IsCancellationRequested)
        {
            Scheduler.NotifyRefreshed();
        }
    }

    /// <summary>Opens the form to create a calendar, and stops picking out the row the last one saved.</summary>
    private void StartCreating()
    {
        _creating = true;
        _justSaved = null;
    }

    private void StopCreating()
    {
        _creating = false;
    }

    private static string RowId(int index) => "qz-calendar-row-" + index.ToString(System.Globalization.CultureInfo.InvariantCulture);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_revealSaved && _justSaved is { } saved)
        {
            _revealSaved = false;
            int index = _calendarNames.IndexOf(saved);
            if (index >= 0)
            {
                try
                {
                    await JS.InvokeVoidAsync("quartzDashboardDom.revealById", RowId(index));
                }
                catch (JSDisconnectedException)
                {
                }
            }
        }
    }

    /// <summary>
    /// Empties the listing, for a scheduler of which there is nothing read to keep showing.
    /// </summary>
    private void ClearListing()
    {
        _calendarNames.Clear();
        _types = new Dictionary<string, CalendarType>(StringComparer.Ordinal);
        _lastUpdatedAt = null;
        _staleReason = null;
    }

    private string GetCalendarPath(string name)
    {
        return DashboardLink.To(Options.Value, "calendars/" + Uri.EscapeDataString(name));
    }

    private CalendarType TypeOf(string calendarName)
    {
        return _types.TryGetValue(calendarName, out CalendarType? type) ? type : new CalendarType("—", null);
    }

    /// <summary>
    /// Each calendar's type, read with the names on load and on Refresh: the scheduler lists names only, so the type
    /// is one read of each calendar, a few at a time and no more than <see cref="TypeReadLimit" /> of them. A
    /// calendar that cannot be read is listed with the reason, and the rest are still read.
    /// </summary>
    private async Task<Dictionary<string, CalendarType>> ReadTypesAsync(string schedulerName, IReadOnlyList<string> names, CancellationToken cancellationToken)
    {
        Dictionary<string, CalendarType> types = new(StringComparer.Ordinal);
        using SemaphoreSlim gate = new(TypeReadConcurrency);

        async Task<(string Name, CalendarType Type)> ReadOne(string name)
        {
            await gate.WaitAsync(cancellationToken);
            try
            {
                // A cancelled wait can still be handed the slot: SemaphoreSlim takes a cancelled waiter off its
                // queue only after the cancellation, and a read that ends in between gives its slot to that waiter.
                // So the page having gone is asked again here, before any read, and a waiter that finds it gone
                // gives the slot back without reading.
                cancellationToken.ThrowIfCancellationRequested();
                ICalendar calendar = await Api.GetCalendar(schedulerName, name, cancellationToken);
                return (name, new CalendarType(CalendarReading.ShortName(calendar), null));
            }
            catch (Exception ex) when (ex is not OperationCanceledException || !cancellationToken.IsCancellationRequested)
            {
                return (name, new CalendarType("unreadable", ex.Message));
            }
            finally
            {
                gate.Release();
            }
        }

        foreach ((string name, CalendarType type) in await Task.WhenAll(names.Take(TypeReadLimit).Select(ReadOne)))
        {
            types[name] = type;
        }

        return types;
    }

    /// <summary>
    /// A calendar was stored: the form closes, the listing is read again so a new name is on it, and its row is picked
    /// out and scrolled to.
    /// </summary>
    private async Task OnCalendarSavedAsync(string calendarName)
    {
        _creating = false;
        _justSaved = calendarName;
        await LoadDataAsync();
        _revealSaved = true;
    }

    private void PromptDelete(string calendarName)
    {
        _pendingCalendarName = calendarName;
        _showDeleteConfirm = true;
    }

    private async Task ConfirmDeleteAsync()
    {
        // Closed before the call rather than after it, as the Timeline's dialogs are, so a second click on
        // Confirm sends nothing: one that reaches the page before the dialog is drawn closed finds it shut.
        if (!_showDeleteConfirm)
        {
            return;
        }

        _showDeleteConfirm = false;
        string? schedulerName = Scheduler.ActiveSchedulerName;
        string calendarName = _pendingCalendarName;
        if (!CanDelete || string.IsNullOrWhiteSpace(schedulerName) || string.IsNullOrWhiteSpace(calendarName))
        {
            return;
        }

        try
        {
            bool deleted = await Api.DeleteCalendar(schedulerName, calendarName);
            ActionLog.Record(schedulerName, "DeleteCalendar", calendarName, succeeded: deleted);
            if (deleted)
            {
                Toasts.Success("Deleted calendar " + calendarName + ".");
            }
            else
            {
                Toasts.Info("Calendar " + calendarName + " was not deleted - it no longer exists.");
            }

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            ActionLog.Failed(schedulerName, "DeleteCalendar", calendarName, ex);
            Toasts.Error(ex.Message);
        }
    }

    private Task CancelDeleteAsync()
    {
        _showDeleteConfirm = false;
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        // First, so no read the page started outlives it by a single step: a type read still waiting for its turn
        // finds the token cancelled and does not read.
        _cancellation.Cancel();
        Scheduler.OnSchedulerChanged -= OnSchedulerChanged;
        Scheduler.OnDisplayChanged -= OnDisplayChanged;
        _cancellation.Dispose();
    }

    /// <summary>A calendar's type as the listing shows it, and why it could not be read when it could not.</summary>
    private sealed record CalendarType(string Text, string? Reason);
}
