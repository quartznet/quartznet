@page "/quartz/calendars/{CalendarName}"
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Options
@using Quartz.Dashboard.Components.Shared
@using Quartz.Dashboard.Services
@implements IDisposable
@inject IQuartzApiClient Api
@inject SchedulerState Scheduler
@inject SchedulerAuthorization Authorization
@inject IOptions<QuartzDashboardOptions> Options
@inject ToastService Toasts
@inject DashboardActionLog ActionLog
@inject NavigationManager Navigation
@inject IServiceProvider Services

<div class="qz-page">
    <div class="qz-page-header">
        <h1>Calendar Detail</h1>
        <LastUpdated At="@_lastUpdatedAt" StaleReason="@_staleReason" OnRefresh="RefreshAsync" RefreshDisabled="@_refreshing" />
    </div>

    @if (_isLoading)
    {
        <LoadingSpinner />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <ErrorAlert Message="@_error" OnRetry="LoadDataAsync" />
    }
    else if (_calendar is null)
    {
        <p class="qz-muted">Calendar not found.</p>
    }
    else
    {
        <h2>@CalendarName</h2>
        <p data-testid="calendar-used-by">
            @if (_usedBy is 0)
            {
                @* Nothing to list, so nothing to link to. *@
                <span>Not used by any trigger</span>
            }
            else if (_usedBy is { } usedBy)
            {
                <a href="@TriggersPath">Used by @CalendarReading.Count(usedBy, "trigger")</a>
            }
            else
            {
                <a href="@TriggersPath">Triggers using it</a>
                <span class="qz-muted"> — how many could not be read: @_usedByUnreadable</span>
            }
        </p>
        @if (CanEdit || CanDelete)
        {
            <div class="qz-actions qz-group-actions">
                @if (CanEdit && !_editing)
                {
                    <button type="button" class="qz-button qz-button-primary" data-testid="calendar-edit" @onclick="StartEditing">Edit calendar</button>
                }
                @if (CanDelete)
                {
                    <button type="button" class="qz-button qz-button-danger" @onclick="PromptDelete">Delete calendar</button>
                }
            </div>
        }
        @if (CanAdd && !CalendarReading.IsEditable(CalendarReading.KindOf(_calendar)))
        {
            <p class="qz-muted" data-testid="calendar-not-editable">The dashboard edits the six built-in calendar types; this one is edited in code.</p>
        }

        @if (_editing && CanEdit)
        {
            @* The editor holds the type, the zone and the rules, so the view of them is not drawn twice. *@
            <CalendarEditor Calendar="@_calendar" CalendarName="@CalendarName" UsedBy="@_usedBy" OnSaved="OnCalendarSavedAsync" OnCancel="StopEditing" />
        }
        else
        {
            <CalendarExclusions Calendar="@_calendar" From="@_readAt" />
        }

        @if (_baseChain.Count > 0)
        {
            <section class="qz-section qz-calendar-chain" data-testid="calendar-base-chain">
                <h2>Base calendars</h2>
                <p class="qz-muted">
                    A time is excluded when this calendar or any calendar under it excludes it. Each base calendar is a
                    copy stored inside this one, not a link to a calendar stored under another name: replacing that
                    calendar does not change this one.
                </p>
                @for (int index = 0; index < _baseChain.Count; index++)
                {
                    ICalendar baseCalendar = _baseChain[index];
                    <section class="qz-calendar-chain-item" data-testid="calendar-base">
                        <h3>@(index + 1). @CalendarReading.Describe(CalendarReading.KindOf(baseCalendar))</h3>
                        <CalendarExclusions Calendar="@baseCalendar" From="@_readAt" />
                    </section>
                }
            </section>
        }
    }
</div>

<ConfirmDialog IsOpen="@_showDeleteConfirm"
               Title="Delete calendar"
               Message="@($"Delete {CalendarName}? This cannot be undone.")"
               OnConfirm="ConfirmDeleteAsync"
               OnCancel="CancelDeleteAsync" />

@code {
    private bool _isLoading = true;
    private string? _error;
    private ICalendar? _calendar;

    /// <summary>The calendars the one on screen is layered over, nearest first.</summary>
    private List<ICalendar> _baseChain = [];

    /// <summary>When the calendar on screen was read: the instant a cron calendar's next exclusions are read from.</summary>
    private DateTimeOffset _readAt;

    private bool _showDeleteConfirm;

    /// <summary>
    /// How many triggers name the calendar, counted with the calendar, or <see langword="null" /> when the count
    /// could not be read: the calendar is still shown.
    /// </summary>
    private int? _usedBy;

    /// <summary>Why the count of the triggers that use the calendar could not be read.</summary>
    private string? _usedByUnreadable;

    /// <summary>Whether the editor is open.</summary>
    private bool _editing;

    /// <summary>
    /// Cancelled when the reader leaves the page, which stops the read in flight: its answer would be thrown away.
    /// </summary>
    private readonly CancellationTokenSource _cancellation = new();

    /// <summary>
    /// When the calendar on screen was read, or <see langword="null" /> while the page holds nothing read.
    /// </summary>
    private DateTimeOffset? _lastUpdatedAt;

    /// <summary>
    /// Why the last read failed while there was a calendar to keep, or <see langword="null" />.
    /// </summary>
    private string? _staleReason;

    /// <summary>Whether the read the Refresh button asked for is out.</summary>
    private bool _refreshing;

    /// <summary>The clock the page says it read the calendar at.</summary>
    private TimeProvider Clock => Services.GetService<TimeProvider>() ?? TimeProvider.System;

    [Parameter]
    public string CalendarName { get; set; } = string.Empty;

    /// <summary>
    /// Whether the visitor may delete the calendar: never while the dashboard is read-only, and only at
    /// their role's level under an operation policy.
    /// </summary>
    private bool CanDelete => Authorization.Allows(Scheduler.ActiveSchedulerName, Quartz.HttpApiContract.SchedulerRoutes.DeleteCalendar);

    /// <summary>
    /// Whether the visitor may replace the calendar: an Administer operation, as creating one is.
    /// </summary>
    private bool CanAdd => Authorization.Allows(Scheduler.ActiveSchedulerName, Quartz.HttpApiContract.SchedulerRoutes.AddCalendar);

    /// <summary>Whether the visitor may replace the calendar, and the dashboard edits its type.</summary>
    private bool CanEdit => CanAdd && _calendar is not null && CalendarReading.IsEditable(CalendarReading.KindOf(_calendar));

    /// <summary>The Triggers listing narrowed to the triggers that name this calendar.</summary>
    private string TriggersPath => DashboardLink.To(Options.Value, "triggers?calendar=" + Uri.EscapeDataString(CalendarName));

    protected override void OnInitialized()
    {
        Scheduler.OnSchedulerChanged += OnSchedulerChanged;
        Scheduler.OnDisplayChanged += OnDisplayChanged;
    }

    /// <remarks>
    /// The one read of a page view: Blazor sets the parameters after initializing, the first time too, so a read
    /// in both would read the calendar and count its triggers twice.
    /// </remarks>
    protected override async Task OnParametersSetAsync()
    {
        // Another calendar's rules are not ones to keep, nor an editor opened on them.
        ClearCalendar();
        _editing = false;
        await LoadDataAsync();
    }

    private async void OnSchedulerChanged(object? sender, EventArgs e)
    {
        ClearCalendar();
        await LoadDataAsync();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>The time zone changed: draw the last-updated time again in it, and read nothing.</summary>
    private void OnDisplayChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    /// <remarks>
    /// The calendar on screen is replaced when the new read arrives rather than emptied before it, so a refresh
    /// that fails keeps it, marked stale beside the time it was read. Only a page with nothing read to show has
    /// the error in its place.
    /// </remarks>
    private async Task LoadDataAsync()
    {
        // A refresh keeps the calendar on screen until the new read arrives; the spinner is for a page with
        // nothing read to show.
        _isLoading = !_refreshing || _lastUpdatedAt is null;
        _error = null;

        try
        {
            string? schedulerName = Scheduler.ActiveSchedulerName;
            if (string.IsNullOrWhiteSpace(schedulerName))
            {
                ClearCalendar();
                return;
            }

            CancellationToken cancellationToken = _cancellation.Token;
            await Authorization.LoadOperations(schedulerName, cancellationToken);
            ICalendar calendar = await Api.GetCalendar(schedulerName, CalendarName, cancellationToken);
            (int? usedBy, string? usedByUnreadable) = await CountUsersAsync(schedulerName, cancellationToken);
            _calendar = calendar;
            _baseChain = CalendarReading.BaseChainOf(calendar);
            _usedBy = usedBy;
            _usedByUnreadable = usedByUnreadable;
            _readAt = Clock.GetUtcNow();
            _lastUpdatedAt = _readAt;
            _staleReason = null;
        }
        catch (OperationCanceledException) when (_cancellation.IsCancellationRequested)
        {
            // The reader left. A read nobody is waiting for is not a failure.
        }
        catch (Exception ex) when (_lastUpdatedAt is not null)
        {
            _staleReason = ex.Message;
        }
        catch (Exception ex)
        {
            ClearCalendar();
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// The Refresh button: the calendar read again, kept on screen until the new read arrives, and the header's
    /// status read with it. The page reads nothing on its own after it has loaded.
    /// </summary>
    private async Task RefreshAsync()
    {
        if (_refreshing)
        {
            return;
        }

        _refreshing = true;
        try
        {
            await LoadDataAsync();
        }
        finally
        {
            _refreshing = false;
        }

        if (!_cancellation.IsCancellationRequested)
        {
            Scheduler.NotifyRefreshed();
        }
    }

    /// <summary>
    /// Empties the page, for a calendar or a scheduler of which there is nothing read to keep showing.
    /// </summary>
    private void ClearCalendar()
    {
        _calendar = null;
        _baseChain = [];
        _usedBy = null;
        _usedByUnreadable = null;
        _lastUpdatedAt = null;
        _staleReason = null;
    }

    /// <summary>
    /// How many triggers name the calendar: one count, with no trigger read, on load and on Refresh. A source that
    /// cannot count leaves the page with the link and the reason, and the calendar is still shown.
    /// </summary>
    private async Task<(int? Count, string? Unreadable)> CountUsersAsync(string schedulerName, CancellationToken cancellationToken)
    {
        try
        {
            PagedResult<TriggerHeaderDto> page = await Api.QueryTriggers(
                schedulerName,
                new DashboardTriggerQuery { CalendarName = CalendarName, Take = 0 },
                cancellationToken);
            return page.TotalCount is { } count ? (count, null) : (null, "the source does not count them.");
        }
        catch (Exception ex) when (ex is not OperationCanceledException || !cancellationToken.IsCancellationRequested)
        {
            return (null, ex.Message);
        }
    }

    private void StartEditing()
    {
        _editing = true;
    }

    private void StopEditing()
    {
        _editing = false;
    }

    /// <summary>The calendar was replaced: the editor closes and the page reads what is stored now.</summary>
    private async Task OnCalendarSavedAsync(string calendarName)
    {
        _editing = false;
        await LoadDataAsync();
    }

    private void PromptDelete()
    {
        _showDeleteConfirm = true;
    }

    private async Task ConfirmDeleteAsync()
    {
        // Closed before the call rather than after it, as the Timeline's dialogs are, so a second click on
        // Confirm sends nothing: one that reaches the page before the dialog is drawn closed finds it shut.
        if (!_showDeleteConfirm)
        {
            return;
        }

        _showDeleteConfirm = false;
        string? schedulerName = Scheduler.ActiveSchedulerName;
        if (!CanDelete || string.IsNullOrWhiteSpace(schedulerName))
        {
            return;
        }

        try
        {
            bool deleted = await Api.DeleteCalendar(schedulerName, CalendarName);
            ActionLog.Record(schedulerName, "DeleteCalendar", CalendarName, succeeded: deleted);
            if (deleted)
            {
                Toasts.Success("Deleted calendar " + CalendarName + ".");
                Navigation.NavigateTo(DashboardLink.To(Options.Value, "calendars"));
            }
            else
            {
                Toasts.Info("Calendar " + CalendarName + " was not deleted - it no longer exists.");
            }
        }
        catch (Exception ex)
        {
            ActionLog.Failed(schedulerName, "DeleteCalendar", CalendarName, ex);
            Toasts.Error(ex.Message);
        }
    }

    private Task CancelDeleteAsync()
    {
        _showDeleteConfirm = false;
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        Scheduler.OnSchedulerChanged -= OnSchedulerChanged;
        Scheduler.OnDisplayChanged -= OnDisplayChanged;
        _cancellation.Cancel();
        _cancellation.Dispose();
    }
}
