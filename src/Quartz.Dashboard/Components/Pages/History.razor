@page "/quartz/history"
@using System.Globalization
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Options
@using Quartz.Dashboard.Components.Shared
@using Quartz.Dashboard.Services
@implements IDisposable
@inject IQuartzApiClient Api
@inject SchedulerState Scheduler
@inject IOptions<QuartzDashboardOptions> Options
@inject NavigationManager Navigation
@inject ToastService Toasts
@inject DashboardActionLog ActionLog
@inject Microsoft.JSInterop.IJSRuntime JsRuntime
@inject IServiceProvider Services

<div class="qz-page">
    <h1>Execution History</h1>

    <div class="qz-live-filters">
        <div class="qz-live-filter-grid">
            <div class="qz-form-group">
                <label class="qz-form-label" for="history-window-filter">Window</label>
                @* Applies on its own, as the node dropdown does, to the chart, the stat cards and the listing. *@
                <select id="history-window-filter"
                        class="qz-select"
                        data-testid="history-window-filter"
                        value="@_appliedWindow.Key"
                        @onchange="OnWindowChangedAsync">
                    @foreach (RunStatisticsWindow window in RunStatisticsWindow.Offered)
                    {
                        <option value="@window.Key">@window.Label</option>
                    }
                </select>
            </div>
            <div class="qz-form-group">
                <label class="qz-form-label" for="history-job-filter">Job filter</label>
                <input id="history-job-filter"
                       class="qz-input qz-input-mono"
                       placeholder="group.name or fragment"
                       @bind="_jobFilter" />
            </div>
            <div class="qz-form-group">
                <label class="qz-form-label" for="history-trigger-filter">Trigger filter</label>
                <input id="history-trigger-filter"
                       class="qz-input qz-input-mono"
                       placeholder="group.name or fragment"
                       @bind="_triggerFilter" />
            </div>
            <div class="qz-form-group">
                <label class="qz-form-label" for="history-node-filter">Node</label>
                @* Applies on its own rather than waiting for the button beside the text filters: a
                   dropdown that does nothing when it is changed reads as a broken control. *@
                <select id="history-node-filter"
                        class="qz-select"
                        value="@_appliedNodeFilter"
                        @onchange="OnNodeFilterChangedAsync">
                    <option value="">All nodes</option>
                    @foreach (string node in NodeOptions())
                    {
                        <option value="@node">@node</option>
                    }
                </select>
            </div>
            <div class="qz-form-group">
                <label class="qz-form-label" for="history-outcome-filter">Outcome</label>
                @* Applies on its own, as the node dropdown does. *@
                <select id="history-outcome-filter"
                        class="qz-select"
                        value="@_appliedOutcomeFilter"
                        @onchange="OnOutcomeFilterChangedAsync">
                    <option value="">All outcomes</option>
                    <option value="@FailedFinallyFilter">Failed after retries</option>
                </select>
            </div>
            <div class="qz-form-group">
                <span class="qz-form-label" id="history-result-filter-label">Results</span>
                @* Each box applies on its own, as the dropdowns do. None ticked is every result. *@
                <div class="qz-result-filter" role="group" aria-labelledby="history-result-filter-label">
                    @foreach (JobRunResult offered in RunResultDisplay.Offered)
                    {
                        JobRunResult result = offered;
                        <label class="qz-result-filter-option">
                            <input type="checkbox"
                                   id="@ResultFilterId(result)"
                                   checked="@_appliedResults.Contains(result)"
                                   @onchange="args => OnResultFilterChangedAsync(result, args)" />
                            @RunResultDisplay.Label(result)
                        </label>
                    }
                </div>
            </div>
            @if (_appliedExactJob is { } exactJob)
            {
                <div class="qz-form-group" data-testid="history-exact-job">
                    <span class="qz-form-label">This job only</span>
                    <div class="qz-row">
                        <KeyBadge GroupName="@exactJob.Group" ItemName="@exactJob.Name" />
                        <button type="button" class="qz-button" data-testid="history-exact-job-clear" @onclick="ClearExactJobAsync">Every job</button>
                    </div>
                </div>
            }
        </div>
        <div class="qz-actions qz-group-actions">
            <button type="button" class="qz-button qz-button-primary" @onclick="ApplyFiltersAsync">Apply filters</button>
            <button type="button" class="qz-button" @onclick="ClearFiltersAsync" disabled="@(!HasFilters && string.IsNullOrWhiteSpace(_jobFilter) && string.IsNullOrWhiteSpace(_triggerFilter))">Clear</button>
        </div>
    </div>

    @if (!_isLoading && string.IsNullOrWhiteSpace(_error) && !_historyUnavailable && _filterUnsupported is null)
    {
        <p class="qz-muted">Page @_page / @_totalPages · Showing @_entries.Count row(s) · Total @_totalCount row(s)</p>
        <p class="qz-muted">@BuildFilterSummary()</p>
    }

    @if (_isLoading)
    {
        <LoadingSpinner />
    }
    else if (_filterUnsupported is not null)
    {
        @* The target serves history, just not these filters: an older host would answer with rows they
           exclude, so the read is refused rather than shown as though it were filtered. *@
        <p class="qz-muted" data-testid="history-filter-unsupported">@_filterUnsupported</p>
    }
    else if (_historyUnavailable)
    {
        @* Not an error: the scheduler is answering, and what it is saying is that it keeps no history a
           reader here can ask for. A retry button would invite a reader to try again for something that
           will not arrive. *@
        <p class="qz-muted" data-testid="history-unavailable">
            This scheduler runs in another process and its Quartz HTTP API does not serve execution
            history. Upgrade that host to read what it has run here.
        </p>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <ErrorAlert Message="@_error" OnRetry="LoadDataAsync" />
    }
    else if (_totalCount == 0)
    {
        <p class="qz-muted">@(HasFilters ? "No execution history matched the current filters." : "No execution history yet. Run a job to populate history.")</p>
    }
    else
    {
        @if (_statistics is { } windowed)
        {
            @* Over every run the filters and the window match, read with the chart: the page's own rows are a
               page, not the history. *@
            <div class="qz-grid qz-grid-4" data-testid="history-window-stats">
                <StatCard Title="@WindowStatTitle("Runs")" Value="@WindowRunCount(windowed).ToString("N0", CultureInfo.InvariantCulture)" Icon="▦" Color="info" />
                <StatCard Title="@WindowStatTitle("Success rate")" Value="@WindowSuccessRate(windowed)" Icon="✔" Color="success" />
                <StatCard Title="@WindowStatTitle("Failed")" Value="@WindowFailed(windowed)" Icon="⚠" Color="error" />
                <StatCard Title="@WindowStatTitle("Longest run")" Value="@WindowLongestRun(windowed)" Icon="⏱️" Color="info" />
            </div>

            <RunStatisticsChart Statistics="@windowed.Statistics" From="@windowed.From" Before="@windowed.Before" Scope="@windowed.Window.Scope" />
        }
        else
        {
            @* A source that cannot count runs over time: the figures are over the rows on this page, and say so. *@
            <div class="qz-grid qz-grid-4">
                <StatCard Title="@ScopedStatTitle("Success rate")" Value="@GetSuccessRateText()" Icon="✔" Color="success" />
                <StatCard Title="@ScopedStatTitle("Failures")" Value="@_pageFailureCount.ToString()" Icon="⚠" Color="error" />
                <StatCard Title="@ScopedStatTitle("Avg duration")" Value="@FormatDurationValue(_pageAverageDuration)" Icon="⏱️" Color="info" />
                <StatCard Title="@ScopedStatTitle("P95 duration")" Value="@FormatDurationValue(_pageP95Duration)" Icon="📈" Color="info" />
            </div>
        }

        @* qz-history-table fixes the column widths, so a long key, summary or error is cut inside its cell
           rather than pushing Run again off the page; the node column gives way on narrower screens. *@
        <table class="qz-table qz-history-table">
            <thead>
                <tr>
                    <th class="qz-col-key">Job</th>
                    <th class="qz-col-key">Trigger</th>
                    <th class="qz-col-node">Node</th>
                    <th class="qz-col-fired">Fired</th>
                    <th class="qz-col-duration">Duration</th>
                    <th class="qz-col-result">Result</th>
                    <th class="qz-col-summary">Summary</th>
                    <th class="qz-col-error">Error</th>
                    @if (!IsReadOnly)
                    {
                        <th class="qz-col-actions">Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (DashboardHistoryEntry entry in _entries)
                {
                    <tr>
                        <td class="qz-col-key" data-testid="history-job">@KeyCell(entry.JobGroup, entry.JobName)</td>
                        <td class="qz-col-key" data-testid="history-trigger">@KeyCell(entry.TriggerGroup, entry.TriggerName)</td>
                        <td class="qz-col-node qz-table-cell-mono qz-history-node" title="@NodeLabel(entry.SchedulerInstanceId)">@NodeLabel(entry.SchedulerInstanceId)</td>
                        <td class="qz-col-fired">
                            @* The fire time is the link to the row's own page, which carries its log. A
                               row a store left unnamed has no page to open. Its date and its time each
                               stay on one line, so the cell is two lines at most. *@
                            @if (entry.EntryId is { Length: > 0 } entryId)
                            {
                                <a class="qz-details-link qz-history-fired" data-testid="history-execution-link" href="@ExecutionPath(entryId)"><span>@FiredDate(entry.FiredAtUtc)</span> <span>@FiredTime(entry.FiredAtUtc)</span></a>
                            }
                            else
                            {
                                <span class="qz-history-fired"><span>@FiredDate(entry.FiredAtUtc)</span> <span>@FiredTime(entry.FiredAtUtc)</span></span>
                            }
                        </td>
                        <td class="qz-col-duration">@FormatDurationValue(entry.Duration)</td>
                        <td class="qz-col-result">
                            <StateIndicator State="@RunResultDisplay.Label(entry)" />
                            @if (entry.Manual)
                            {
                                <span class="qz-run-badge" data-testid="history-manual" title="Asked for with Trigger now or TriggerJob, not fired by a schedule">Manual</span>
                            }
                        </td>
                        <td class="qz-col-summary qz-history-summary">
                            @if (entry.Summary is { Length: > 0 } summary)
                            {
                                <span class="qz-history-summary-text qz-history-clamp" title="@summary">@summary</span>
                            }
                            @foreach (KeyValuePair<string, string> metric in RunResultDisplay.Metrics(entry.MetricsJson))
                            {
                                <span class="qz-metric-chip" title="@(metric.Key + ": " + metric.Value)">@metric.Key: @metric.Value</span>
                            }
                        </td>
                        <td class="qz-col-error" data-testid="history-error">
                            @* Cut to two lines; the title, and the row's own page, carry the whole message. *@
                            @if (entry.ExceptionMessage is { Length: > 0 } error)
                            {
                                <span class="qz-history-clamp" title="@error">@error</span>
                            }
                        </td>
                        @if (!IsReadOnly)
                        {
                            <td class="qz-col-actions">
                                @* Only on a final failure. A row the trigger is going to retry already
                                   has another attempt coming, and a button here would add a second one. *@
                                @if (FailedFinally(entry))
                                {
                                    <button type="button"
                                            class="qz-button qz-button-primary"
                                            data-testid="history-run-again"
                                            title="@RunAgainInput.Hint(entry)"
                                            @onclick="() => RunAgainAsync(entry)">Run again</button>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>

        <Pagination TotalItems="@_totalCount"
                    PageSize="@_currentPageSize"
                    CurrentPage="@_page"
                    OnPageChanged="OnPageChangedAsync" />
    }

    @if (!_isLoading && string.IsNullOrWhiteSpace(_error) && !_misfiresUnavailable)
    {
        @* The overview's misfire tile links here by fragment, so the id is part of that contract. *@
        <section id="misfires" class="qz-section qz-misfires">
            <h2>Misfires</h2>
            <p class="qz-muted">
                Firings that did not happen. Nothing ran, so these never appear above: a misfire is one
                the scheduler missed, whose misfire instruction decided what happened instead, an
                overlap is one the trigger's overlap policy skipped because its last firing still ran, and
                a veto is one a trigger listener refused.
            </p>

            @if (_misfires.Count == 0)
            {
                <p class="qz-muted">No misfires recorded@(HasNodeFilter ? " for this node." : ".")</p>
            }
            else
            {
                <table class="qz-table">
                    <thead>
                        <tr>
                            <th>Trigger</th>
                            <th>Job</th>
                            <th>Node</th>
                            <th>Missed firing</th>
                            <th>Noticed</th>
                            <th>Reason</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (DashboardMisfireEntry misfire in _misfires)
                        {
                            <tr>
                                <td><KeyBadge GroupName="@misfire.TriggerGroup" ItemName="@misfire.TriggerName" /></td>
                                <td>
                                    @if (misfire.JobKey is { } jobKey)
                                    {
                                        <KeyBadge GroupName="@jobKey.Group" ItemName="@jobKey.Name" />
                                    }
                                    else
                                    {
                                        <span class="qz-muted">&#8212;</span>
                                    }
                                </td>
                                <td class="qz-table-cell-mono qz-misfire-node">@NodeLabel(misfire.SchedulerInstanceId)</td>
                                <td>@FormatFiredAt(misfire.ScheduledFireTimeUtc)</td>
                                <td>@FormatFiredAt(misfire.MisfiredAtUtc)</td>
                                <td class="qz-misfire-reason">@RunResultDisplay.Label(misfire.Reason)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    }
</div>

@code {
    private readonly List<DashboardHistoryEntry> _entries = [];
    private string? _copiedKey;
    private bool _isLoading = true;
    private string? _error;
    private int _page = 1;
    private readonly int _pageSize = 25;
    private int _currentPageSize = 25;
    private int _totalCount;
    private int _totalPages = 1;
    private int _pageSuccessCount;
    private int _pageFailureCount;
    private TimeSpan _pageAverageDuration;
    private TimeSpan _pageP95Duration;
    private string _jobFilter = string.Empty;
    private string _triggerFilter = string.Empty;
    private string _appliedJobFilter = string.Empty;
    private string _appliedTriggerFilter = string.Empty;
    private string _appliedNodeFilter = string.Empty;
    private string _appliedOutcomeFilter = string.Empty;
    private readonly List<DashboardMisfireEntry> _misfires = [];
    private bool _misfiresUnavailable;

    /// <summary>
    /// The window the chart, the stat cards and the listing are narrowed to; <see cref="RunStatisticsWindow.All" />
    /// for the whole history.
    /// </summary>
    private RunStatisticsWindow _appliedWindow = RunStatisticsWindow.All;

    /// <summary>Where the window starts on this read, on a bucket boundary; <see langword="null" /> for all of it.</summary>
    private DateTimeOffset? _windowFrom;

    /// <summary>
    /// The run statistics the chart and the stat cards show, or <see langword="null" /> when the data source
    /// cannot count runs and the cards fall back to the page.
    /// </summary>
    private RunStatisticsView? _statistics;

    /// <summary>What <see cref="_statistics" /> was read for: the scheduler, the filters and the window.</summary>
    private string? _statisticsKey;

    private DateTimeOffset _statisticsReadAt;

    /// <summary>
    /// How long the statistics are kept before the refresh reads them again. The listing refreshes every
    /// second; counting a whole window that often would be a query over every row it holds, every second.
    /// </summary>
    private static readonly TimeSpan StatisticsRefreshInterval = TimeSpan.FromSeconds(30);

    private TimeProvider Clock => Services.GetService<TimeProvider>() ?? TimeProvider.System;

    /// <summary>
    /// The one job the listing is narrowed to, matched exactly, or <see langword="null" />.
    /// </summary>
    /// <remarks>
    /// Set by the <c>jobGroup</c> and <c>jobName</c> query parameters, which the Job Detail page's history
    /// link writes. The job text filter above matches fragments, so it would also list <c>nightly-2</c> for
    /// <c>nightly</c>.
    /// </remarks>
    private JobKeyDto? _appliedExactJob;

    /// <summary>
    /// The results the listing is narrowed to, in the order the page offers them; empty for every result.
    /// </summary>
    private readonly List<JobRunResult> _appliedResults = [];

    /// <summary>
    /// Why the target cannot answer the filters applied, or <see langword="null" />.
    /// </summary>
    /// <remarks>
    /// A scheduler in another process whose host is older than 4.4 ignores the job, fire-time and result
    /// filters, and the HTTP client refuses rather than show an unfiltered page as a filtered one. That is
    /// not "no history here": the page says which it is.
    /// </remarks>
    private string? _filterUnsupported;

    /// <summary>
    /// The one outcome the dropdown and the <c>outcome</c> query parameter name.
    /// </summary>
    /// <remarks>
    /// A word rather than a boolean in the URL, so the parameter can gain another value — "cancelled",
    /// say — without the links already written meaning something different.
    /// </remarks>
    private const string FailedFinallyFilter = "failed";

    /// <summary>
    /// Whether this scheduler's history is somewhere this page cannot read — a scheduler in another
    /// process whose Quartz HTTP API predates the history routes.
    /// </summary>
    /// <remarks>
    /// Distinct from an empty history and from an error: a page that said "no execution history yet" of
    /// a scheduler that has been running jobs all day would be stating something untrue, and one that
    /// showed a retry button would invite a reader to ask again for something that will not arrive.
    /// </remarks>
    private bool _historyUnavailable;

    /// <summary>
    /// The nodes the filter offers: the scheduler's cluster nodes, so a node that has stopped producing
    /// history is still selectable.
    /// </summary>
    /// <remarks>
    /// Read once per scheduler rather than on every refresh tick — on a persistent store it is a database
    /// read, and the page refreshes once a second.
    /// </remarks>
    private readonly List<string> _clusterNodes = [];
    private string? _clusterNodesLoadedFor;
    private PeriodicTimer? _refreshTimer;
    private CancellationTokenSource? _refreshLoopCancellation;
    private bool _loadingInProgress;

    [Parameter]
    [SupplyParameterFromQuery(Name = "job")]
    public string? JobFilterQuery { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "trigger")]
    public string? TriggerFilterQuery { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "node")]
    public string? NodeFilterQuery { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "outcome")]
    public string? OutcomeFilterQuery { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "page")]
    public int? PageQuery { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "jobGroup")]
    public string? JobGroupQuery { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "jobName")]
    public string? JobNameQuery { get; set; }

    /// <summary>
    /// The results to list, comma-separated: <c>result=failed,cancelled</c>.
    /// </summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "result")]
    public string? ResultQuery { get; set; }

    /// <summary>
    /// The window: <c>window=24h</c>. One nobody knows reads as the whole history.
    /// </summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "window")]
    public string? WindowQuery { get; set; }

    private bool HasFilters =>
        !string.IsNullOrWhiteSpace(_appliedJobFilter) ||
        !string.IsNullOrWhiteSpace(_appliedTriggerFilter) ||
        HasNodeFilter ||
        HasOutcomeFilter ||
        HasFilterFrom44;

    /// <summary>
    /// Whether a filter only a 4.4 host answers is applied.
    /// </summary>
    private bool HasFilterFrom44 => _appliedExactJob is not null || _appliedResults.Count > 0 || HasWindow;

    private bool HasWindow => !ReferenceEquals(_appliedWindow, RunStatisticsWindow.All);

    private bool HasNodeFilter => !string.IsNullOrWhiteSpace(_appliedNodeFilter);

    private bool HasOutcomeFilter => string.Equals(_appliedOutcomeFilter, FailedFinallyFilter, StringComparison.OrdinalIgnoreCase);

    private bool IsReadOnly => Options.Value.ReadOnly;

    protected override Task OnInitializedAsync()
    {
        Scheduler.OnSchedulerChanged += OnSchedulerChanged;
        _refreshLoopCancellation = new CancellationTokenSource();
        _refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _ = RunRefreshLoopAsync(_refreshLoopCancellation.Token);
        return Task.CompletedTask;
    }

    protected override async Task OnParametersSetAsync()
    {
        string requestedJobFilter = (JobFilterQuery ?? string.Empty).Trim();
        string requestedTriggerFilter = (TriggerFilterQuery ?? string.Empty).Trim();
        string requestedNodeFilter = (NodeFilterQuery ?? string.Empty).Trim();
        string requestedOutcomeFilter = NormalizeOutcome(OutcomeFilterQuery);
        int requestedPage = Math.Max(1, PageQuery ?? 1);

        _jobFilter = requestedJobFilter;
        _triggerFilter = requestedTriggerFilter;
        _appliedJobFilter = requestedJobFilter;
        _appliedTriggerFilter = requestedTriggerFilter;
        _appliedNodeFilter = requestedNodeFilter;
        _appliedOutcomeFilter = requestedOutcomeFilter;
        _appliedExactJob = NormalizeExactJob(JobGroupQuery, JobNameQuery);
        SetResults(NormalizeResults(ResultQuery));
        _appliedWindow = RunStatisticsWindow.Parse(WindowQuery);
        _page = requestedPage;

        await LoadDataAsync();
    }

    private async void OnSchedulerChanged(object? sender, EventArgs e)
    {
        _page = 1;
        await LoadDataAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RunRefreshLoopAsync(CancellationToken cancellationToken)
    {
        if (_refreshTimer is null)
        {
            return;
        }

        try
        {
            while (await _refreshTimer.WaitForNextTickAsync(cancellationToken))
            {
                try
                {
                    await InvokeAsync(async () =>
                    {
                        await LoadDataAsync();
                        StateHasChanged();
                    });
                }
                catch (OperationCanceledException)
                {
                    break;
                }
                catch (ObjectDisposedException)
                {
                    break;
                }
                catch (InvalidOperationException)
                {
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private async Task LoadDataAsync()
    {
        if (_loadingInProgress)
        {
            return;
        }

        _loadingInProgress = true;
        _isLoading = true;
        // Nothing has answered yet, so there is no misfire feed to show. Anything short of a page coming
        // back — no scheduler selected, a read that threw — leaves the section out rather than rendering
        // "no misfires" over an answer nobody gave.
        _misfiresUnavailable = true;
        _historyUnavailable = false;
        _filterUnsupported = null;
        _error = null;
        _entries.Clear();
        _misfires.Clear();
        _totalCount = 0;
        _totalPages = 1;
        _pageSuccessCount = 0;
        _pageFailureCount = 0;
        _pageAverageDuration = TimeSpan.Zero;
        _pageP95Duration = TimeSpan.Zero;

        try
        {
            string? schedulerName = Scheduler.ActiveSchedulerName;
            if (string.IsNullOrWhiteSpace(schedulerName))
            {
                return;
            }

            await LoadClusterNodesAsync(schedulerName);

            DateTimeOffset now = Clock.GetUtcNow();
            _windowFrom = _appliedWindow.From(now);

            PagedResult<DashboardHistoryEntry> page = await Api.QueryExecutions(HistoryQuery(schedulerName, _page));

            _currentPageSize = _pageSize;
            _totalCount = page.TotalCount ?? page.Items.Count;
            _totalPages = Math.Max(1, (int) Math.Ceiling((double) _totalCount / _currentPageSize));

            // A skip past the end answers with an empty page, where the reader asking for page 99 of 3
            // means the last one. Clamp and ask again, as the job and trigger listings do.
            if (_page > _totalPages)
            {
                _page = _totalPages;
                page = await Api.QueryExecutions(HistoryQuery(schedulerName, _page));
            }

            _entries.AddRange(page.Items);

            PagedResult<DashboardMisfireEntry> misfires = await Api.QueryMisfires(MisfireQuery(schedulerName));
            _misfiresUnavailable = false;
            _misfires.AddRange(misfires.Items);

            ComputeAnalytics();
            await LoadStatisticsAsync(schedulerName, now);
        }
        catch (NotSupportedException ex) when (HasFilterFrom44)
        {
            // The target serves history, but not these filters. Its words say which host and why.
            _filterUnsupported = ex.Message;
        }
        catch (NotSupportedException)
        {
            // The scheduler runs in another process and its API serves no history. That is a fact about
            // the target rather than a failure of this read, so the page says it instead of showing an
            // error with a retry button.
            _historyUnavailable = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
            _loadingInProgress = false;
        }
    }

    /// <summary>
    /// Reads the chart's statistics when the scheduler, a filter or the window changed, or when the last
    /// read is <see cref="StatisticsRefreshInterval" /> old, and keeps the last ones otherwise.
    /// </summary>
    /// <remarks>
    /// A source that cannot count — an <see cref="IQuartzApiClient" /> of an application's own, a scheduler in
    /// another process whose host is older than 4.4 — leaves the chart out, and the stat cards go back to the
    /// rows on the page. So does a read that fails: the listing is the page, and it has answered.
    /// </remarks>
    private async Task LoadStatisticsAsync(string schedulerName, DateTimeOffset now)
    {
        string key = string.Join(
            "\u001f",
            schedulerName,
            NormalizedNodeFilter(),
            _appliedJobFilter,
            _appliedTriggerFilter,
            _appliedOutcomeFilter,
            _appliedExactJob?.Group,
            _appliedExactJob?.Name,
            string.Join(",", _appliedResults),
            _appliedWindow.Key);

        if (string.Equals(key, _statisticsKey, StringComparison.Ordinal) && now - _statisticsReadAt < StatisticsRefreshInterval)
        {
            return;
        }

        _statisticsKey = key;
        _statisticsReadAt = now;

        try
        {
            _statistics = await _appliedWindow.Read(Api, StatisticsQuery(schedulerName), now);
        }
        catch (Exception)
        {
            _statistics = null;
        }
    }

    /// <summary>
    /// The listing's filters, as the run statistics read them; the window is <see cref="RunStatisticsWindow" />'s.
    /// </summary>
    private ExecutionStatisticsQuery StatisticsQuery(string schedulerName) => new()
    {
        SchedulerName = schedulerName,
        SchedulerInstanceId = NormalizedNodeFilter(),
        JobContains = string.IsNullOrWhiteSpace(_appliedJobFilter) ? null : _appliedJobFilter,
        TriggerContains = string.IsNullOrWhiteSpace(_appliedTriggerFilter) ? null : _appliedTriggerFilter,
        FailedFinally = HasOutcomeFilter ? true : null,
        Job = _appliedExactJob is { } exactJob ? new JobKey(exactJob.Name, exactJob.Group) : null,
        Results = _appliedResults.Count == 0 ? null : [.. _appliedResults]
    };

    /// <summary>
    /// Reads the scheduler's nodes so the filter can offer them. A data source that cannot answer leaves
    /// the dropdown with whatever the loaded rows name, which is a narrower list rather than an error.
    /// </summary>
    private async Task LoadClusterNodesAsync(string schedulerName)
    {
        if (string.Equals(_clusterNodesLoadedFor, schedulerName, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _clusterNodesLoadedFor = schedulerName;
        _clusterNodes.Clear();

        try
        {
            foreach (ClusterNodeDto node in await Api.QueryClusterNodes(schedulerName))
            {
                _clusterNodes.Add(node.InstanceId);
            }
        }
        catch (Exception)
        {
            // a node listing is a convenience here, not the page
        }
    }

    /// <summary>
    /// The 1-based page the pager speaks, as the <c>Skip</c>/<c>Take</c> the API speaks.
    /// </summary>
    private DashboardHistoryQuery HistoryQuery(string schedulerName, int page) => new()
    {
        SchedulerName = schedulerName,
        SchedulerInstanceId = NormalizedNodeFilter(),
        JobFilter = _appliedJobFilter,
        TriggerFilter = _appliedTriggerFilter,
        // Only ever true or absent: the dropdown offers the failures nobody is going to retry, and
        // "everything but those" is not a page an operator opens this listing to read.
        FailedFinally = HasOutcomeFilter ? true : null,
        Job = _appliedExactJob,
        Results = _appliedResults.Count == 0 ? null : [.. _appliedResults],
        FiredFrom = _windowFrom,
        Skip = Math.Max(0, page - 1) * _pageSize,
        Take = _pageSize,
        IncludeTotalCount = true
    };

    /// <remarks>
    /// The newest page only: the misfire feed is a "what has been going wrong" list beside the history,
    /// not a listing of its own with a pager.
    /// </remarks>
    private DashboardMisfireQuery MisfireQuery(string schedulerName) => new()
    {
        SchedulerName = schedulerName,
        SchedulerInstanceId = NormalizedNodeFilter(),
        TriggerFilter = _appliedTriggerFilter,
        Job = _appliedExactJob,
        Take = _pageSize
    };

    private string? NormalizedNodeFilter() => string.IsNullOrWhiteSpace(_appliedNodeFilter) ? null : _appliedNodeFilter;

    private async Task OnPageChangedAsync(int page)
    {
        await UpdateQueryStateAsync(page, _appliedJobFilter, _appliedTriggerFilter, _appliedNodeFilter, _appliedOutcomeFilter);
    }

    private Task ApplyFiltersAsync()
    {
        return UpdateQueryStateAsync(1, _jobFilter, _triggerFilter, _appliedNodeFilter, _appliedOutcomeFilter);
    }

    private Task OnNodeFilterChangedAsync(ChangeEventArgs args)
    {
        return UpdateQueryStateAsync(1, _appliedJobFilter, _appliedTriggerFilter, args.Value?.ToString() ?? string.Empty, _appliedOutcomeFilter);
    }

    private Task OnWindowChangedAsync(ChangeEventArgs args)
    {
        return UpdateQueryStateAsync(1, _appliedJobFilter, _appliedTriggerFilter, _appliedNodeFilter, _appliedOutcomeFilter, _appliedExactJob, _appliedResults, RunStatisticsWindow.Parse(args.Value?.ToString()));
    }

    private Task OnOutcomeFilterChangedAsync(ChangeEventArgs args)
    {
        return UpdateQueryStateAsync(1, _appliedJobFilter, _appliedTriggerFilter, _appliedNodeFilter, args.Value?.ToString() ?? string.Empty);
    }

    private Task OnResultFilterChangedAsync(JobRunResult result, ChangeEventArgs args)
    {
        List<JobRunResult> results = [.. _appliedResults];
        results.Remove(result);
        if (args.Value is true)
        {
            results.Add(result);
        }

        return UpdateQueryStateAsync(1, _appliedJobFilter, _appliedTriggerFilter, _appliedNodeFilter, _appliedOutcomeFilter, _appliedExactJob, results, _appliedWindow);
    }

    private Task ClearExactJobAsync()
    {
        return UpdateQueryStateAsync(1, _appliedJobFilter, _appliedTriggerFilter, _appliedNodeFilter, _appliedOutcomeFilter, exactJob: null, _appliedResults, _appliedWindow);
    }

    private Task ClearFiltersAsync()
    {
        _jobFilter = string.Empty;
        _triggerFilter = string.Empty;
        return UpdateQueryStateAsync(1, string.Empty, string.Empty, string.Empty, string.Empty, exactJob: null, results: [], RunStatisticsWindow.All);
    }

    private Task UpdateQueryStateAsync(int page, string jobFilter, string triggerFilter, string nodeFilter, string outcomeFilter)
    {
        return UpdateQueryStateAsync(page, jobFilter, triggerFilter, nodeFilter, outcomeFilter, _appliedExactJob, _appliedResults, _appliedWindow);
    }

    private Task UpdateQueryStateAsync(
        int page,
        string jobFilter,
        string triggerFilter,
        string nodeFilter,
        string outcomeFilter,
        JobKeyDto? exactJob,
        IReadOnlyCollection<JobRunResult> results,
        RunStatisticsWindow window)
    {
        int normalizedPage = Math.Max(1, page);
        string normalizedJobFilter = jobFilter.Trim();
        string normalizedTriggerFilter = triggerFilter.Trim();
        string normalizedNodeFilter = nodeFilter.Trim();
        string normalizedOutcomeFilter = NormalizeOutcome(outcomeFilter);
        List<JobRunResult> normalizedResults = RunResultDisplay.Offered.Where(results.Contains).ToList();

        string updatedPath = BuildHistoryRelativeUri(
            normalizedPage,
            normalizedJobFilter,
            normalizedTriggerFilter,
            normalizedNodeFilter,
            normalizedOutcomeFilter,
            exactJob,
            normalizedResults,
            window);

        // Not Navigation.ToBaseRelativePath: it compares ordinally and throws when the browser URL
        // casing differs from the base URI casing (server-side route matching is case-insensitive,
        // so such URLs render fine); an unmatched base just falls through to NavigateTo below
        string currentPath = (DashboardLink.ToBaseRelative(Navigation.Uri, Navigation.BaseUri) ?? string.Empty).TrimStart('/');
        if (PathsEqual(updatedPath, currentPath))
        {
            _page = normalizedPage;
            _appliedJobFilter = normalizedJobFilter;
            _appliedTriggerFilter = normalizedTriggerFilter;
            _appliedNodeFilter = normalizedNodeFilter;
            _appliedOutcomeFilter = normalizedOutcomeFilter;
            _appliedExactJob = exactJob;
            SetResults(normalizedResults);
            _appliedWindow = window;
            return LoadDataAsync();
        }

        Navigation.NavigateTo(updatedPath, replace: true);
        return Task.CompletedTask;
    }

    private static bool PathsEqual(string left, string right)
    {
        // The path segment compares case-insensitively (route matching is case-insensitive,
        // so the browser URL casing may differ from the configured DashboardPath casing),
        // while the query string compares ordinally because filter values are case-sensitive
        int leftQueryIndex = left.IndexOf('?');
        int rightQueryIndex = right.IndexOf('?');
        ReadOnlySpan<char> leftPath = leftQueryIndex >= 0 ? left.AsSpan(0, leftQueryIndex) : left.AsSpan();
        ReadOnlySpan<char> rightPath = rightQueryIndex >= 0 ? right.AsSpan(0, rightQueryIndex) : right.AsSpan();
        ReadOnlySpan<char> leftQuery = leftQueryIndex >= 0 ? left.AsSpan(leftQueryIndex) : default;
        ReadOnlySpan<char> rightQuery = rightQueryIndex >= 0 ? right.AsSpan(rightQueryIndex) : default;

        return leftPath.Equals(rightPath, StringComparison.OrdinalIgnoreCase)
            && leftQuery.SequenceEqual(rightQuery);
    }

    /// <summary>
    /// The <c>outcome</c> parameter as the page holds it: the one value it knows, or nothing.
    /// </summary>
    /// <remarks>
    /// A value nobody recognises reads as no filter rather than as an empty page, which is what a
    /// hand-edited URL or a link from a future version would otherwise produce.
    /// </remarks>
    private static string NormalizeOutcome(string? value)
    {
        return string.Equals(value?.Trim(), FailedFinallyFilter, StringComparison.OrdinalIgnoreCase)
            ? FailedFinallyFilter
            : string.Empty;
    }

    /// <summary>
    /// The job both halves name, or <see langword="null" /> unless both are given.
    /// </summary>
    private static JobKeyDto? NormalizeExactJob(string? group, string? name)
    {
        return string.IsNullOrWhiteSpace(group) || string.IsNullOrWhiteSpace(name) ? null : new JobKeyDto(group, name);
    }

    /// <summary>
    /// The <c>result</c> parameter as the results it names, in the order the page offers them.
    /// </summary>
    /// <remarks>
    /// A name nobody recognises is dropped rather than read as a filter that matches nothing, as an unknown
    /// <c>outcome</c> is.
    /// </remarks>
    private static List<JobRunResult> NormalizeResults(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return [];
        }

        string[] names = value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return RunResultDisplay.Offered
            .Where(result => names.Contains(Enum.GetName(result) ?? string.Empty, StringComparer.OrdinalIgnoreCase))
            .ToList();
    }

    private void SetResults(IEnumerable<JobRunResult> results)
    {
        List<JobRunResult> copy = [.. results];
        _appliedResults.Clear();
        _appliedResults.AddRange(copy);
    }

    private static string ResultFilterId(JobRunResult result)
    {
        return "history-result-" + (Enum.GetName(result) ?? string.Empty).ToLowerInvariant();
    }

    private string BuildHistoryRelativeUri(
        int page,
        string jobFilter,
        string triggerFilter,
        string nodeFilter,
        string outcomeFilter,
        JobKeyDto? exactJob,
        IReadOnlyCollection<JobRunResult> results,
        RunStatisticsWindow window)
    {
        List<string> queryParts = [];
        if (page > 1)
        {
            queryParts.Add("page=" + page.ToString(System.Globalization.CultureInfo.InvariantCulture));
        }

        if (!string.IsNullOrWhiteSpace(jobFilter))
        {
            queryParts.Add("job=" + Uri.EscapeDataString(jobFilter));
        }

        if (!string.IsNullOrWhiteSpace(triggerFilter))
        {
            queryParts.Add("trigger=" + Uri.EscapeDataString(triggerFilter));
        }

        if (!string.IsNullOrWhiteSpace(nodeFilter))
        {
            queryParts.Add("node=" + Uri.EscapeDataString(nodeFilter));
        }

        if (!string.IsNullOrWhiteSpace(outcomeFilter))
        {
            queryParts.Add("outcome=" + Uri.EscapeDataString(outcomeFilter));
        }

        if (exactJob is not null)
        {
            queryParts.Add("jobGroup=" + Uri.EscapeDataString(exactJob.Group));
            queryParts.Add("jobName=" + Uri.EscapeDataString(exactJob.Name));
        }

        if (results.Count > 0)
        {
            queryParts.Add("result=" + string.Join(",", results.Select(result => (Enum.GetName(result) ?? string.Empty).ToLowerInvariant())));
        }

        if (window.Key.Length > 0)
        {
            queryParts.Add("window=" + Uri.EscapeDataString(window.Key));
        }

        if (queryParts.Count == 0)
        {
            return DashboardLink.To(Options.Value, "history");
        }

        return DashboardLink.To(Options.Value, "history?" + string.Join("&", queryParts));
    }

    private string BuildFilterSummary()
    {
        string jobPart = string.IsNullOrWhiteSpace(_appliedJobFilter) ? "Any job" : "Job: " + _appliedJobFilter;
        if (_appliedExactJob is { } exactJob)
        {
            string key = DisplayValueHelper.FormatKey(exactJob.Group, exactJob.Name);
            jobPart = string.IsNullOrWhiteSpace(_appliedJobFilter)
                ? "Job: " + key + " only"
                : "Job: " + key + " only, matching " + _appliedJobFilter;
        }

        string triggerPart = string.IsNullOrWhiteSpace(_appliedTriggerFilter) ? "Any trigger" : "Trigger: " + _appliedTriggerFilter;
        string outcomePart = HasOutcomeFilter ? "Failed after retries" : "Any outcome";
        string resultPart = _appliedResults.Count == 0
            ? "Any result"
            : "Results: " + string.Join(", ", _appliedResults.Select(RunResultDisplay.Label));
        return jobPart + " · " + triggerPart + " · Node: " + NodeScopeLabel() + " · " + outcomePart + " · " + resultPart
               + " · Window: " + _appliedWindow.Scope;
    }

    /// <summary>
    /// Whether the row is an occurrence's last word: it failed, and the trigger did not answer with
    /// another attempt.
    /// </summary>
    private static bool FailedFinally(DashboardHistoryEntry entry) => !entry.Succeeded && !entry.RetryScheduled;

    /// <summary>
    /// Fires the row's job again, by hand, with the input the run had when the history recorded it.
    /// </summary>
    /// <remarks>
    /// <see cref="IQuartzApiClient.TriggerJob" />, which is the same mutation the jobs listing's
    /// <em>Trigger now</em> is — so it is recorded in the action log under the same name, or under Job
    /// Detail's <c>TriggerJobWithData</c> when it carries the input, and refused in the same place when
    /// the dashboard is read-only. The input is read on demand, from the row's own entry, because a
    /// listing leaves it out; a row without one fires the job with no map, as before, because inventing
    /// one would fire the job with data it was never given. The toast says which it was.
    /// </remarks>
    private async Task RunAgainAsync(DashboardHistoryEntry entry)
    {
        string? schedulerName = Scheduler.ActiveSchedulerName;
        if (IsReadOnly || string.IsNullOrWhiteSpace(schedulerName))
        {
            return;
        }

        string target = DisplayValueHelper.FormatKey(entry.JobGroup, entry.JobName);
        JobKeyDto job = new(entry.JobGroup, entry.JobName);
        string action = "TriggerJob";

        try
        {
            DashboardHistoryEntry recorded = await RunAgainInput.Read(Api, schedulerName, entry);
            JobDataMap? input = RunAgainInput.DataFor(recorded);
            action = input is null ? "TriggerJob" : "TriggerJobWithData";

            await Api.TriggerJob(schedulerName, job, input);
            ActionLog.Record(schedulerName, action, target, succeeded: true);
            Toasts.Success("Triggered job " + target + " " + RunAgainInput.Describe(recorded) + ".");
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            // The listing does not ask whether each row's job is still stored, so the reason is found
            // here, once the trigger has failed: a job that was not durable is gone with its last trigger.
            bool jobGone = await RunAgainInput.FailedForAJobGone(Api, schedulerName, job, ex);
            string message = jobGone ? RunAgainInput.JobGone(target) : ex.Message;
            _error = message;
            ActionLog.Record(schedulerName, action, target, succeeded: false, ex.Message);
            Toasts.Error(message);
        }
    }

    /// <summary>
    /// What the listing is narrowed to by node, in the words the stat cards and the summary both use.
    /// </summary>
    private string NodeScopeLabel() => HasNodeFilter ? _appliedNodeFilter : "all nodes";

    /// <summary>
    /// A stat card's title, carrying the scope the figure covers.
    /// </summary>
    /// <remarks>
    /// The figures are over the rows on the page — never over the whole history — and now over one node
    /// as well when the filter names one, so the title has to say which.
    /// </remarks>
    private string ScopedStatTitle(string measure)
    {
        return HasNodeFilter
            ? measure + " (page, " + _appliedNodeFilter + ")"
            : measure + " (page)";
    }

    /// <summary>
    /// A stat card's title over the window, carrying the window and the node when the filter names one.
    /// </summary>
    private string WindowStatTitle(string measure)
    {
        return HasNodeFilter
            ? measure + " (" + _appliedWindow.Scope + ", " + _appliedNodeFilter + ")"
            : measure + " (" + _appliedWindow.Scope + ")";
    }

    private static long WindowRunCount(RunStatisticsView view) => view.Statistics.Buckets.Sum(static bucket => bucket.RunCount);

    private static string WindowFailed(RunStatisticsView view)
    {
        return view.Statistics.Buckets.Sum(static bucket => bucket.FailedCount).ToString("N0", CultureInfo.InvariantCulture);
    }

    /// <summary>The share of runs that succeeded or found nothing to do, as the page's own rate counts them.</summary>
    private static string WindowSuccessRate(RunStatisticsView view)
    {
        long runs = WindowRunCount(view);
        if (runs == 0)
        {
            return "n/a";
        }

        long succeeded = view.Statistics.Buckets.Sum(static bucket => bucket.SucceededCount + bucket.SkippedCount);
        return ((double) succeeded / runs).ToString("P1", CultureInfo.InvariantCulture);
    }

    private static string WindowLongestRun(RunStatisticsView view)
    {
        return view.Statistics.Buckets.Count == 0
            ? "n/a"
            : DisplayValueHelper.FormatDuration(view.Statistics.Buckets.Max(static bucket => bucket.MaxDuration));
    }

    /// <summary>
    /// The nodes the filter offers: the cluster's, plus any the loaded rows name that it did not list —
    /// a node that has stopped checking in still has history worth reading.
    /// </summary>
    private List<string> NodeOptions()
    {
        List<string> options = [];
        HashSet<string> seen = new(StringComparer.OrdinalIgnoreCase);

        foreach (string node in _clusterNodes)
        {
            if (!string.IsNullOrWhiteSpace(node) && seen.Add(node))
            {
                options.Add(node);
            }
        }

        foreach (DashboardHistoryEntry entry in _entries)
        {
            if (!string.IsNullOrWhiteSpace(entry.SchedulerInstanceId) && seen.Add(entry.SchedulerInstanceId))
            {
                options.Add(entry.SchedulerInstanceId);
            }
        }

        if (HasNodeFilter && seen.Add(_appliedNodeFilter))
        {
            options.Add(_appliedNodeFilter);
        }

        options.Sort(StringComparer.OrdinalIgnoreCase);
        return options;
    }

    /// <summary>
    /// The node a row came from, or a dash where a store recorded none.
    /// </summary>
    private static string NodeLabel(string? schedulerInstanceId)
    {
        return string.IsNullOrWhiteSpace(schedulerInstanceId) ? "—" : schedulerInstanceId;
    }

    /// <summary>
    /// Shows a duration in the largest unit that keeps it readable: sub-second runs in milliseconds,
    /// anything longer with its unit spelled out.
    /// </summary>
    private static string FormatDurationValue(TimeSpan duration) => DisplayValueHelper.FormatDuration(duration);

    private string ExecutionPath(string entryId)
    {
        return DashboardLink.To(Options.Value, "history/" + Uri.EscapeDataString(entryId));
    }

    private string FormatFiredAt(DateTimeOffset? firedAtUtc)
    {
        return Scheduler.FormatInSelectedTimeZone(firedAtUtc, "u");
    }

    /// <summary>
    /// A key as the listing shows it: the name, which is what tells one row from the next, over its group,
    /// each cut with an ellipsis, the whole key in the title, and a copy button the size of an icon.
    /// </summary>
    /// <remarks>
    /// Not <see cref="KeyBadge" />, which reads <c>group.name</c> from the left: in a column this narrow that
    /// left every row showing the same group and none of its name.
    /// </remarks>
    private RenderFragment KeyCell(string group, string name)
    {
        string key = DisplayValueHelper.FormatKey(group, name);
        bool copied = string.Equals(_copiedKey, key, StringComparison.Ordinal);

        return @<span class="qz-history-key" title="@key">
            <span class="qz-history-key-text">
                <span class="qz-history-key-name">@name</span>
                <span class="qz-history-key-group">@group</span>
            </span>
            <button type="button"
                    class="qz-history-key-copy"
                    aria-label="@(copied ? "Copied " + key : "Copy " + key)"
                    title="@(copied ? "Copied" : "Copy " + key)"
                    @onclick="() => CopyKeyAsync(key)"
                    @onclick:stopPropagation="true"
                    @onclick:preventDefault="true">
                @if (copied)
                {
                    <span aria-hidden="true">&#10003;</span>
                }
                else
                {
                    <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true">
                        <rect x="5.5" y="5.5" width="8" height="8" rx="1.5" />
                        <path d="M10.5 3.5v-1a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h1" />
                    </svg>
                }
            </button>
        </span>;
    }

    /// <summary>
    /// Copies a key to the clipboard through the same script the key badges use, and marks it copied.
    /// </summary>
    private async Task CopyKeyAsync(string key)
    {
        try
        {
            _copiedKey = await JsRuntime.InvokeAsync<bool>("quartzDashboardClipboard.copyText", new object?[] { key }) ? key : null;
        }
        catch (System.Text.Json.JsonException)
        {
            _copiedKey = null;
        }
        catch (Microsoft.JSInterop.JSException)
        {
            _copiedKey = null;
        }
        catch (InvalidOperationException)
        {
            _copiedKey = null;
        }
    }

    /// <summary>The date half of <see cref="FormatFiredAt" />, which the listing puts on a line of its own.</summary>
    private string FiredDate(DateTimeOffset firedAtUtc)
    {
        string formatted = FormatFiredAt(firedAtUtc);
        int space = formatted.IndexOf(' ', StringComparison.Ordinal);
        return space < 0 ? formatted : formatted[..space];
    }

    /// <summary>The time and offset half of <see cref="FormatFiredAt" />.</summary>
    private string FiredTime(DateTimeOffset firedAtUtc)
    {
        string formatted = FormatFiredAt(firedAtUtc);
        int space = formatted.IndexOf(' ', StringComparison.Ordinal);
        return space < 0 ? string.Empty : formatted[(space + 1)..];
    }

    private string GetSuccessRateText()
    {
        int total = _pageSuccessCount + _pageFailureCount;
        if (total == 0)
        {
            return "n/a";
        }

        double ratio = (double) _pageSuccessCount / total;
        return ratio.ToString("P1", System.Globalization.CultureInfo.InvariantCulture);
    }

    private void ComputeAnalytics()
    {
        List<TimeSpan> durations = [];
        _pageSuccessCount = 0;
        _pageFailureCount = 0;
        _pageAverageDuration = TimeSpan.Zero;
        _pageP95Duration = TimeSpan.Zero;

        foreach (DashboardHistoryEntry entry in _entries)
        {
            if (entry.Succeeded)
            {
                _pageSuccessCount++;
            }
            else
            {
                _pageFailureCount++;
            }

            if (entry.Duration > TimeSpan.Zero)
            {
                durations.Add(entry.Duration);
            }
        }

        if (durations.Count == 0)
        {
            return;
        }

        durations.Sort();
        _pageAverageDuration = TimeSpan.FromTicks((long) Math.Round(durations.Average(x => (double) x.Ticks)));
        int p95Index = (int) Math.Ceiling(durations.Count * 0.95) - 1;
        p95Index = Math.Clamp(p95Index, 0, durations.Count - 1);
        _pageP95Duration = durations[p95Index];
    }

    public void Dispose()
    {
        Scheduler.OnSchedulerChanged -= OnSchedulerChanged;
        _refreshLoopCancellation?.Cancel();
        _refreshLoopCancellation?.Dispose();
        _refreshTimer?.Dispose();
    }
}
