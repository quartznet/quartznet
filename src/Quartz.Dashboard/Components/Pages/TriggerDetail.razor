@page "/quartz/triggers/{Group}/{Name}"
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Options
@using Quartz
@using Quartz.Dashboard.Components.Shared
@using Quartz.Dashboard.Services
@using Routes = Quartz.HttpApiContract.SchedulerRoutes
@using WireRoute = Quartz.HttpApiContract.WireRoute
@implements IDisposable
@inject IQuartzApiClient Api
@inject SchedulerState Scheduler
@inject SchedulerAuthorization Authorization
@inject IOptions<QuartzDashboardOptions> Options
@inject NavigationManager Navigation
@inject ToastService Toasts
@inject DashboardActionLog ActionLog
@inject IServiceProvider Services

<div class="qz-page">
    <div class="qz-page-header">
        <h1>Trigger Detail</h1>
        @* Not while the details editor is open: a read hands it a new trigger, which starts its form again. *@
        <LastUpdated At="@_lastUpdatedAt" StaleReason="@_staleReason" OnRefresh="RefreshAsync" RefreshDisabled="@(_refreshing || _editing)" />
    </div>
    <OriginBackLink />

    @if (_isLoading)
    {
        <LoadingSpinner />
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <ErrorAlert Message="@_error" OnRetry="LoadDataAsync" />
    }
    else if (_trigger is null)
    {
        <p class="qz-muted">Trigger not found.</p>
    }
    else
    {
        <div class="qz-row">
            <KeyBadge GroupName="@Group" ItemName="@Name" />
            <StateIndicator State="@_triggerState.ToString()" />
            <PauseNote Pause="@_pause" />
            <a class="qz-details-link" href="@GetHistoryPathForTrigger(Group, Name)">View execution history</a>
        </div>

        @if (CanPause || CanResume || CanReset || CanEdit || CanBackfill || CanUnschedule)
        {
            <div class="qz-actions">
                @if (CanPause)
                {
                    <button type="button" class="qz-button" @onclick="PromptPause">Pause</button>
                }
                @if (CanResume)
                {
                    <button type="button" class="qz-button" @onclick="ResumeAsync">Resume</button>
                }
                @if (CanReset)
                {
                    <button type="button" class="qz-button" @onclick="ResetFromErrorAsync">Reset error state</button>
                }
                @if (CanEdit)
                {
                    <button type="button"
                            class="qz-button qz-trigger-edit"
                            disabled="@(_editing || _editUnavailable is not null)"
                            title="@_editUnavailable"
                            @onclick="StartEditing">Edit details</button>
                }
                @if (CanBackfill)
                {
                    <button type="button"
                            class="qz-button qz-trigger-backfill"
                            disabled="@(_backfillUnavailable is not null)"
                            title="@_backfillUnavailable"
                            @onclick="PromptBackfill">Backfill…</button>
                }
                @if (CanUnschedule)
                {
                    <button type="button" class="qz-button qz-button-danger" @onclick="PromptUnschedule">Unschedule</button>
                }
            </div>

            @if (CanEdit && _editUnavailable is { } editUnavailable)
            {
                @* Said where the button is rather than in a toast that fades: the data source cannot edit
                   a trigger in place, which stays true for as long as the page is open. *@
                <p class="qz-muted" data-testid="trigger-editor-unavailable">@editUnavailable</p>
            }

            @if (CanBackfill && _backfillUnavailable is { } backfillUnavailable)
            {
                <p class="qz-muted" data-testid="trigger-backfill-unavailable">@backfillUnavailable</p>
            }
        }

        @if (_editing && CanEdit)
        {
            <TriggerDetailsEditor Trigger="@_trigger"
                                  OnSaved="OnDetailsSavedAsync"
                                  OnUnavailable="OnEditingUnavailable"
                                  OnCancel="CancelEditing" />
        }

        <table class="qz-table">
            <tbody>
                <tr><th>Type</th><td>@TriggerDisplay.TypeName(_trigger)</td></tr>
                <tr><th>Execution Group</th><td>@(_trigger.ExecutionGroup is { Length: > 0 } executionGroup ? executionGroup : "\u2014")</td></tr>
                <tr><th>Description</th><td>@_trigger.Description</td></tr>
                <tr><th>Priority</th><td>@_trigger.Priority</td></tr>
                <tr><th>Calendar</th><td>@(_trigger.CalendarName is { Length: > 0 } calendarName ? calendarName : "\u2014")</td></tr>
                <tr><th>Preferred Node</th><td>@DisplayPreferredNode(_trigger.PreferredNode)</td></tr>
                <tr><th>Misfire Instruction</th><td>@_misfireName</td></tr>
                <tr><th>Misfire Threshold</th><td>@TriggerDetailsForm.MisfireThresholdOf(_trigger)</td></tr>
                <tr>
                    <th>Schedule</th>
                    <td data-testid="trigger-schedule">
                        <span class="qz-schedule-description">@BuildScheduleDescription()</span>
                        @if (ScheduleExpressionBeside() is { } scheduleExpression)
                        {
                            <span class="qz-table-cell-mono qz-muted qz-schedule-expression">@scheduleExpression</span>
                        }
                    </td>
                </tr>
                <tr><th>Next Fire</th><td>@FormatDate(_trigger.NextFireTimeUtc)</td></tr>
                <tr><th>Previous Fire</th><td>@FormatDate(_trigger.PreviousFireTimeUtc)</td></tr>
                <tr><th>Retry Policy</th><td>@(_trigger.RetryPolicy is { } retryPolicy ? retryPolicy.ToStoredString() : "—")</td></tr>
                <tr><th>Retry Attempt</th><td>@_trigger.RetryAttempt</td></tr>
                <tr><th>Overlap Policy</th><td>@_trigger.OverlapPolicy</td></tr>
                @if (_trigger is ISimpleTrigger { MeasureIntervalFromCompletion: true })
                {
                    <tr><th>Interval</th><td>Measured from completion</td></tr>
                }
                @if (_trigger.Continuation.Parent is { } continuationParent)
                {
                    <tr>
                        <th>Continues after</th>
                        <td>
                            @if (_continuationParentExists)
                            {
                                <a class="qz-details-link" href="@GetTriggerPath(continuationParent.Group, continuationParent.Name)">@DisplayValueHelper.FormatKey(continuationParent.Group, continuationParent.Name)</a>
                            }
                            else
                            {
                                @DisplayValueHelper.FormatKey(continuationParent.Group, continuationParent.Name)
                                <span class="qz-muted">&mdash; no longer scheduled</span>
                            }
                        </td>
                    </tr>
                    <tr><th>When</th><td>@DisplayValueHelper.FormatContinuationCondition(_trigger.Continuation.When)</td></tr>
                }
            </tbody>
        </table>

        @* Every trigger type's, computed by its scheduler and read through the client, so a scheduler reached
           over HTTP or through an agent shows the same panel. *@
        <h2>Upcoming fires</h2>
        <UpcomingFires TriggerKey="@TriggerKey" Trigger="@_trigger" Count="10" />

        <h2>JobDataMap</h2>
        <JobDataMapEditor DataMap="@TriggerDataMap" ReadOnly="true" />

        @if (CanReschedule && !string.IsNullOrWhiteSpace(_cronExpression))
        {
            <section class="qz-section">
                <h2>Edit cron schedule</h2>
                <div class="qz-form-group">
                    <label class="qz-form-label" for="trigger-cron-expression">Cron expression</label>
                    <input id="trigger-cron-expression" class="qz-input qz-input-mono" @bind="_editedCronExpression" />
                </div>
                <div class="qz-actions qz-group-actions">
                    <button type="button" class="qz-button qz-button-primary" @onclick="RescheduleCronAsync">Save schedule</button>
                    <button type="button" class="qz-button" @onclick="ResetCronEditAsync">Reset</button>
                </div>
            </section>
        }

        @* The editor's expression, once it is not the saved one: the saved schedule is Upcoming fires above, and
           read-only mode has no editor to preview. *@
        @if (CanReschedule && !string.IsNullOrWhiteSpace(_cronExpression) && IsPreviewingAnEdit)
        {
            <h2>Upcoming cron fires</h2>
            <p class="qz-muted" data-testid="cron-preview-unsaved">Of the edited expression, which is not saved yet.</p>
            <CronNextFires Trigger="@_trigger" Expression="@_editedCronExpression" Count="5" />
        }
    }
</div>

<ConfirmDialog IsOpen="@_showUnscheduleConfirm"
               Title="Unschedule trigger"
               Message="@($"Unschedule {DisplayValueHelper.FormatKey(Group, Name)}?")"
               OnConfirm="UnscheduleAsync"
               OnCancel="CancelUnscheduleAsync" />

<PauseDialog IsOpen="@_showPausePrompt"
             Title="Pause trigger"
             Message="@($"Pause {DisplayValueHelper.FormatKey(Group, Name)}?")"
             OnConfirm="PauseAsync"
             OnCancel="CancelPauseAsync" />

@if (_trigger is not null && CanBackfill)
{
    <BackfillDialog Trigger="@_trigger"
                    IsOpen="@_showBackfill"
                    OnBackfilled="OnBackfilledAsync"
                    OnUnavailable="OnBackfillUnavailable"
                    OnCancel="CancelBackfill" />
}

@code {
    private bool _isLoading = true;
    private string? _error;
    private ITrigger? _trigger;
    private TriggerState _triggerState = TriggerState.None;
    private PauseInfo? _pause;
    private bool _showPausePrompt;
    private bool _continuationParentExists;
    private bool _showUnscheduleConfirm;
    private string? _cronExpression;
    private string _editedCronExpression = string.Empty;
    private string _misfireName = string.Empty;
    private bool _editing;

    /// <summary>
    /// Why this page's data source cannot edit a trigger in place, once it has said so, or
    /// <see langword="null" /> while nothing has.
    /// </summary>
    /// <remarks>
    /// Learned from the source rather than guessed at: an <see cref="IQuartzApiClient" /> of an
    /// application's own that predates the member answers <see cref="NotSupportedException" />, and the
    /// editor is disabled with that reason from then on instead of failing the same way on every save.
    /// </remarks>
    private string? _editUnavailable;

    private bool _showBackfill;

    /// <summary>
    /// Why this page's data source cannot backfill a trigger, once it has said so, or
    /// <see langword="null" /> while nothing has — learned the way <see cref="_editUnavailable" /> is.
    /// </summary>
    private string? _backfillUnavailable;

    /// <summary>
    /// Cancelled when the reader leaves the page, which stops the read in flight: its answer would be thrown away.
    /// </summary>
    private readonly CancellationTokenSource _cancellation = new();

    /// <summary>
    /// When the trigger on screen was read, or <see langword="null" /> while the page holds nothing read.
    /// </summary>
    private DateTimeOffset? _lastUpdatedAt;

    /// <summary>
    /// Why the last read failed while there was a trigger to keep, or <see langword="null" />.
    /// </summary>
    private string? _staleReason;

    /// <summary>Whether the read the Refresh button asked for is out.</summary>
    private bool _refreshing;

    /// <summary>The clock the page says it read the trigger at.</summary>
    private TimeProvider Clock => Services.GetService<TimeProvider>() ?? TimeProvider.System;

    [Parameter]
    public string Group { get; set; } = string.Empty;

    [Parameter]
    public string Name { get; set; } = string.Empty;

    private bool IsReadOnly => Options.Value.ReadOnly;

    /// <summary>
    /// Whether the visitor may call <paramref name="route" /> on the active scheduler: never while the
    /// dashboard is read-only, and only at their role's level under an operation policy.
    /// </summary>
    private bool Can(WireRoute route) => Authorization.Allows(Scheduler.ActiveSchedulerName, route);

    private bool CanPause => Can(Routes.PauseTrigger);

    private bool CanResume => Can(Routes.ResumeTrigger);

    private bool CanReset => Can(Routes.ResetTriggerFromErrorState);

    private bool CanEdit => Can(Routes.UpdateTriggerDetails);

    private bool CanBackfill => Can(Routes.BackfillTrigger);

    private bool CanUnschedule => Can(Routes.UnscheduleJob);

    private bool CanReschedule => Can(Routes.RescheduleJob);

    private TriggerKeyDto TriggerKey => new(Group, Name);

    private JobDataMap? TriggerDataMap => _trigger?.JobDataMap;

    /// <summary>
    /// Whether the editor holds an expression the trigger is not running with, which is the only time the
    /// page previews one: until then the preview would repeat <em>Upcoming fires</em>.
    /// </summary>
    private bool IsPreviewingAnEdit => !string.Equals(_editedCronExpression.Trim(), _cronExpression, StringComparison.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        Scheduler.OnSchedulerChanged += OnSchedulerChanged;
        Scheduler.OnDisplayChanged += OnDisplayChanged;
        await LoadDataAsync();
    }

    /// <summary>The time zone changed: draw the page's times again in it, and read nothing.</summary>
    private void OnDisplayChanged(object? sender, EventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    protected override async Task OnParametersSetAsync()
    {
        // Another trigger's details are not ones to keep as stale.
        _lastUpdatedAt = null;
        _staleReason = null;
        await LoadDataAsync();
    }

    private async void OnSchedulerChanged(object? sender, EventArgs e)
    {
        // What one scheduler's source could not do says nothing about the next one's.
        _editUnavailable = null;
        _editing = false;
        _backfillUnavailable = null;
        _showBackfill = false;
        _lastUpdatedAt = null;
        _staleReason = null;
        await LoadDataAsync();
        await InvokeAsync(StateHasChanged);
    }

    /// <remarks>
    /// What is on screen is replaced when the new read arrives, so a refresh that fails keeps it, marked stale
    /// beside the time it was read. Only a page with nothing read to show has the error in its place.
    /// </remarks>
    private async Task LoadDataAsync()
    {
        // A refresh keeps the trigger on screen until the new read arrives; the spinner is for a page with
        // nothing read to show.
        _isLoading = !_refreshing || _lastUpdatedAt is null;
        _error = null;

        try
        {
            string? schedulerName = Scheduler.ActiveSchedulerName;
            if (string.IsNullOrWhiteSpace(schedulerName))
            {
                _trigger = null;
                _triggerState = TriggerState.None;
                _pause = null;
                _lastUpdatedAt = null;
                _staleReason = null;
                return;
            }

            CancellationToken cancellationToken = _cancellation.Token;
            await Authorization.LoadOperations(schedulerName, cancellationToken);

            ITrigger trigger = await Api.GetTrigger(schedulerName, TriggerKey, cancellationToken);
            TriggerState triggerState = await Api.GetTriggerState(schedulerName, TriggerKey, cancellationToken);

            // Only a paused trigger has a pause to explain, so nothing else asks.
            PauseInfo? pause = triggerState == TriggerState.Paused ? await Api.GetTriggerPause(schedulerName, TriggerKey, cancellationToken) : null;

            // A continuation keeps naming its parent after the parent is gone - a deleted parent parks
            // the trigger in Error rather than erasing what it waited for - so the row links to a page
            // only when there is one. TriggerState.None is what a key that resolves to nothing answers.
            bool continuationParentExists = trigger.Continuation.Parent is { } continuationParent
                && await Api.GetTriggerState(schedulerName, new TriggerKeyDto(continuationParent.Group, continuationParent.Name), cancellationToken) != TriggerState.None;

            // A refresh keeps an expression the reader is editing; every other read starts the editor again from
            // the trigger's own.
            bool keepEdit = _refreshing && IsPreviewingAnEdit;
            _trigger = trigger;
            _triggerState = triggerState;
            _pause = pause;
            _cronExpression = (trigger as ICronTrigger)?.CronExpressionString;
            if (!keepEdit)
            {
                _editedCronExpression = _cronExpression ?? string.Empty;
            }

            _misfireName = TriggerDetailsForm.MisfireNameOf(trigger);
            _continuationParentExists = continuationParentExists;
            _lastUpdatedAt = Clock.GetUtcNow();
            _staleReason = null;
        }
        catch (OperationCanceledException) when (_cancellation.IsCancellationRequested)
        {
            // The reader left. A read nobody is waiting for is not a failure.
        }
        catch (Exception ex) when (_lastUpdatedAt is not null)
        {
            _staleReason = ex.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// The Refresh button: the trigger read again, kept on screen until the new read arrives, and the header's
    /// status read with it. The page reads nothing on its own after it has loaded.
    /// </summary>
    private async Task RefreshAsync()
    {
        if (_refreshing || _editing)
        {
            return;
        }

        _refreshing = true;
        try
        {
            await LoadDataAsync();
        }
        finally
        {
            _refreshing = false;
        }

        if (!_cancellation.IsCancellationRequested)
        {
            Scheduler.NotifyRefreshed();
        }
    }

    private string BuildScheduleDescription()
    {
        if (_trigger is null)
        {
            return string.Empty;
        }

        return _trigger.DescribeSchedule() ?? TriggerDisplay.TypeName(_trigger);
    }

    /// <summary>
    /// The expression the schedule is written in, to show beside its description, or <see langword="null" />
    /// when it has none or the description already is the expression: a shape with no sentence of its own.
    /// </summary>
    private string? ScheduleExpressionBeside()
    {
        if (_trigger is null || Quartz.Impl.Triggers.ScheduleDescriber.Expression(_trigger) is not { Length: > 0 } expression)
        {
            return null;
        }

        string? description = _trigger.DescribeSchedule();
        return description is not null && description.StartsWith(expression.Trim(), StringComparison.Ordinal) ? null : expression;
    }

    private string FormatDate(DateTimeOffset? value)
    {
        return Scheduler.FormatInSelectedTimeZone(value, "u");
    }

    private string GetTriggerPath(string group, string name)
    {
        return DashboardLink.To(Options.Value, "triggers/" + Uri.EscapeDataString(group) + "/" + Uri.EscapeDataString(name));
    }

    /// <summary>
    /// The History page narrowed to this trigger exactly: a text filter would also list <c>nightly-2</c> for
    /// <c>nightly</c>.
    /// </summary>
    private string GetHistoryPathForTrigger(string group, string name)
    {
        return DashboardLink.HistoryOfTrigger(Options.Value, group, name);
    }

    private void PromptPause()
    {
        _showPausePrompt = true;
    }

    private Task CancelPauseAsync()
    {
        _showPausePrompt = false;
        return Task.CompletedTask;
    }

    private Task PauseAsync(string? reason)
    {
        _showPausePrompt = false;
        PauseDetails details = ActionLog.PauseDetailsFor(reason);
        return ExecuteMutatingActionAsync(
            () => Api.PauseTriggerWith(Scheduler.ActiveSchedulerName!, TriggerKey, details),
            "Paused trigger " + DisplayValueHelper.FormatKey(Group, Name) + ".",
            "Trigger " + DisplayValueHelper.FormatKey(Group, Name) + " was not paused - it no longer exists or cannot be paused.",
            actionName: "PauseTrigger",
            target: DisplayValueHelper.FormatKey(Group, Name),
            note: DashboardActionLog.PauseNote(details));
    }

    private Task ResumeAsync()
    {
        return ExecuteMutatingActionAsync(
            () => Api.ResumeTrigger(Scheduler.ActiveSchedulerName!, TriggerKey),
            "Resumed trigger " + DisplayValueHelper.FormatKey(Group, Name) + ".",
            "Trigger " + DisplayValueHelper.FormatKey(Group, Name) + " was not resumed - it no longer exists or was not paused.",
            actionName: "ResumeTrigger",
            target: DisplayValueHelper.FormatKey(Group, Name));
    }

    private Task ResetFromErrorAsync()
    {
        return ExecuteMutatingActionAsync(
            () => Api.ResetTriggerFromErrorState(Scheduler.ActiveSchedulerName!, TriggerKey),
            "Reset error state for trigger " + DisplayValueHelper.FormatKey(Group, Name) + ".",
            "Trigger " + DisplayValueHelper.FormatKey(Group, Name) + " was not reset - it no longer exists or is not in the error state.",
            actionName: "ResetTriggerFromErrorState",
            target: DisplayValueHelper.FormatKey(Group, Name));
    }

    private async Task RescheduleCronAsync()
    {
        string? schedulerName = Scheduler.ActiveSchedulerName;
        if (!CanReschedule || string.IsNullOrWhiteSpace(schedulerName))
        {
            return;
        }

        string cronExpression = _editedCronExpression.Trim();
        if (string.IsNullOrWhiteSpace(cronExpression))
        {
            Toasts.Error("Cron expression is required.");
            return;
        }

        ITrigger? newTrigger;
        try
        {
            if (_trigger is null || !TriggerPayloadBuilder.TryWithCronExpression(_trigger, cronExpression, out newTrigger))
            {
                Toasts.Error("This trigger cannot be rescheduled from the dashboard.");
                return;
            }
        }
        catch (FormatException ex)
        {
            // Said the way the preview says it. Thrown out of a click handler, it would end the circuit.
            Toasts.Error("Invalid cron expression: " + ex.Message);
            return;
        }

        RescheduleRequest request = new(newTrigger);
        _ = await ExecuteMutatingActionAsync(
            () => Api.RescheduleJob(schedulerName, TriggerKey, request),
            "Rescheduled trigger " + DisplayValueHelper.FormatKey(Group, Name) + ".",
            actionName: "RescheduleTrigger",
            target: DisplayValueHelper.FormatKey(Group, Name));
    }

    private Task ResetCronEditAsync()
    {
        _editedCronExpression = _cronExpression ?? string.Empty;
        return Task.CompletedTask;
    }

    private static string DisplayPreferredNode(PreferredNode preferredNode)
    {
        if (preferredNode.IsNone)
        {
            return "—";
        }

        if (preferredNode.IsAutomatic)
        {
            return preferredNode.Node is { } claimedBy ? "auto (claimed by " + claimedBy + ")" : "auto";
        }

        return preferredNode.Node ?? "—";
    }

    private void StartEditing()
    {
        if (!CanEdit || _trigger is null)
        {
            return;
        }

        _editing = true;
    }

    private void CancelEditing()
    {
        _editing = false;
    }

    private async Task OnDetailsSavedAsync()
    {
        _editing = false;
        await LoadDataAsync();
    }

    private void OnEditingUnavailable(string reason)
    {
        _editUnavailable = reason;
        _editing = false;
    }

    /// <remarks>
    /// The button is only rendered outside read-only mode for a trigger the page has read, and the dialog
    /// and the client each refuse a read-only backfill again, so there is nothing to check here.
    /// </remarks>
    private void PromptBackfill()
    {
        _showBackfill = true;
    }

    private void CancelBackfill()
    {
        _showBackfill = false;
    }

    private async Task OnBackfilledAsync()
    {
        _showBackfill = false;
        await LoadDataAsync();
    }

    private void OnBackfillUnavailable(string reason)
    {
        _backfillUnavailable = reason;
        _showBackfill = false;
    }

    private void PromptUnschedule()
    {
        _showUnscheduleConfirm = true;
    }

    private async Task UnscheduleAsync()
    {
        // Closed before the call rather than after it, as the Timeline's dialogs are, so a second click on
        // Confirm sends nothing: one that reaches the page before the dialog is drawn closed finds it shut.
        if (!_showUnscheduleConfirm)
        {
            return;
        }

        _showUnscheduleConfirm = false;
        bool unscheduled = await ExecuteMutatingActionAsync(
            () => Api.UnscheduleJob(Scheduler.ActiveSchedulerName!, TriggerKey),
            "Unscheduled trigger " + DisplayValueHelper.FormatKey(Group, Name) + ".",
            "Trigger " + DisplayValueHelper.FormatKey(Group, Name) + " was not unscheduled - it no longer exists.",
            actionName: "UnscheduleTrigger",
            target: DisplayValueHelper.FormatKey(Group, Name));
        if (unscheduled)
        {
            Navigation.NavigateTo(DashboardLink.To(Options.Value, "triggers"));
        }
    }

    private Task CancelUnscheduleAsync()
    {
        _showUnscheduleConfirm = false;
        return Task.CompletedTask;
    }

    private async Task<bool> ExecuteMutatingActionAsync(
        Func<ValueTask> operation,
        string successMessage,
        string actionName,
        string target)
    {
        string? schedulerName = Scheduler.ActiveSchedulerName;
        if (IsReadOnly || string.IsNullOrWhiteSpace(schedulerName))
        {
            return false;
        }

        try
        {
            await operation();
            ActionLog.Record(schedulerName, actionName, target, succeeded: true);
            Toasts.Success(successMessage);
            await LoadDataAsync();
            return true;
        }
        catch (Exception ex)
        {
            ActionLog.Failed(schedulerName, actionName, target, ex);
            Toasts.Error(ex.Message);
            return false;
        }
    }

    private async Task<bool> ExecuteMutatingActionAsync(
        Func<ValueTask<bool>> operation,
        string successMessage,
        string noOpMessage,
        string actionName,
        string target,
        string? note = null)
    {
        string? schedulerName = Scheduler.ActiveSchedulerName;
        if (IsReadOnly || string.IsNullOrWhiteSpace(schedulerName))
        {
            return false;
        }

        try
        {
            bool applied = await operation();
            ActionLog.Record(schedulerName, actionName, target, succeeded: applied, note);
            if (applied)
            {
                Toasts.Success(successMessage);
            }
            else
            {
                Toasts.Info(noOpMessage);
            }
            await LoadDataAsync();
            return applied;
        }
        catch (Exception ex)
        {
            ActionLog.Failed(schedulerName, actionName, target, ex, note);
            Toasts.Error(ex.Message);
            return false;
        }
    }

    public void Dispose()
    {
        Scheduler.OnSchedulerChanged -= OnSchedulerChanged;
        Scheduler.OnDisplayChanged -= OnDisplayChanged;
        _cancellation.Cancel();
        _cancellation.Dispose();
    }
}
