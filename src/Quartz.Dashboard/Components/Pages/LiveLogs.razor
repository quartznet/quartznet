@page "/quartz/live"
@using System.Globalization
@using Quartz
@using Quartz.Dashboard.Components.Shared
@using Quartz.Dashboard.Services
@using Quartz.Extensibility
@using Quartz.HttpApiContract
@implements IAsyncDisposable
@inject SchedulerState Scheduler
@inject IQuartzApiClient Api
@inject IServiceProvider Services

<div class="qz-page">
    <h1>Live Logs</h1>

    <div class="qz-toolbar">
        @if (_streaming)
        {
            <span class="qz-badge qz-badge-success">● Streaming</span>
        }
        else
        {
            <span class="qz-badge qz-badge-error">● Not streaming</span>
        }

        @if (!string.IsNullOrWhiteSpace(_watchedScheduler))
        {
            @* The scheduler names the stream; the node names the process this page is rendered by. In a
               cluster that stream is fed by every node running the scheduler, so a reader has to be able
               to tell an event from here apart from an event from a peer. *@
            <span class="qz-muted">Listening to: @_watchedScheduler@(string.IsNullOrWhiteSpace(_thisNode) ? "" : " · this node is " + _thisNode)</span>
        }
    </div>

    <div class="qz-live-filters">
        <span class="qz-muted">Event types:</span>
        <div class="qz-actions">
            <button type="button" class="qz-button" @onclick="SelectAllEventTypes">All</button>
            <button type="button" class="qz-button" @onclick="ClearEventTypes">None</button>
        </div>
        <div class="qz-live-filter-grid">
            @foreach (string eventType in EventTypes)
            {
                string id = "qz-live-filter-" + eventType;
                <label class="qz-live-filter-item" for="@id">
                    <input id="@id"
                           type="checkbox"
                           checked="@_selectedEventTypes.Contains(eventType)"
                           @onchange="args => ToggleEventType(eventType, args)" />
                    <span>@eventType</span>
                </label>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <ErrorAlert Message="@_error" OnRetry="RestartAsync" />
    }

    @if (_events.Count == 0)
    {
        <p class="qz-muted">No events yet. Events will appear when jobs execute, triggers fire, or scheduler state changes.</p>
    }
    else if (_filteredEvents.Count == 0)
    {
        <p class="qz-muted">No events match the selected event types.</p>
    }
    else
    {
        <ul class="qz-live-events">
            @foreach (LiveEventItem liveEvent in _filteredEvents)
            {
                <li class="qz-live-event qz-live-@liveEvent.Category">
                    <span class="qz-live-time"><TimeAgo Timestamp="@liveEvent.Timestamp" /></span>
                    <span class="qz-live-type">@liveEvent.EventType</span>
                    <span class="qz-live-node" title="Node">@(string.IsNullOrWhiteSpace(liveEvent.SchedulerInstanceId) ? "—" : liveEvent.SchedulerInstanceId)</span>
                    <span class="qz-live-description">@liveEvent.Description</span>
                </li>
            }
        </ul>
    }
</div>

@code {
    /// <summary>
    /// The event kinds a reader can narrow to, which is every kind a scheduler raises.
    /// </summary>
    /// <remarks>
    /// Read off the enum rather than written out, so a kind added to the stream is filterable on the day it
    /// arrives. <see cref="SchedulerEventKind.Heartbeat" /> is not one: it is the transport saying the
    /// connection is alive, and the reader consumes it before the page ever sees it.
    /// </remarks>
    private static readonly string[] EventTypes =
    [
        .. Enum.GetNames<SchedulerEventKind>().Where(kind => kind != nameof(SchedulerEventKind.Heartbeat))
    ];

    /// <summary>
    /// How many events the page keeps. It is a live view rather than a log: the oldest fall off the end.
    /// </summary>
    private const int Kept = 100;

    private readonly List<LiveEventItem> _events = [];
    private readonly List<LiveEventItem> _filteredEvents = [];
    private readonly HashSet<string> _selectedEventTypes = new(EventTypes, StringComparer.OrdinalIgnoreCase);

    private string? _error;
    private string? _watchedScheduler;
    private bool _streaming;

    /// <summary>
    /// The instance id of the scheduler this page's own process is running, or null when it could not be
    /// read. The toolbar names it so that an event from a peer is distinguishable from a local one.
    /// </summary>
    private string? _thisNode;

    private CancellationTokenSource? _subscription;
    private Task? _reading;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Scheduler.OnSchedulerChanged += OnSchedulerChanged;
            await WatchAsync(Scheduler.ActiveSchedulerName);
            StateHasChanged();
        }
    }

    private async void OnSchedulerChanged(object? sender, EventArgs e)
    {
        try
        {
            await WatchAsync(Scheduler.ActiveSchedulerName);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task RestartAsync() => WatchAsync(Scheduler.ActiveSchedulerName);

    /// <summary>
    /// Subscribes to one scheduler's events, leaving whichever was being watched before.
    /// </summary>
    /// <remarks>
    /// The source is resolved per scheduler rather than injected: a scheduler in another process has a
    /// reader of its own target's stream registered under its name, and one in this process is read from
    /// the broker every scheduler here publishes into. The page cannot tell the two apart, which is the
    /// point — its own events and a remote target's arrive the same way.
    /// </remarks>
    private async Task WatchAsync(string? schedulerName)
    {
        await StopAsync();

        _error = null;
        _watchedScheduler = null;
        _thisNode = null;

        if (string.IsNullOrWhiteSpace(schedulerName))
        {
            return;
        }

        ISchedulerEventSource? source = SchedulerEventSources.For(Services, schedulerName);
        if (source is null)
        {
            _error = "This application registers no event stream, so there is nothing to watch. "
                + "AddQuartzDashboard() registers one for the schedulers in this process.";
            return;
        }

        _watchedScheduler = schedulerName;
        _thisNode = await ReadThisNodeAsync(schedulerName);
        _streaming = true;

        _subscription = new CancellationTokenSource();
        _reading = ReadAsync(source, schedulerName, _subscription.Token);
    }

    /// <summary>
    /// Reads the stream until the page leaves it, which is what makes the view live.
    /// </summary>
    /// <remarks>
    /// A stream that ends is the end of the view rather than an error: the reader behind a remote target
    /// reconnects on its own, and the broker in this process only ends a subscription that was cancelled.
    /// A stream that <em>fails</em> is shown — a target that serves no event stream at all says so through
    /// <see cref="NotSupportedException" />, which is a fact about the target rather than a fault here.
    /// </remarks>
    private async Task ReadAsync(ISchedulerEventSource source, string schedulerName, CancellationToken cancellationToken)
    {
        try
        {
            await foreach (SchedulerEvent schedulerEvent in source.Subscribe(schedulerName, cancellationToken))
            {
                await AddAsync(schedulerEvent);
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception exception)
        {
            _error = exception.Message;
        }
        finally
        {
            _streaming = false;

            try
            {
                await InvokeAsync(StateHasChanged);
            }
            catch (ObjectDisposedException)
            {
                // The circuit went away while the stream was ending, which is the ordinary order of things
                // when a reader navigates off the page.
            }
        }
    }

    private async Task StopAsync()
    {
        _streaming = false;

        if (_subscription is not null)
        {
            await _subscription.CancelAsync();
            _subscription.Dispose();
            _subscription = null;
        }

        if (_reading is not null)
        {
            try
            {
                await _reading;
            }
            catch (Exception)
            {
                // Whatever it was, it was reported when it happened.
            }

            _reading = null;
        }
    }

    /// <summary>
    /// The instance id of the scheduler this page is watching, read the way every other page reads a
    /// scheduler's facts. A data source that cannot answer leaves the toolbar saying nothing about the
    /// node rather than failing the page.
    /// </summary>
    private async Task<string?> ReadThisNodeAsync(string schedulerName)
    {
        try
        {
            SchedulerDetailDto detail = await Api.GetScheduler(schedulerName);
            return detail.SchedulerInstanceId;
        }
        catch (Exception)
        {
            return null;
        }
    }

    private Task AddAsync(SchedulerEvent schedulerEvent)
    {
        LiveEventItem item = new(
            schedulerEvent.OccurredAtUtc,
            schedulerEvent.Kind.ToString(),
            CategoryOf(schedulerEvent),
            schedulerEvent.SchedulerInstanceId,
            Describe(schedulerEvent));

        _events.Insert(0, item);
        if (_events.Count > Kept)
        {
            _events.RemoveAt(_events.Count - 1);
        }

        ApplyEventTypeFilter();
        return InvokeAsync(StateHasChanged);
    }

    private Task ToggleEventType(string eventType, ChangeEventArgs args)
    {
        bool isChecked = args.Value is bool boolValue
            ? boolValue
            : string.Equals(args.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        if (isChecked)
        {
            _selectedEventTypes.Add(eventType);
        }
        else
        {
            _selectedEventTypes.Remove(eventType);
        }

        ApplyEventTypeFilter();
        return InvokeAsync(StateHasChanged);
    }

    private Task SelectAllEventTypes()
    {
        _selectedEventTypes.Clear();
        foreach (string eventType in EventTypes)
        {
            _selectedEventTypes.Add(eventType);
        }

        ApplyEventTypeFilter();
        return InvokeAsync(StateHasChanged);
    }

    private Task ClearEventTypes()
    {
        _selectedEventTypes.Clear();
        ApplyEventTypeFilter();
        return InvokeAsync(StateHasChanged);
    }

    private void ApplyEventTypeFilter()
    {
        _filteredEvents.Clear();
        foreach (LiveEventItem liveEvent in _events)
        {
            if (_selectedEventTypes.Contains(liveEvent.EventType))
            {
                _filteredEvents.Add(liveEvent);
            }
        }
    }

    /// <summary>
    /// What the row says, built from the event's own fields.
    /// </summary>
    /// <remarks>
    /// The page used to render whatever the hub's JSON stringified to, because that is all it had: the
    /// payloads arrived as <c>JsonElement</c>s of eleven different shapes. It holds the record now, so each
    /// kind says the thing a reader is looking for — which job, which trigger, which firing, and how it
    /// went.
    /// </remarks>
    private static string Describe(SchedulerEvent schedulerEvent)
    {
        return schedulerEvent.Kind switch
        {
            SchedulerEventKind.JobExecuting => Job(schedulerEvent) + FiredBy(schedulerEvent),
            SchedulerEventKind.JobExecuted => Job(schedulerEvent) + Outcome(schedulerEvent),
            SchedulerEventKind.JobInterrupted => Job(schedulerEvent) + Firing(schedulerEvent),
            SchedulerEventKind.JobPaused or SchedulerEventKind.JobResumed => Job(schedulerEvent),
            SchedulerEventKind.TriggerFired or SchedulerEventKind.TriggerCompleted => Trigger(schedulerEvent) + Fires(schedulerEvent),
            SchedulerEventKind.TriggerMisfired => Trigger(schedulerEvent) + Fires(schedulerEvent) + " · missed its firing",
            SchedulerEventKind.TriggerInError => Trigger(schedulerEvent) + " · will not fire until it is reset",
            SchedulerEventKind.TriggerPaused or SchedulerEventKind.TriggerResumed => Trigger(schedulerEvent),
            SchedulerEventKind.SchedulerStateChanged => schedulerEvent.Status?.ToString() ?? "",
            SchedulerEventKind.SchedulerError => Error(schedulerEvent),
            _ => ""
        };
    }

    /// <summary>
    /// Which of the three colours the row is. There are three because a wall of events is read at a
    /// glance: something finished, something happened, something went wrong.
    /// </summary>
    private static string CategoryOf(SchedulerEvent schedulerEvent)
    {
        return schedulerEvent.Kind switch
        {
            SchedulerEventKind.JobExecuted when schedulerEvent.ExceptionMessage is not null => "error",
            SchedulerEventKind.JobExecuted when schedulerEvent.Vetoed == true => "info",
            SchedulerEventKind.JobExecuting or SchedulerEventKind.JobExecuted => "success",
            SchedulerEventKind.TriggerCompleted or SchedulerEventKind.TriggerResumed or SchedulerEventKind.JobResumed => "success",
            SchedulerEventKind.TriggerMisfired or SchedulerEventKind.TriggerInError or SchedulerEventKind.SchedulerError => "error",
            _ => "info"
        };
    }

    private static string Job(SchedulerEvent schedulerEvent) => Key(schedulerEvent.JobKey);

    private static string Trigger(SchedulerEvent schedulerEvent) => Key(schedulerEvent.TriggerKey);

    private static string FiredBy(SchedulerEvent schedulerEvent) =>
        schedulerEvent.TriggerKey is null ? "" : " · fired by " + Key(schedulerEvent.TriggerKey);

    private static string Fires(SchedulerEvent schedulerEvent) =>
        schedulerEvent.JobKey is null ? "" : " · fires " + Key(schedulerEvent.JobKey);

    private static string Firing(SchedulerEvent schedulerEvent) =>
        string.IsNullOrWhiteSpace(schedulerEvent.FireInstanceId) ? "" : " · firing " + schedulerEvent.FireInstanceId;

    private static string Outcome(SchedulerEvent schedulerEvent)
    {
        if (schedulerEvent.Vetoed == true)
        {
            return " · vetoed before it ran";
        }

        string ran = schedulerEvent.RunTime is null ? "" : " · ran for " + Ran(schedulerEvent.RunTime.Value);
        return schedulerEvent.ExceptionMessage is null ? ran : ran + " · failed: " + schedulerEvent.ExceptionMessage;
    }

    private static string Error(SchedulerEvent schedulerEvent)
    {
        string message = schedulerEvent.Message ?? "";
        string about = schedulerEvent.TriggerKey is not null
            ? " · " + Key(schedulerEvent.TriggerKey)
            : schedulerEvent.JobKey is not null ? " · " + Key(schedulerEvent.JobKey) : "";

        return schedulerEvent.Cause is null ? message + about : message + about + " · " + schedulerEvent.Cause;
    }

    private static string Key(KeyDto? key) => key is null ? "" : key.Group + "." + key.Name;

    /// <summary>
    /// How long a job ran, in the largest unit that keeps it readable — the way the History page shows the
    /// same figure.
    /// </summary>
    private static string Ran(TimeSpan runTime)
    {
        if (runTime < TimeSpan.FromSeconds(1))
        {
            return runTime.TotalMilliseconds.ToString("0.###", CultureInfo.InvariantCulture) + " ms";
        }

        if (runTime < TimeSpan.FromMinutes(1))
        {
            return runTime.TotalSeconds.ToString("0.##", CultureInfo.InvariantCulture) + " s";
        }

        return runTime.ToString("g", CultureInfo.InvariantCulture);
    }

    public async ValueTask DisposeAsync()
    {
        Scheduler.OnSchedulerChanged -= OnSchedulerChanged;
        await StopAsync();
    }

    private sealed record LiveEventItem(
        DateTimeOffset Timestamp,
        string EventType,
        string Category,
        string? SchedulerInstanceId,
        string Description);
}
