@using Quartz.Dashboard.Services
@inject Quartz.Dashboard.Services.SchedulerState SchedulerState
@inject Quartz.Dashboard.Services.IQuartzApiClient ApiClient
@inject Quartz.Dashboard.Services.SchedulerAuthorization Authorization
@implements IDisposable

<div class="qz-scheduler-selector">
    <select class="qz-scheduler-select"
            value="@SchedulerState.ActiveSchedulerName"
            @onchange="OnSchedulerChanged"
            aria-label="Select scheduler">
        @if (SchedulerState.AvailableSchedulers.Count == 0)
        {
            <option value="">Loading…</option>
        }
        else
        {
            @foreach (Quartz.Dashboard.Services.SchedulerHeaderDto scheduler in SchedulerState.AvailableSchedulers)
            {
                @* A registration nothing has built is offered and greyed out rather than omitted: it is a
                   tenant the container knows about, and leaving it out of the picker is what made it look
                   as though it had never been registered. There is nothing behind it to select. *@
                <option value="@scheduler.SchedulerName" disabled="@(!scheduler.IsCreated)">
                    @(scheduler.IsCreated ? scheduler.SchedulerName : scheduler.SchedulerName + " (not created)")
                </option>
            }
        }
    </select>

    <span class="qz-scheduler-status">
        @if (_schedulerStatus is { } status)
        {
            <Quartz.Dashboard.Components.Shared.SchedulerStatusIndicator Status="status" Large="true" />
        }
        else
        {
            <span class="qz-state-dot qz-state-dot-lg qz-state-waiting" aria-hidden="true"></span>
            <span>@_statusLabel</span>
        }
    </span>
</div>

@code
{
    /// <summary>
    /// What to say while there is no status to show: the scheduler has not been asked yet, or could not
    /// be reached. Neither is a <see cref="SchedulerStatus" />, which is why they are a label of their own.
    /// </summary>
    private string _statusLabel = "Loading…";

    private SchedulerStatus? _schedulerStatus;

    protected override async Task OnInitializedAsync()
    {
        SchedulerState.OnSchedulerChanged += OnStateChanged;
        await LoadSchedulersAsync();
    }

    private async Task LoadSchedulersAsync()
    {
        try
        {
            System.Collections.Generic.List<Quartz.Dashboard.Services.SchedulerHeaderDto> schedulers =
                await ApiClient.GetSchedulers();

            // Filtered before anything is offered: a name in this list is a name the visitor can select,
            // and the one thing a per-scheduler policy has to prevent is reaching another tenant's.
            SchedulerState.AvailableSchedulers = (await Authorization.Filter(schedulers)).AsReadOnly();

            if (SchedulerState.ActiveSchedulerName is null)
            {
                SchedulerState.ActiveSchedulerName = SchedulerState.DefaultSchedulerName;
            }

            await UpdateStatusAsync();
        }
        catch
        {
            _statusLabel = "Unavailable";
            _schedulerStatus = null;
        }
    }

    private async Task OnSchedulerChanged(ChangeEventArgs e)
    {
        string? selectedName = e.Value?.ToString();
        if (!string.IsNullOrEmpty(selectedName))
        {
            SchedulerState.ActiveSchedulerName = selectedName;
            await UpdateStatusAsync();
        }
    }

    private async Task UpdateStatusAsync()
    {
        if (SchedulerState.ActiveSchedulerName is null)
        {
            return;
        }

        // A registration nothing has built has no scheduler to ask, and asking would answer "no such
        // scheduler" — which reads as a fault rather than as the thing the listing already told us.
        if (SchedulerState.Find(SchedulerState.ActiveSchedulerName) is { IsCreated: false })
        {
            _statusLabel = "Not created";
            _schedulerStatus = null;
            return;
        }

        // A scheduler the visitor may not see is not asked for its status either; the status read is the
        // one call this component makes that is about a single scheduler rather than about the listing.
        if (!await Authorization.IsAuthorized(SchedulerState.ActiveSchedulerName))
        {
            _statusLabel = "Not authorized";
            _schedulerStatus = null;
            return;
        }

        try
        {
            Quartz.Dashboard.Services.SchedulerDetailDto detail =
                await ApiClient.GetScheduler(SchedulerState.ActiveSchedulerName);

            _schedulerStatus = detail.Status;
        }
        catch
        {
            _statusLabel = "Unknown";
            _schedulerStatus = null;
        }
    }

    public void Dispose()
    {
        SchedulerState.OnSchedulerChanged -= OnStateChanged;
    }

    private async void OnStateChanged(object? sender, EventArgs e)
    {
        await UpdateStatusAsync();
        await InvokeAsync(StateHasChanged);
    }
}
