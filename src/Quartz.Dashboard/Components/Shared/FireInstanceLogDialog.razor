@using System.Globalization
@using System.Text
@using Microsoft.Extensions.DependencyInjection
@using Microsoft.Extensions.Options
@using Microsoft.JSInterop
@using Quartz
@using Quartz.Dashboard.Services
@implements IAsyncDisposable
@inject IQuartzApiClient Api
@inject SchedulerState Scheduler
@inject IOptions<QuartzDashboardOptions> Options
@inject IServiceProvider Services
@inject IJSRuntime JS

@* Follows one running firing's log (#4437): every two seconds while it is open, the lines after the last one it has,
   read in the process running the firing. It holds its own copy of the row, so the page's refresh dropping a finished
   firing leaves it open; and its own timer, which the dialog closing, or the page going, stops. *@
<ModalDialog Class="qz-log-dialog" LabelledBy="qz-log-dialog-title" TestId="log-dialog" ReturnFocus="ReturnFocus" ReturnFocusFallback="ReturnFocusFallback" OnCancel="CloseAsync">
    @if (_phase != Phase.Stopped)
    {
        <AutoRefresh Every="PollInterval" Refresh="TickAsync" />
    }

    <h3 id="qz-log-dialog-title">Log of @JobLabel · @TriggerLabel</h3>
    <p class="qz-log-dialog-meta" data-testid="log-meta">
        Node <strong>@Firing.SchedulerInstanceId</strong> · fired @Scheduler.FormatInSelectedTimeZone(Firing.FireTimeUtc, "u") · run time @RunTime
    </p>

    <div class="qz-log-dialog-statusbar">
        @* Only what changes the reader's situation is in the live region: the state, never the count of lines or the
           time of the last read, which change every two seconds and would be read out each time. *@
        <p class="qz-log-dialog-status" data-testid="log-status">
            <span role="status" data-testid="log-state">
                @switch (_outcome)
                {
                    case Outcome.None when _lastError is not null:
                        <span>The last read failed, and the next one is in two seconds: @_lastError</span>
                        break;
                    case Outcome.None when _phase == Phase.HandingOver:
                        <span>The run ended. Looking for its execution page…</span>
                        break;
                    case Outcome.None when _received == 0 && _updatedAt is null:
                        <span>Reading…</span>
                        break;
                    case Outcome.None when _paused:
                        <span>Paused</span>
                        break;
                    case Outcome.None when _received == 0:
                        <span>Nothing logged yet</span>
                        break;
                    case Outcome.None:
                        <span>Following</span>
                        break;
                    case Outcome.Ended when _recordedLog is not null:
                        <span>
                            The run ended. This is its log as recorded.
                            <a class="qz-log-dialog-link" data-testid="log-execution-link" href="@ExecutionPath">Open its execution page</a>
                        </span>
                        break;
                    case Outcome.Ended:
                        <span>
                            The run ended. Its full log, with the lines logged after the last read, is on its
                            <a class="qz-log-dialog-link" data-testid="log-execution-link" href="@ExecutionPath">execution page</a>.
                        </span>
                        break;
                    case Outcome.EndedWithoutRow:
                        <span>
                            The run ended, and its execution is not in the history yet. The trigger's
                            <a class="qz-log-dialog-link" data-testid="log-past-runs-link" href="@PastRunsPath">Past runs</a> list it once it is.
                        </span>
                        break;
                    case Outcome.EndedWithoutHistory:
                        <span>This scheduler keeps no history, so the log is not kept after the run.</span>
                        break;
                    case Outcome.NotCaptured:
                        <span>
                            This scheduler keeps no log lines of its firings. Call <code>UseExecutionLogCapture()</code> on it to
                            follow a firing here and to keep its log on its execution page.
                        </span>
                        break;
                    case Outcome.OtherNode:
                        <span>@Firing.SchedulerInstanceId runs this firing, and this target reaches @_answeringNode. Open @(Firing.SchedulerInstanceId)'s target to follow its log.</span>
                        break;
                    case Outcome.Unreachable when _answeringNode is null:
                        <span>
                            No process this dashboard reaches runs this firing: the scheduler is read through its store. Its log is
                            on its execution page once it ends.
                        </span>
                        break;
                    case Outcome.Unreachable:
                        <span>
                            @_answeringNode runs this firing, and no member target of this cluster fronts it, so its log cannot be
                            followed here. Its log is on its execution page once it ends.
                        </span>
                        break;
                    case Outcome.NotSupported:
                        <span>@_lastError</span>
                        break;
                    case Outcome.Failed:
                        <span>Stopped after @MaxFailures failed reads in a row: @_lastError</span>
                        break;
                }
            </span>
            @if (Progress is { } progress)
            {
                <span class="qz-log-dialog-progress" data-testid="log-progress">@progress</span>
            }
        </p>
        @if (ShowsJumpToLatest)
        {
            <button type="button" class="qz-button" data-testid="log-jump" @onclick="JumpToLatestAsync">Jump to latest</button>
        }
    </div>

    @* No box until there is a line to put in it. *@
    @if (LogText.Length > 0)
    {
        <div class="qz-log-follow" data-testid="log-scroller" @ref="_scroller">
            <pre class="qz-execution-log" tabindex="0" aria-label="Log lines" data-testid="log-lines" @ref="_logLines">@LogText</pre>
        </div>
    }

    <div class="qz-confirm-actions">
        @if (_outcome == Outcome.Failed)
        {
            <button type="button" class="qz-button qz-button-primary" data-testid="log-retry" @onclick="RetryAsync">Retry</button>
        }
        <button type="button" class="qz-button" data-testid="log-close" @onclick="CloseAsync">Close</button>
    </div>
</ModalDialog>

@code {
    /// <summary>How often the dialog reads while it follows the firing, and while it looks for its execution page.</summary>
    internal static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(2);

    /// <summary>Pages read at once, after the tick's first, while the answer says the reader is behind.</summary>
    internal const int MaxExtraPages = 4;

    /// <summary>Failed reads in a row after which the dialog stops and offers Retry.</summary>
    internal const int MaxFailures = 3;

    /// <summary>Reads of the history, two seconds apart, for the execution of a firing that ended: it may be written behind.</summary>
    internal const int MaxHistoryReads = 5;

    /// <summary>The newest entries the dialog keeps, which bounds one circuit's memory for a long run.</summary>
    internal const int MaxLines = 2000;

    internal const string EarlierLinesMarker = "[earlier lines are on the execution page once the run ends]";

    private enum Phase
    {
        Following,
        HandingOver,
        Stopped,
    }

    private enum Outcome
    {
        None,
        Ended,
        EndedWithoutRow,
        EndedWithoutHistory,
        NotCaptured,
        OtherNode,
        Unreachable,
        NotSupported,
        Failed,
    }

    private readonly List<string> _lines = [];
    private readonly CancellationTokenSource _cancellation = new();

    /// <summary>
    /// The token of <see cref="_cancellation" />, taken once: a read that ends after the dialog went must not reach
    /// for the disposed source.
    /// </summary>
    private CancellationToken _token;

    private Phase _phase = Phase.Following;
    private Outcome _outcome = Outcome.None;
    private bool _trimmed;
    private string? _text;
    private long _next;
    private long _received;
    private int _failures;
    private int _historyReads;
    private bool _busy;
    private string? _lastError;
    private string? _answeringNode;
    private string? _executionId;
    private DateTimeOffset? _updatedAt;
    private DateTimeOffset? _endedAt;

    /// <summary>The log as the history recorded it, which the dialog shows in full once the run has ended.</summary>
    private string? _recordedLog;

    /// <summary>How long the run took, as the history recorded it.</summary>
    private TimeSpan? _recordedDuration;

    /// <summary>Whether the reader scrolled up off the newest line, and how many lines arrived below since.</summary>
    private bool _paused;
    private long _newWhilePaused;

    private ElementReference _scroller;
    private ElementReference _logLines;
    private bool _observing;
    private int _observer;
    private DotNetObjectReference<FireInstanceLogDialog>? _self;
    private bool _disposed;

    /// <summary>
    /// The row the dialog was opened from, as it was then: the page's refresh does not reach it.
    /// </summary>
    [Parameter]
    [EditorRequired]
    public FireInstanceDto Firing { get; set; } = null!;

    /// <summary>The key of the scheduler the firing belongs to, as the page was showing it.</summary>
    [Parameter]
    [EditorRequired]
    public string SchedulerName { get; set; } = null!;

    /// <summary>The control that opened the dialog, which focus goes back to as it closes.</summary>
    [Parameter]
    public ElementReference? ReturnFocus { get; set; }

    /// <summary>Where focus goes as the dialog closes when the opener's row has left the listing by then.</summary>
    [Parameter]
    public ElementReference? ReturnFocusFallback { get; set; }

    /// <summary>Raised by Close and Escape; the page drops the dialog.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    private TimeProvider Clock => Services.GetService<TimeProvider>() ?? TimeProvider.System;

    private string JobLabel => Firing.JobKey is { } job ? DisplayValueHelper.FormatKey(job.Group, job.Name) : "—";

    private string TriggerLabel => DisplayValueHelper.FormatKey(Firing.TriggerKey.Group, Firing.TriggerKey.Name);

    private string LineCount => _received == 1 ? "1 line" : _received.ToString(CultureInfo.InvariantCulture) + " lines";

    /// <summary>
    /// What the status line says beside the state while the dialog follows the firing, outside the live region: the
    /// lines and the last read's time, or the lines below a reader who scrolled up. <see langword="null" /> otherwise.
    /// </summary>
    private string? Progress
    {
        get
        {
            if (_outcome != Outcome.None || _phase != Phase.Following || _lastError is not null || _updatedAt is null)
            {
                return null;
            }

            if (_paused)
            {
                return _newWhilePaused == 1
                    ? " · 1 new line below"
                    : string.Create(CultureInfo.InvariantCulture, $" · {_newWhilePaused} new lines below");
            }

            // Led by a space of its own: the renderer keeps none between two elements.
            return _received == 0 ? " · updated " + UpdatedAt : " · " + LineCount + " · updated " + UpdatedAt;
        }
    }

    /// <summary>
    /// Whether Jump to latest is offered: for as long as the reader is scrolled up, the run's end included. It goes only
    /// when the reader is back on the newest line, by the button, which moves focus to the log first, or by scrolling,
    /// so it never takes focus out of the dialog with it.
    /// </summary>
    private bool ShowsJumpToLatest => _paused && LogText.Length > 0;

    private string UpdatedAt => _updatedAt is { } at
        ? Scheduler.ConvertToSelectedTimeZone(at).ToString("HH:mm:ss", CultureInfo.InvariantCulture)
        : string.Empty;

    /// <summary>
    /// The run time, as Currently Executing's table writes it: as the history recorded it once the run has ended and its
    /// row is found, else counted to the read that saw it end, else to now. One format throughout, so the header does
    /// not jump as the run ends.
    /// </summary>
    private string RunTime
    {
        get
        {
            TimeSpan runTime = _recordedDuration is { } recorded && recorded > TimeSpan.Zero
                ? recorded
                : (_endedAt ?? Clock.GetUtcNow()) - Firing.FireTimeUtc;
            return DisplayValueHelper.FormatClock(runTime < TimeSpan.Zero ? TimeSpan.Zero : runTime);
        }
    }

    private string ExecutionPath => DashboardLink.To(Options.Value, "history/" + Uri.EscapeDataString(_executionId ?? string.Empty));

    private string PastRunsPath => DashboardLink.HistoryOfTrigger(Options.Value, Firing.TriggerKey.Group, Firing.TriggerKey.Name);

    /// <summary>
    /// What the log shows: the lines read so far, oldest first, as Razor-encoded text, never markup.
    /// </summary>
    private string LogText
    {
        get
        {
            if (_recordedLog is not null)
            {
                return _recordedLog;
            }

            if (_text is null)
            {
                StringBuilder text = new();
                if (_trimmed)
                {
                    text.Append(EarlierLinesMarker);
                }

                foreach (string line in _lines)
                {
                    if (text.Length > 0)
                    {
                        text.Append('\n');
                    }

                    text.Append(line);
                }

                _text = text.ToString();
            }

            return _text;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _token = _cancellation.Token;
        await TickAsync();
    }

    /// <summary>
    /// One tick: a read of the log while the dialog follows the firing, or of the history once it has ended. A tick
    /// that comes while a read is still in flight does nothing.
    /// </summary>
    private async Task TickAsync()
    {
        if (_busy || _phase == Phase.Stopped || _token.IsCancellationRequested)
        {
            return;
        }

        _busy = true;
        try
        {
            if (_phase == Phase.Following)
            {
                await FollowAsync();
            }
            else
            {
                await FindExecutionAsync();
            }
        }
        finally
        {
            _busy = false;
        }

        StateHasChanged();
    }

    /// <summary>
    /// Reads the lines after the last one the dialog has, and once more at once, up to <see cref="MaxExtraPages" />
    /// times, while the answer says it is behind.
    /// </summary>
    private async Task FollowAsync()
    {
        for (int read = 0; read <= MaxExtraPages; read++)
        {
            FireInstanceLogDto answer;
            try
            {
                answer = await Api.GetFireInstanceLog(SchedulerName, new DashboardFireInstanceLogQuery
                {
                    FireInstanceId = Firing.FireInstanceId,
                    After = _next,
                    SchedulerInstanceId = Firing.SchedulerInstanceId,
                }, _token);
            }
            catch (OperationCanceledException) when (_token.IsCancellationRequested)
            {
                // The dialog closed, or its page went: nobody is waiting for the answer.
                return;
            }
            catch (NotSupportedException ex)
            {
                // A host older than 4.9, or a data source that cannot read a running log: nothing to retry.
                _lastError = ex.Message;
                Stop(Outcome.NotSupported);
                return;
            }
            catch (Exception ex)
            {
                _lastError = ex.Message;
                if (++_failures >= MaxFailures)
                {
                    Stop(Outcome.Failed);
                }

                return;
            }

            _failures = 0;
            _lastError = null;
            _updatedAt = Clock.GetUtcNow();

            switch (answer.Status)
            {
                case FireInstanceLogStatus.Running:
                    Append(answer);
                    if (!answer.HasMore)
                    {
                        return;
                    }

                    continue;

                case FireInstanceLogStatus.NotCaptured:
                    Stop(Outcome.NotCaptured);
                    return;

                case FireInstanceLogStatus.NotRunning when answer.SchedulerInstanceId is not null
                                                           && !string.Equals(answer.SchedulerInstanceId, Firing.SchedulerInstanceId, StringComparison.OrdinalIgnoreCase):
                    // Another node answered: this target does not reach the one running the firing, and asking it
                    // again will not change that.
                    _answeringNode = answer.SchedulerInstanceId;
                    Stop(Outcome.OtherNode);
                    return;

                case FireInstanceLogStatus.NotRunning:
                    // The firing's own node no longer runs it, or the store lists it no more: it ended. Its log is
                    // on its execution page once the history has its row, which may be written behind.
                    _phase = Phase.HandingOver;
                    _endedAt = _updatedAt;
                    await FindExecutionAsync();
                    return;

                default:
                    _answeringNode = answer.SchedulerInstanceId;
                    Stop(Outcome.Unreachable);
                    return;
            }
        }
    }

    /// <summary>
    /// Looks for the execution of the firing that ended, up to <see cref="MaxHistoryReads" /> times, a tick apart.
    /// </summary>
    private async Task FindExecutionAsync()
    {
        _historyReads++;
        try
        {
            PagedResult<DashboardHistoryEntry> page = await Api.QueryExecutions(new DashboardHistoryQuery
            {
                SchedulerName = SchedulerName,
                FireInstanceId = Firing.FireInstanceId,
                Take = 1,
            }, _token);

            if (page.Items.FirstOrDefault() is { EntryId: { Length: > 0 } entryId } row)
            {
                // The lines logged after the last read went with the firing's buffer; the row the history wrote has
                // them, when its listing carries the log, and the run time it took.
                _executionId = entryId;
                _recordedLog = string.IsNullOrEmpty(row.Log) ? null : row.Log;
                _recordedDuration = row.Duration;
                Stop(Outcome.Ended);
                return;
            }
        }
        catch (OperationCanceledException) when (_token.IsCancellationRequested)
        {
            return;
        }
        catch (NotSupportedException)
        {
            Stop(Outcome.EndedWithoutHistory);
            return;
        }
        catch (Exception)
        {
            // Counted as a read that found nothing: the next tick asks again.
        }

        if (_historyReads >= MaxHistoryReads)
        {
            Stop(Outcome.EndedWithoutRow);
        }
    }

    /// <summary>
    /// Keeps the answer's entries, after a line that says how many the capture dropped before they could be read.
    /// </summary>
    private void Append(FireInstanceLogDto answer)
    {
        if (answer.Missed > 0)
        {
            _lines.Add(answer.Missed == 1
                ? "[1 line was dropped before it could be shown: the capture keeps only its newest lines]"
                : string.Create(CultureInfo.InvariantCulture, $"[{answer.Missed} lines were dropped before they could be shown: the capture keeps only its newest lines]"));
        }

        _lines.AddRange(answer.Entries);
        _received += answer.Entries.Count;
        if (_paused)
        {
            _newWhilePaused += answer.Entries.Count;
        }

        _next = answer.Next;

        if (_lines.Count > MaxLines)
        {
            _lines.RemoveRange(0, _lines.Count - MaxLines);
            _trimmed = true;
        }

        _text = null;
    }

    private void Stop(Outcome outcome)
    {
        _outcome = outcome;
        _phase = Phase.Stopped;
    }

    /// <summary>
    /// Follows the firing again after the dialog stopped on failed reads, reading at once.
    /// </summary>
    private async Task RetryAsync()
    {
        _failures = 0;
        _lastError = null;
        _outcome = Outcome.None;
        _phase = Phase.Following;
        await TickAsync();
    }

    private Task CloseAsync() => OnClose.InvokeAsync();

    /// <summary>
    /// Watches the log's scroller once it is on the page, so the dialog knows when the reader scrolls up off the newest
    /// line and back. The browser holds the newest line in view itself: the scroller is a column-reverse one.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_observing || _disposed || LogText.Length == 0)
        {
            return;
        }

        _observing = true;
        _self = DotNetObjectReference.Create(this);
        try
        {
            _observer = await JS.InvokeAsync<int>("quartzDashboardLogFollow.observe", _scroller, _self);
        }
        catch (JSException)
        {
            // The script did not run: the log still stays on its newest line, and the status never says paused.
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
            // Rendered where there is no browser.
        }
    }

    /// <summary>
    /// Called by the browser as the reader scrolls off the newest line, and back onto it.
    /// </summary>
    [JSInvokable]
    public Task OnFollowingChanged(bool following)
    {
        return InvokeAsync(() =>
        {
            if (_disposed || _paused == !following)
            {
                return;
            }

            _paused = !following;
            _newWhilePaused = 0;
            StateHasChanged();
        });
    }

    /// <summary>
    /// Scrolls to the newest line and follows again, with focus on the log: the button goes as the dialog follows again,
    /// and focus must not go with it to the page behind the dialog.
    /// </summary>
    private async Task JumpToLatestAsync()
    {
        _paused = false;
        _newWhilePaused = 0;
        try
        {
            await JS.InvokeVoidAsync("quartzDashboardLogFollow.toLatest", _scroller);
            await _logLines.FocusAsync(preventScroll: true);
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
        catch (InvalidOperationException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _cancellation.Cancel();
        _cancellation.Dispose();

        if (_observer != 0)
        {
            try
            {
                await JS.InvokeVoidAsync("quartzDashboardLogFollow.unobserve", _observer);
            }
            catch (JSException)
            {
            }
            catch (JSDisconnectedException)
            {
            }
            catch (InvalidOperationException)
            {
            }
        }

        _self?.Dispose();
    }
}
