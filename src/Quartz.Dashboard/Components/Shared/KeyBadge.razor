@inject Microsoft.JSInterop.IJSRuntime JsRuntime

<span class="qz-key-badge" title="@FullKey">
    @* A break opportunity after the group's dot, so a listing that wraps a long key breaks it there first. *@
    <span class="qz-key-badge-value">@GroupPart<wbr />@NamePart</span>
    <button type="button"
            class="qz-key-badge-copy"
            aria-label="Copy key"
            @onclick="CopyAsync"
            @onclick:stopPropagation="true"
            @onclick:preventDefault="true">
        @(_copied ? "Copied" : "Copy")
    </button>
</span>

@code {
    private bool _copied;

    [Parameter]
    public string GroupName { get; set; } = string.Empty;

    [Parameter]
    public string ItemName { get; set; } = string.Empty;

    private string FullKey => DisplayValueHelper.FormatKey(GroupName, ItemName);

    /// <summary>The group and its dot, as <see cref="FullKey" /> begins.</summary>
    private string GroupPart => FullKey[..(FullKey.Length - NamePart.Length)];

    /// <summary>The name, as <see cref="FullKey" /> ends.</summary>
    private string NamePart => string.IsNullOrWhiteSpace(ItemName) ? "(unknown)" : ItemName;

    protected override void OnParametersSet()
    {
        _copied = false;
    }

    private async Task CopyAsync()
    {
        try
        {
            bool copied = await JsRuntime.InvokeAsync<bool>("quartzDashboardClipboard.copyText", new object?[] { FullKey });
            _copied = copied;
        }
        catch (System.Text.Json.JsonException)
        {
            _copied = false;
        }
        catch (Microsoft.JSInterop.JSException)
        {
            _copied = false;
        }
        catch (InvalidOperationException)
        {
            _copied = false;
        }
    }
}
