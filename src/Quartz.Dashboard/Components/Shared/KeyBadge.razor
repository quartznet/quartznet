@inject Microsoft.JSInterop.IJSRuntime JsRuntime

<span class="qz-key-badge" title="@FullKey">
    @* A break opportunity between each two of the key's words, so a listing that wraps a long key breaks it there
       rather than wherever the line runs out. The text is the key exactly. *@
    <span class="qz-key-badge-value">@for (int i = 0; i < _segments.Count; i++)
        {
            if (i > 0)
            {
                <wbr />
            }
            @_segments[i]
        }</span>
    <button type="button"
            class="qz-key-badge-copy"
            aria-label="Copy key"
            @onclick="CopyAsync"
            @onclick:stopPropagation="true"
            @onclick:preventDefault="true">
        @(_copied ? "Copied" : "Copy")
    </button>
</span>

@code {
    private bool _copied;
    private List<string> _segments = [];

    [Parameter]
    public string GroupName { get; set; } = string.Empty;

    [Parameter]
    public string ItemName { get; set; } = string.Empty;

    private string FullKey => DisplayValueHelper.FormatKey(GroupName, ItemName);

    protected override void OnParametersSet()
    {
        _copied = false;
        _segments = DisplayValueHelper.KeyLineSegments(FullKey);
    }

    private async Task CopyAsync()
    {
        try
        {
            bool copied = await JsRuntime.InvokeAsync<bool>("quartzDashboardClipboard.copyText", new object?[] { FullKey });
            _copied = copied;
        }
        catch (System.Text.Json.JsonException)
        {
            _copied = false;
        }
        catch (Microsoft.JSInterop.JSException)
        {
            _copied = false;
        }
        catch (InvalidOperationException)
        {
            _copied = false;
        }
    }
}
