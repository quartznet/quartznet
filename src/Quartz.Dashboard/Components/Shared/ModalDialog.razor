@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

@* The frame a dashboard dialog draws in, and what makes it modal for a keyboard: focus moves to the dialog as it
   opens, Tab and Shift+Tab wrap inside it through the two guards either side, Escape is the dialog's Cancel, and
   focus goes back to what had it, the control that opened the dialog, when it closes. The parent renders it while
   the dialog is open and drops it to close it. The guards are empty and pass focus on as they get it, so they are
   not hidden from assistive technology: a focusable element must not be. *@
<div class="qz-confirm-overlay" data-testid="modal-overlay" @onkeydown="OnKeyDownAsync">
    <span class="qz-focus-guard" tabindex="0" data-testid="modal-guard-start" @onfocus="FocusLastAsync"></span>
    <div @ref="_dialog"
         class="qz-confirm-dialog"
         role="dialog"
         aria-modal="true"
         aria-labelledby="@LabelledBy"
         tabindex="-1">
        @ChildContent
    </div>
    <span class="qz-focus-guard" tabindex="0" data-testid="modal-guard-end" @onfocus="FocusFirstAsync"></span>
</div>

@code {
    private ElementReference _dialog;

    /// <summary>The dialog's content: its heading, its message and its actions.</summary>
    [Parameter]
    [EditorRequired]
    public RenderFragment ChildContent { get; set; } = null!;

    /// <summary>The id of the element that names the dialog, its heading.</summary>
    [Parameter]
    public string? LabelledBy { get; set; }

    /// <summary>Raised by Escape: what the dialog's own Cancel does.</summary>
    [Parameter]
    public EventCallback OnCancel { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CallAsync("quartzDashboardDialog.open", _dialog);
        }
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key is "Escape" or "Esc")
        {
            await OnCancel.InvokeAsync();
        }
    }

    /// <summary>Tab past the last control lands on the closing guard, which sends focus to the first.</summary>
    private Task FocusFirstAsync() => CallAsync("quartzDashboardDialog.focusFirst", _dialog);

    /// <summary>Shift+Tab before the first control lands on the opening guard, which sends focus to the last.</summary>
    private Task FocusLastAsync() => CallAsync("quartzDashboardDialog.focusLast", _dialog);

    public async ValueTask DisposeAsync()
    {
        await CallAsync("quartzDashboardDialog.close");
    }

    /// <summary>
    /// A focus move, which a circuit that has gone, or a page still prerendering, cannot make. Neither is a failure
    /// of the dialog.
    /// </summary>
    private async Task CallAsync(string identifier, params object?[] arguments)
    {
        try
        {
            await JS.InvokeVoidAsync(identifier, arguments);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (TaskCanceledException)
        {
        }
        catch (InvalidOperationException)
        {
            // JavaScript interop is not available while prerendering.
        }
    }
}
