@using System.Globalization
@using Microsoft.Extensions.DependencyInjection
@using Quartz
@using Quartz.Dashboard.Services
@using Quartz.Extensibility
@using Quartz.Impl.Triggers
@inject IQuartzApiClient Api
@inject SchedulerState Scheduler
@inject IServiceProvider Services

@* The next fires of Expression as Trigger would have them once rescheduled to it: computed on the clone a save
   would post, so in the trigger's own time zone, from its start or now, whichever is later, until its end, and
   less what its calendar excludes. The times show in the dashboard's zone, as the page's other times do. *@
<div class="qz-cron-next-fires">
    @if (_error is { } error)
    {
        <ErrorAlert Message="@error" />
    }
    else if (_unsupported)
    {
        <span class="qz-muted">The dashboard cannot preview this trigger's fire times.</span>
    }
    else if (!_readingCalendar)
    {
        @if (_nextFires.Count == 0)
        {
            <span class="qz-muted">No upcoming fire times.</span>
        }
        else
        {
            <ul class="qz-list">
                @foreach (DateTimeOffset nextFire in _nextFires)
                {
                    <li>
                        <span>@Scheduler.FormatInSelectedTimeZone(nextFire, "u")</span>
                        <span class="qz-muted">(@Until(nextFire))</span>
                    </li>
                }
            </ul>
        }

        @if (Basis is { } basis)
        {
            <p class="qz-muted" data-testid="cron-next-fires-basis">@basis</p>
        }

        @if (_calendarUnreadable is { } reason)
        {
            <p class="qz-muted" data-testid="cron-next-fires-calendar">Calendar '@Trigger.CalendarName' could not be read, so these times include any it excludes. @reason</p>
        }
    }
</div>

@code {
    private readonly List<DateTimeOffset> _nextFires = [];
    private string? _error;
    private bool _unsupported;
    private string? _timeZoneId;
    private DateTimeOffset _now;

    private ITrigger? _calendarReadFor;
    private ICalendar? _calendar;
    private string? _calendarUnreadable;
    private bool _readingCalendar;

    /// <summary>
    /// The trigger as the page last read it: its type, zone, start, end and calendar are the preview's.
    /// </summary>
    [Parameter]
    [EditorRequired]
    public ITrigger Trigger { get; set; } = null!;

    /// <summary>
    /// The expression to preview, which is the one in the editor rather than the one saved.
    /// </summary>
    [Parameter]
    public string? Expression { get; set; }

    [Parameter]
    public int Count { get; set; } = 5;

    private TimeProvider Clock => Services.GetService<TimeProvider>() ?? TimeProvider.System;

    /// <summary>
    /// What the times were computed in and against, said once: the expression's hours are the trigger's
    /// zone's, which the times in the list, shown in the dashboard's zone, need not be.
    /// </summary>
    private string? Basis => _timeZoneId is not { } timeZoneId
        ? null
        : _calendar is null
            ? "Read in " + timeZoneId + ", the trigger's time zone."
            : "Read in " + timeZoneId + ", the trigger's time zone, less what calendar '" + Trigger.CalendarName + "' excludes.";

    /// <summary>
    /// Reads the calendar once per trigger the page reads, and computes the fires on every render, since an
    /// edit to the expression arrives as one.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (!ReferenceEquals(Trigger, _calendarReadFor))
        {
            await ReadCalendarAsync(Trigger);
        }

        RebuildFireTimes();
    }

    /// <summary>
    /// The calendar the trigger names, read the way the backfill dialog reads it. One that cannot be read
    /// leaves the preview without it, and says so; the trigger is already on the page, and failing the page
    /// for its preview would take that away.
    /// </summary>
    private async Task ReadCalendarAsync(ITrigger trigger)
    {
        _calendarReadFor = trigger;
        _calendar = null;
        _calendarUnreadable = null;

        string? schedulerName = Scheduler.ActiveSchedulerName;
        if (string.IsNullOrWhiteSpace(trigger.CalendarName) || string.IsNullOrWhiteSpace(schedulerName))
        {
            return;
        }

        _readingCalendar = true;
        ICalendar? calendar = null;
        string? unreadable = null;
        try
        {
            calendar = await Api.GetCalendar(schedulerName, trigger.CalendarName);
        }
        catch (Exception ex)
        {
            unreadable = ex.Message;
        }

        // The page may have read the trigger again while this one's calendar was on its way.
        if (ReferenceEquals(trigger, _calendarReadFor))
        {
            _calendar = calendar;
            _calendarUnreadable = unreadable;
            _readingCalendar = false;
        }
    }

    private void RebuildFireTimes()
    {
        _nextFires.Clear();
        _error = null;
        _unsupported = false;
        _timeZoneId = null;
        _now = Clock.GetUtcNow();

        string expression = Expression?.Trim() ?? string.Empty;
        if (expression.Length == 0)
        {
            return;
        }

        ITrigger? preview;
        try
        {
            if (!TriggerPayloadBuilder.TryWithCronExpression(Trigger, expression, out preview))
            {
                _unsupported = true;
                return;
            }
        }
        catch (FormatException ex)
        {
            _error = "Invalid cron expression: " + ex.Message;
            return;
        }

        // The clone has no next fire time, so its first is computed the way RescheduleJob computes it: from its
        // start, or from now when the start is behind it. Now is the dashboard's clock, not the one the trigger
        // happened to be read with.
        ((TriggerBase) preview).TimeProvider = Clock;
        _timeZoneId = ((ICronTrigger) preview).TimeZone.Id;
        _nextFires.AddRange(TriggerFireTimes.Compute(preview, _calendar, Count <= 0 ? 1 : Count));
    }

    /// <summary>
    /// How long until <paramref name="fireTime" />, to the largest whole unit.
    /// </summary>
    private string Until(DateTimeOffset fireTime)
    {
        TimeSpan until = fireTime - _now;
        if (until < TimeSpan.FromMinutes(1))
        {
            return "in under a minute";
        }

        if (until < TimeSpan.FromHours(1))
        {
            return string.Create(CultureInfo.InvariantCulture, $"in {until.Minutes}m");
        }

        if (until < TimeSpan.FromDays(1))
        {
            return string.Create(CultureInfo.InvariantCulture, $"in {until.Hours}h");
        }

        return string.Create(CultureInfo.InvariantCulture, $"in {until.Days}d");
    }
}
