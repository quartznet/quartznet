@using System.Globalization
@using Quartz
@using Quartz.Dashboard.Services
@using Quartz.Extensibility
@using Microsoft.Extensions.DependencyInjection
@implements IDisposable
@inject IQuartzApiClient Api
@inject IServiceProvider Services

<section class="qz-section">
    <h2>Execution groups</h2>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <ErrorAlert Message="@_error" OnRetry="LoadDataAsync" />
    }
    else if (!_limits.CanReport)
    {
        <p class="qz-muted">
            This scheduler cannot report execution limits, so what each group may run is unknown here.
        </p>
    }
    else if (_rows.Count == 0)
    {
        <p class="qz-muted">
            No execution group is limited and nothing is in flight, so every trigger is free to fire.
        </p>
    }
    else
    {
        <p class="qz-muted">@ScopeSentence</p>

        @if (_routing is not null)
        {
            <p class="qz-muted">@RoutingSentence</p>
        }

        <table class="qz-table">
            <thead>
                <tr>
                    <th>Group</th>
                    <th>Scope</th>
                    <th>Limit</th>
                    <th>In flight</th>
                    <th>Headroom</th>
                    @if (_routing is not null)
                    {
                        <th>Served here</th>
                        <th>Overdue</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (GroupRow row in _rows)
                {
                    <tr>
                        <td>
                            @row.Label
                            @if (row.IsDerived)
                            {
                                <span class="qz-muted">&nbsp;(from trigger group)</span>
                            }
                            @if (row.IsCatchAll)
                            {
                                <span class="qz-muted">&nbsp;(catch-all)</span>
                            }
                        </td>
                        <td>@ScopeOf(row)</td>
                        <td>
                            @LimitOf(row)
                            @if (row.InheritedFrom is { } inheritedFrom)
                            {
                                <span class="qz-muted">&nbsp;(@LabelFor(inheritedFrom))</span>
                            }
                        </td>
                        <td>@InFlightOf(row)</td>
                        <td>@HeadroomOf(row)</td>
                        @if (_routing is not null)
                        {
                            <td>@ServedHereOf(row)</td>
                            <td>
                                @OverdueOf(row)
                                @if (row.IsOverdueAndUnserved)
                                {
                                    <span class="qz-muted">&nbsp;(not served here)</span>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>

        @if (_hasOverdueUnservedRow)
        {
            <p class="qz-muted">
                A group marked <em>not served here</em> has triggers more than @OverdueCutoffMinutes minutes overdue that this node does not serve.
                Overdue and not served by this node: check that a node serving this group is running.
            </p>
        }

        @if (_hasCatchAllRow)
        {
            <p class="qz-muted">
                <em>other groups</em> is the ceiling every group with no limit of its own gets, one
                allowance each rather than one shared between them, so it counts nothing itself.
            </p>
        }

        @if (_hasPrefixRow)
        {
            <p class="qz-muted">
                A <em>groups starting with</em> row is the ceiling each group with that prefix gets, one
                allowance each, so it counts nothing itself. The longest matching prefix wins, and a
                group's own limit wins over any prefix.
            </p>
        }

        @if (_nodeScopedLimitsAreCountedClusterWide)
        {
            <p class="qz-muted">
                A node-scoped limit is what one node may run, while the counts here are the whole
                cluster's, so its headroom is smaller than what this node can still spend.
            </p>
        }

        @if (_countsArePartial)
        {
            <p class="qz-muted">
                The counts are taken from the first @_firingsCounted firings; there are more in flight.
            </p>
        }
    }
</section>

@code {
    /// <summary>
    /// The panel joins what a scheduler allows — <c>IQuartzApiClient.GetExecutionLimits</c> — with what it
    /// is running, so that the ceilings <c>execution-groups.md</c> teaches are visible somewhere other
    /// than in the configuration file that set them.
    /// </summary>
    /// <remarks>
    /// Both firing states are counted, because a reservation holds a slot exactly as a running execution
    /// does: that is what the acquisition filter counts against a limit, and a panel that counted only
    /// the running ones would show headroom the next acquisition cannot use.
    /// </remarks>
    private readonly List<GroupRow> _rows = [];

    /// <summary>
    /// How far past its fire time a schedulable trigger has to be before the panel counts it overdue:
    /// five minutes, a fixed figure because the dashboard does not know the store's misfire threshold.
    /// The health check, which does, measures in thresholds.
    /// </summary>
    private const int OverdueCutoffMinutes = 5;

    private ExecutionLimitsDto _limits = new([]);
    private string? _error;
    private bool _loadingInProgress;
    private bool _countsArePartial;
    private bool _hasCatchAllRow;
    private bool _hasPrefixRow;
    private bool _hasOverdueUnservedRow;
    private bool _nodeScopedLimitsAreCountedClusterWide;
    private int _firingsCounted;
    private bool _hasLoaded;
    private string? _loadedSchedulerName;
    private PeriodicTimer? _refreshTimer;
    private CancellationTokenSource? _refreshLoopCancellation;

    /// <summary>
    /// Which execution groups the node serves, rebuilt from the two lists the scheduler reports, or
    /// null for a node that serves every group — which is also every scheduler older than 4.6.
    /// </summary>
    private ExecutionGroupRouting? _routing;

    [Parameter]
    public string? SchedulerName { get; set; }

    /// <summary>
    /// The execution groups the node serves and nothing else, as its details report them; empty when it
    /// serves every group not refused.
    /// </summary>
    [Parameter]
    public string[] ServedExecutionGroups { get; set; } = [];

    /// <summary>
    /// The execution groups the node refuses; empty when it refuses none.
    /// </summary>
    [Parameter]
    public string[] RefusedExecutionGroups { get; set; } = [];

    private TimeProvider Clock => Services.GetService<TimeProvider>() ?? TimeProvider.System;

    /// <summary>
    /// Whether the scheduler's job store survives a restart, which is also what decides whose firings the
    /// firing listing carries: a persistent store answers for the whole cluster, an in-memory one for
    /// this node.
    /// </summary>
    [Parameter]
    public bool Persistent { get; set; }

    /// <summary>
    /// Whether the store is clustered, which is the only case in which a node-scoped limit and a
    /// cluster-wide count are different measurements.
    /// </summary>
    [Parameter]
    public bool Clustered { get; set; }

    private string ScopeSentence => Persistent
        ? "Counted across the cluster: the job store is persistent, so a firing owned by any node is counted here."
        : "Counted on this node: the job store keeps its firings in memory, so another node's work is not counted here.";

    /// <summary>
    /// Which groups this node routes, in the words the configuration used.
    /// </summary>
    private string RoutingSentence
    {
        get
        {
            if (_routing is null)
            {
                return "";
            }

            string groups = string.Join(", ", _routing.Spellings.Select(LabelFor));
            return _routing.IsServeList
                ? "This node serves only " + groups + "; a trigger of any other group waits for a node that serves it."
                : "This node refuses " + groups + "; a trigger of those groups waits for a node that serves it.";
        }
    }

    protected override void OnInitialized()
    {
        _refreshLoopCancellation = new CancellationTokenSource();
        // Slower than the overview's executing count, for the reason the Cluster page is slower: every
        // tick is two reads of a persistent store, and a limit changes on the scale of a deployment.
        _refreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        _ = RunRefreshLoopAsync(_refreshLoopCancellation.Token);
    }

    /// <remarks>
    /// Guarded on the scheduler rather than reloading on every parameter set: the overview re-renders
    /// once a second to keep its executing count current, and each of those renders would otherwise be
    /// two more reads of the store.
    /// </remarks>
    protected override async Task OnParametersSetAsync()
    {
        if (_hasLoaded
            && string.Equals(_loadedSchedulerName, SchedulerName, StringComparison.Ordinal)
            && ReferenceEquals(_loadedServed, ServedExecutionGroups)
            && ReferenceEquals(_loadedRefused, RefusedExecutionGroups))
        {
            return;
        }

        _hasLoaded = true;
        _loadedSchedulerName = SchedulerName;
        _loadedServed = ServedExecutionGroups;
        _loadedRefused = RefusedExecutionGroups;
        await LoadDataAsync();
    }

    /// <summary>
    /// The routing lists the last load was made with: the overview re-reads the scheduler's details
    /// and hands new arrays over, and a changed list is a reason to load again where the same one is not.
    /// </summary>
    private string[]? _loadedServed;

    private string[]? _loadedRefused;

    private async Task RunRefreshLoopAsync(CancellationToken cancellationToken)
    {
        if (_refreshTimer is null)
        {
            return;
        }

        try
        {
            while (await _refreshTimer.WaitForNextTickAsync(cancellationToken))
            {
                try
                {
                    await InvokeAsync(async () =>
                    {
                        await LoadDataAsync();
                        StateHasChanged();
                    });
                }
                catch (OperationCanceledException)
                {
                    break;
                }
                catch (ObjectDisposedException)
                {
                    break;
                }
                catch (InvalidOperationException)
                {
                }
                catch (Exception ex)
                {
                    _error = ex.Message;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
    }

    private async Task LoadDataAsync()
    {
        if (_loadingInProgress)
        {
            return;
        }

        _loadingInProgress = true;
        _error = null;

        try
        {
            _rows.Clear();
            _limits = new ExecutionLimitsDto([]);
            _countsArePartial = false;
            _hasCatchAllRow = false;
            _hasPrefixRow = false;
            _hasOverdueUnservedRow = false;
            _nodeScopedLimitsAreCountedClusterWide = false;
            _firingsCounted = 0;
            _routing = ExecutionGroupRouting.FromSpellings(ServedExecutionGroups, RefusedExecutionGroups);

            string? schedulerName = SchedulerName;
            if (string.IsNullOrWhiteSpace(schedulerName))
            {
                return;
            }

            _limits = await Api.GetExecutionLimits(schedulerName);
            if (!_limits.CanReport)
            {
                return;
            }

            // Both states, because a reservation holds a slot as surely as a running execution does.
            PagedResult<FireInstanceDto> firings = await Api.QueryFireInstances(
                schedulerName,
                new DashboardFireInstanceQuery { State = null });

            // One more read for a node that routes, and none for one that does not: the schedulable
            // triggers more than five minutes overdue, which under routing are the ones no live node is
            // serving. Counted by group beside the firings, so the row says both.
            Dictionary<string, int>? overdue = null;
            if (_routing is not null)
            {
                PagedResult<TriggerHeaderDto> late = await Api.QueryTriggers(
                    schedulerName,
                    new DashboardTriggerQuery
                    {
                        State = TriggerState.Normal,
                        NextFireTimeBefore = Clock.GetUtcNow() - TimeSpan.FromMinutes(OverdueCutoffMinutes),
                    });

                overdue = new Dictionary<string, int>(StringComparer.Ordinal);
                foreach (TriggerHeaderDto header in late.Items)
                {
                    string key = header.ExecutionGroup ?? ExecutionLimits.DefaultGroupAlias;
                    overdue[key] = overdue.TryGetValue(key, out int count) ? count + 1 : 1;
                }
            }

            _firingsCounted = firings.Items.Count;
            _countsArePartial = firings.HasMore;
            BuildRows(_limits, firings.Items, overdue);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loadingInProgress = false;
        }
    }

    private void BuildRows(ExecutionLimitsDto limits, IReadOnlyList<FireInstanceDto> firings, Dictionary<string, int>? overdue)
    {
        Dictionary<string, int> inFlight = new(StringComparer.Ordinal);
        HashSet<string> derived = new(StringComparer.Ordinal);

        foreach (FireInstanceDto firing in firings)
        {
            // The scheduler's own resolution, so the panel and the acquisition filter cannot key the
            // same firing differently when UseTriggerGroupWhenUnset is on.
            string key = AsConfigurationKey(ExecutionLimits.ResolveGroupKey(
                firing.ExecutionGroup,
                firing.TriggerKey.Group,
                limits.UsesTriggerGroupWhenUnset));

            inFlight[key] = inFlight.TryGetValue(key, out int count) ? count + 1 : 1;

            if (firing.ExecutionGroup is null && key != ExecutionLimits.DefaultGroupAlias)
            {
                derived.Add(key);
            }
        }

        HashSet<string> keys = new(limits.Limits.Keys, StringComparer.Ordinal);
        keys.UnionWith(inFlight.Keys);

        // A node that routes lists what it routes and what is overdue as well, so a group it serves
        // with nothing running still has a row saying so, and a group nobody serves has one too.
        if (_routing is not null)
        {
            keys.UnionWith(_routing.Spellings);
        }

        if (overdue is not null)
        {
            keys.UnionWith(overdue.Keys);
        }

        List<GroupRow> rows = [];
        foreach (string key in keys)
        {
            bool isCatchAll = key == ExecutionLimits.OtherGroups;

            // A configured "tenant:*" is a rule, like the catch-all. A group in flight whose own name
            // happens to end in '*' is still a group, and is only a rule when the limits say so.
            string? prefix = null;
            bool isPrefix = limits.Limits.ContainsKey(key) && ExecutionLimits.TryReadPrefixKey(key, out prefix);
            DashboardExecutionLimit? limit = ResolveLimit(limits, key, out string? inheritedFrom);
            bool isRule = isCatchAll || isPrefix;

            // The catch-all and a prefix are rules about other groups, which routing has no opinion on.
            bool? servedHere = _routing is null || isRule
                ? null
                : _routing.Serves(key == ExecutionLimits.DefaultGroupAlias ? null : key);

            rows.Add(new GroupRow(
                Key: key,
                Label: isPrefix ? $"groups starting with '{prefix}'" : LabelFor(key),
                IsCatchAll: isCatchAll,
                IsPrefix: isPrefix,
                IsDerived: derived.Contains(key),
                Limit: limit,
                InheritedFrom: inheritedFrom,
                InFlight: inFlight.TryGetValue(key, out int count) ? count : 0,
                ServedHere: servedHere,
                Overdue: overdue is not null && overdue.TryGetValue(key, out int lateCount) ? lateCount : 0));
        }

        // Named groups first, alphabetically; then the ungrouped bucket, which is a group only in the
        // sense that the limits give it a bucket; then the prefixes and the catch-all, which are rules
        // about the rest.
        rows.Sort(static (left, right) =>
        {
            int byKind = SortKind(left).CompareTo(SortKind(right));
            return byKind != 0 ? byKind : string.Compare(left.Label, right.Label, StringComparison.OrdinalIgnoreCase);
        });

        _rows.AddRange(rows);
        _hasCatchAllRow = limits.Limits.ContainsKey(ExecutionLimits.OtherGroups);
        _hasPrefixRow = rows.Exists(static row => row.IsPrefix);
        _hasOverdueUnservedRow = rows.Exists(static row => row.IsOverdueAndUnserved);
        _nodeScopedLimitsAreCountedClusterWide = Clustered
            && rows.Exists(static row => row.Limit is { Scope: ExecutionLimitScope.Node });
    }

    private static int SortKind(GroupRow row)
    {
        if (row.IsCatchAll)
        {
            return 3;
        }

        if (row.IsPrefix)
        {
            return 2;
        }

        return row.Key == ExecutionLimits.DefaultGroupAlias ? 1 : 0;
    }

    /// <summary>
    /// The limit that governs one group: its own when it has one, otherwise the longest prefix it starts
    /// with, otherwise the catch-all — neither of which applies to the ungrouped bucket. The same rule the
    /// scheduler applies.
    /// </summary>
    private static DashboardExecutionLimit? ResolveLimit(ExecutionLimitsDto limits, string key, out string? inheritedFrom)
    {
        inheritedFrom = null;

        if (limits.Limits.TryGetValue(key, out DashboardExecutionLimit own))
        {
            return own;
        }

        if (key == ExecutionLimits.DefaultGroupAlias)
        {
            return null;
        }

        string? longest = null;
        foreach (string candidate in limits.Limits.Keys)
        {
            if (ExecutionLimits.TryReadPrefixKey(candidate, out string? prefix)
                && key.StartsWith(prefix, StringComparison.Ordinal)
                && (longest is null || candidate.Length > longest.Length))
            {
                longest = candidate;
            }
        }

        if (longest is not null)
        {
            inheritedFrom = longest;
            return limits.Limits[longest];
        }

        if (limits.Limits.TryGetValue(ExecutionLimits.OtherGroups, out DashboardExecutionLimit catchAll))
        {
            inheritedFrom = ExecutionLimits.OtherGroups;
            return catchAll;
        }

        return null;
    }

    /// <summary>
    /// The limits arrive keyed the way configuration spells a group; a firing resolves to the key the
    /// limits hold internally, where the ungrouped bucket is the empty string.
    /// </summary>
    private static string AsConfigurationKey(string storageKey)
    {
        return storageKey == ExecutionLimits.DefaultGroupKey ? ExecutionLimits.DefaultGroupAlias : storageKey;
    }

    private static string LabelFor(string key)
    {
        if (key == ExecutionLimits.OtherGroups)
        {
            return "other groups";
        }

        return key == ExecutionLimits.DefaultGroupAlias ? "(no execution group)" : key;
    }

    private static string ScopeOf(GroupRow row)
    {
        return row.Limit is { } limit ? limit.Scope.ToString() : "—";
    }

    private static string LimitOf(GroupRow row)
    {
        if (row.Limit is not { } limit || limit.MaxConcurrent is not int maxConcurrent)
        {
            return "Unlimited";
        }

        return maxConcurrent == 0
            ? "0 (forbidden)"
            : maxConcurrent.ToString(CultureInfo.InvariantCulture);
    }

    private static string InFlightOf(GroupRow row)
    {
        return row.IsRule ? "—" : row.InFlight.ToString(CultureInfo.InvariantCulture);
    }

    private static string HeadroomOf(GroupRow row)
    {
        if (row.IsRule)
        {
            return "—";
        }

        if (row.Limit is not { } limit || limit.MaxConcurrent is not int maxConcurrent)
        {
            return "Unlimited";
        }

        return Math.Max(0, maxConcurrent - row.InFlight).ToString(CultureInfo.InvariantCulture);
    }

    private static string ServedHereOf(GroupRow row)
    {
        return row.ServedHere switch
        {
            true => "✓",
            false => "—",
            null => "—"
        };
    }

    private static string OverdueOf(GroupRow row)
    {
        return row.IsRule ? "—" : row.Overdue.ToString(CultureInfo.InvariantCulture);
    }

    public void Dispose()
    {
        _refreshLoopCancellation?.Cancel();
        _refreshLoopCancellation?.Dispose();
        _refreshTimer?.Dispose();
    }

    /// <summary>
    /// One row: an execution group, the limit that governs it, and what it has in flight.
    /// </summary>
    private sealed record GroupRow(
        string Key,
        string Label,
        bool IsCatchAll,
        bool IsPrefix,
        bool IsDerived,
        DashboardExecutionLimit? Limit,
        string? InheritedFrom,
        int InFlight,
        bool? ServedHere,
        int Overdue)
    {
        /// <summary>
        /// A row that is a rule about other groups — the catch-all or a prefix — rather than a group, so
        /// it has nothing in flight of its own.
        /// </summary>
        public bool IsRule => IsCatchAll || IsPrefix;

        /// <summary>
        /// A group with triggers past the overdue cutoff that this node does not serve: the one row an
        /// operator has to act on, by starting a node that serves it.
        /// </summary>
        public bool IsOverdueAndUnserved => ServedHere == false && Overdue > 0;
    }
}
