<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <NoWarn>CAC001</NoWarn>
    <SonarQubeExclude>true</SonarQubeExclude>
    <AnalysisLevel>none</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="**\TestData\*" />
    <Compile Include="..\Quartz.Tests.Unit\TestConstants.cs" />
    <Compile Include="..\Quartz.Tests.Unit\TestJobStores.cs" />
    <!--
      A SQLite file a fixture owns, with pooling off so that no teardown anywhere has to reach for the
      process-global SqliteConnection.ClearAllPools (#3755). Shared by source with the two other test
      projects, because the fixtures that needed it are spread across all three.
    -->
    <Compile Include="..\Quartz.Tests.Unit\SqliteTestDatabase.cs" />
    <!--
      The zones and walk helpers the daylight saving time tests are written against. Shared rather
      than copied so that both projects state a transition premise the same way, and so a zone that
      moves is corrected in one place.
    -->
    <Compile Include="..\Quartz.Tests.Unit\TestTimeZones.cs" />
    <!--
      The manifest UpgradeRehearsalTest reads its expectations from, shared with the project that
      writes it by source rather than by reference. Quartz.Tests.Integration.Seeder builds against the
      released Quartz 3.20.0 package, whose assembly identity is this repository's own, so nothing may
      reference both; the file is BCL-only for exactly that reason.
    -->
    <Compile Include="..\Quartz.Tests.Integration.Seeder\SeedManifest.cs" />
    <!--
      The misfire scaffolding: a store on a clock the test moves, driven through one misfire pass by
      hand. It needs nothing but a SQLite file, so the matrices themselves live in the unit project
      where the coverage gate can see them; the fixtures that stayed here — a calendar's exclusion and
      a paused or blocked trigger — share the same scaffolding rather than a copy of it.
    -->
    <Compile Include="..\Quartz.Tests.Unit\Impl\MisfireThroughAStoreTestBase.cs" />
    <Compile Include="..\Quartz.Tests.Unit\Impl\MisfireExpectation.cs" />
    <Compile Include="..\Quartz.Tests.Unit\Impl\MisfireMatrixCases.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AwesomeAssertions" />
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="AwesomeAssertions.Analyzers" />
    <PackageReference Include="FakeItEasy" />
    <PackageReference Include="FirebirdSql.Data.FirebirdClient" />
    <!--
      Marten and Wolverine's PostgreSQL and SQL Server message stores, beside Quartz on one database: the
      Weasel tests join Quartz's tables to a Marten store and run Wolverine's own schema next to them. Both
      pin an older Weasel than Quartz.Weasel's floor, which is the dependency graph an application beside
      them restores.
    -->
    <PackageReference Include="Marten" />
    <PackageReference Include="MELT" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Data.SQLite" />
    <!--
      Quartz itself only needs Microsoft.Extensions.Hosting.Abstractions. A scenario that stands a real
      host up around a scheduler needs the host, which the Microsoft.AspNetCore.App framework reference
      above carries; an explicit package reference beside it is refused as redundant (NU1510).
    -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" />
    <PackageReference Include="System.Data.SQLite.Core" />
    <PackageReference Include="Testcontainers.FirebirdSql" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Testcontainers.MySql" />
    <PackageReference Include="Testcontainers.Oracle" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="TimeZoneConverter" />
    <PackageReference Include="WolverineFx.Postgresql" />
    <PackageReference Include="WolverineFx.SqlServer" />
  </ItemGroup>

  <ItemGroup>
    <!--
      FleetClusterIntegrationTest stands two API hosts up on Kestrel over one database and fronts them from a
      dashboard container, which is the one fixture here that needs ASP.NET Core and the three packages
      that sit on it.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Quartz\Quartz.csproj" />
    <ProjectReference Include="..\Quartz.AspNetCore\Quartz.AspNetCore.csproj" />
    <ProjectReference Include="..\Quartz.Dashboard\Quartz.Dashboard.csproj" />
    <ProjectReference Include="..\Quartz.Dashboard.Agent\Quartz.Dashboard.Agent.csproj" />
    <ProjectReference Include="..\Quartz.HttpClient\Quartz.HttpClient.csproj" />
    <ProjectReference Include="..\Quartz.Jobs\Quartz.Jobs.csproj" />
    <ProjectReference Include="..\Quartz.Serialization.Newtonsoft\Quartz.Serialization.Newtonsoft.csproj" />
    <ProjectReference Include="..\Quartz.Extensions.Redis\Quartz.Extensions.Redis.csproj" />
    <ProjectReference Include="..\Quartz.Weasel.Firebird\Quartz.Weasel.Firebird.csproj" />
    <ProjectReference Include="..\Quartz.Weasel.MySQL\Quartz.Weasel.MySQL.csproj" />
    <ProjectReference Include="..\Quartz.Weasel.Oracle\Quartz.Weasel.Oracle.csproj" />
    <ProjectReference Include="..\Quartz.Weasel.PostgreSQL\Quartz.Weasel.PostgreSQL.csproj" />
    <ProjectReference Include="..\Quartz.Weasel.SqlServer\Quartz.Weasel.SqlServer.csproj" />
    <!--
      Built, never referenced: MixedVersionClusterPostgresTest runs it out of process, twice - as it builds
      against the working tree and against a released Quartz - and the released build has this
      repository's Quartz assembly identity. Listed so that building the tests builds both nodes.
    -->
    <ProjectReference Include="..\Quartz.Tests.Integration.MixedVersionNode\Quartz.Tests.Integration.MixedVersionNode.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <GlobalPackageReference Remove="Meziantou.Analyzer" />
  </ItemGroup>

</Project>