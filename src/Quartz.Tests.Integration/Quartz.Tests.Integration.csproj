<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <NoWarn>CAC001</NoWarn>
    <SonarQubeExclude>true</SonarQubeExclude>
    <AnalysisLevel>none</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="**\TestData\*" />
    <Compile Include="..\Quartz.Tests.Unit\TestConstants.cs" />
    <Compile Include="..\Quartz.Tests.Unit\TestJobStores.cs" />
    <!--
      The zones and walk helpers the daylight saving time tests are written against. Shared rather
      than copied so that both projects state a transition premise the same way, and so a zone that
      moves is corrected in one place.
    -->
    <Compile Include="..\Quartz.Tests.Unit\TestTimeZones.cs" />
    <!--
      The manifest UpgradeRehearsalTest reads its expectations from, shared with the project that
      writes it by source rather than by reference. Quartz.Tests.Integration.Seeder builds against the
      released Quartz 3.20.0 package, whose assembly identity is this repository's own, so nothing may
      reference both; the file is BCL-only for exactly that reason.
    -->
    <Compile Include="..\Quartz.Tests.Integration.Seeder\SeedManifest.cs" />
    <!--
      The misfire scaffolding: a store on a clock the test moves, driven through one misfire pass by
      hand. It needs nothing but a SQLite file, so the matrices themselves live in the unit project
      where the coverage gate can see them; the fixtures that stayed here — a calendar's exclusion and
      a paused or blocked trigger — share the same scaffolding rather than a copy of it.
    -->
    <Compile Include="..\Quartz.Tests.Unit\Impl\MisfireThroughAStoreTestBase.cs" />
    <Compile Include="..\Quartz.Tests.Unit\Impl\MisfireExpectation.cs" />
    <Compile Include="..\Quartz.Tests.Unit\Impl\MisfireMatrixCases.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AwesomeAssertions" />
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="AwesomeAssertions.Analyzers" />
    <PackageReference Include="FakeItEasy" />
    <PackageReference Include="FirebirdSql.Data.FirebirdClient" />
    <PackageReference Include="MELT" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Data.SQLite" />
    <!--
      Quartz itself only needs Microsoft.Extensions.Hosting.Abstractions. A scenario that stands a real
      host up around a scheduler needs the host, which is this package.
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="NUnit.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Oracle.ManagedDataAccess.Core" />
    <PackageReference Include="System.Data.SQLite.Core" />
    <PackageReference Include="Testcontainers.FirebirdSql" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Testcontainers.MySql" />
    <PackageReference Include="Testcontainers.Oracle" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="TimeZoneConverter" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Quartz\Quartz.csproj" />
    <ProjectReference Include="..\Quartz.Jobs\Quartz.Jobs.csproj" />
    <ProjectReference Include="..\Quartz.Serialization.Newtonsoft\Quartz.Serialization.Newtonsoft.csproj" />
    <ProjectReference Include="..\Quartz.Extensions.Redis\Quartz.Extensions.Redis.csproj" />
  </ItemGroup>

  <ItemGroup>
    <GlobalPackageReference Remove="Meziantou.Analyzer" />
  </ItemGroup>

</Project>