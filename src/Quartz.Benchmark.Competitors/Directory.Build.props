<Project>

  <Import Project="..\..\Directory.Build.props" />

  <PropertyGroup>
    <!--
      The repository's artifacts folder. The SDK roots the layout beside the nearest Directory.Build.props,
      which is this one, so without this the output would land in this project's own artifacts folder.
      Quartz.Benchmark says why the benchmark projects build into the layout at all: BenchmarkDotNet 0.16
      gives each job's build an ArtifactsPath of its own, and output outside the layout is locked by the
      process that started the run.
    -->
    <ArtifactsPath>$(MSBuildThisFileDirectory)..\..\artifacts</ArtifactsPath>

    <!--
      TickerQ and Hangfire.PostgreSql ship unsigned assemblies, and a strong-named assembly referencing
      one is CS8002 — a warning, which TreatWarningsAsErrors turns into a build failure. Nothing here
      ships or is referenced by anything that does, so the signature buys nothing and costs the whole
      comparison.
    -->
    <SignAssembly>false</SignAssembly>
  </PropertyGroup>

</Project>
