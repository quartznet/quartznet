<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The standalone dashboard: Quartz.Dashboard in a process of its own, configured from Quartz:Dashboard
    and nothing else (#3775). One project, two distributions: this package is the `dotnet tool`
    quartz-dashboard, and `dotnet fallout PublishContainer` publishes the same project as the image
    ghcr.io/quartznet/quartz-dashboard. Quartz.Aspire.Hosting runs that image.

    Program is internal and nothing here is public: the contract is the configuration keys, which
    docs/documentation/quartz-4.x/packages/dashboard-host.md lists and Quartz.Tests.Aspire holds the
    Aspire resource to.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Quartz.Dashboard.Host</RootNamespace>
    <Title>Quartz.NET Dashboard Host</Title>
    <Description>Quartz.NET dashboard host - the dashboard as a dotnet tool, configured entirely from Quartz:Dashboard settings: HTTP targets, attached stores, agents and sign-in by token or OpenID Connect; $(Description)</Description>
    <PackageTags>$(PackageTags);dashboard;tool;blazor;monitoring;fleet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>quartz-dashboard</ToolCommandName>
    <!-- Framework-dependent: run on whatever .NET the machine has, from 10 up. -->
    <RollForward>Major</RollForward>
    <!--
      Not trimmable, for Quartz.Dashboard's reason: Blazor Server binds its components by reflection.
      The tool and the image are framework-dependent publishes, so nothing is trimmed.
    -->
    <IsTrimmable>false</IsTrimmable>
    <!--
      The dashboard's pages are Blazor and this project has no .razor file of its own, so without this the
      SDK leaves _framework/blazor.web.js out of the static web assets and the circuit never starts.
    -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
    <!--
      Binding is the compiler's, as in Quartz and Quartz.Aspire: the host is not trimmed, but the
      generated binder is the one the rest of Quartz reads configuration with, and it names a key it
      cannot bind at compile time rather than skipping it.
    -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <!--
      A tool carries its dependencies inside its package and its nuspec names none, so there is no floor
      here for a consumer to inherit; and the drivers ask for framework extensions above the floors in
      Directory.Packages.props. Off, the host resolves what its packages ask for.
    -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    The container image, for `dotnet fallout PublishContainer` and ContainerSmoke. The registry, the
    tags and the architectures are the build's: a release publishes linux-x64 and linux-arm64 as one
    index. ContainerSmoke builds the runner's own architecture into the local daemon, then publishes both
    to a local registry with the release's command.

    noble-chiseled-extra rather than plain chiseled: the extra variant carries ICU and tzdata, which a
    dashboard showing cron schedules in their own time zones needs. Chiseled images run as the non-root
    app user and have no shell, so the health check is the orchestrator's: GET /healthz.
  -->
  <PropertyGroup>
    <ContainerRepository>quartznet/quartz-dashboard</ContainerRepository>
    <ContainerFamily>noble-chiseled-extra</ContainerFamily>
    <!--
      The architectures a multi-architecture publish restores and builds, derived from
      ContainerRuntimeIdentifiers. Passed on the command line, RuntimeIdentifiers is a global property and
      reaches every project in the graph, so no library is RID-agnostic any more. Each one is built once
      per architecture, and Quartz.Analyzers built for linux-arm64 is an arm64 assembly that the compiler
      on an x64 machine cannot load (CS8034, which stopped the 4.8.0 image). Set here, it is this
      project's alone. Only a container publish sets ContainerRuntimeIdentifiers, so a pack still makes
      the one tool package, for any RID.
    -->
    <RuntimeIdentifiers Condition="'$(ContainerRuntimeIdentifiers)' != ''">$(ContainerRuntimeIdentifiers)</RuntimeIdentifiers>
    <!--
      One architecture's build after the other. Each one hands its ContainerRuntimeIdentifier down to the
      libraries it references, so every library gets a project instance per architecture, and they all
      build into one folder now that none of them is per-RID. A later instance can still decide to
      recompile, because the first thing it does touches its AssemblyInfoInputs.cache. Built in parallel,
      two instances of Quartz.Analyzers or Quartz then compiled into one obj folder at once, and one
      compiler could not open the assembly the other was writing (CS2012). This goes once the SDK has the
      fix for dotnet/sdk#57267.
    -->
    <ContainerPublishInParallel>false</ContainerPublishInParallel>
    <!--
      The image's labels, through the properties the SDK labels it from. ContainerLabel items do not
      do it: the SDK adds its own labels after the project's, from Title, Description and
      PackageProjectUrl, and the later label wins. Its description would be the package's, which has a
      semicolon in it. A multi-architecture publish hands the labels to each architecture's build as one
      semicolon-separated list, so the text after that semicolon arrived as a label with no value, and
      _ParseItemsForPublishingSingleContainer failed with MSB4184. Until the SDK has the fix for
      dotnet/sdk#57266, no label value here may contain a semicolon. The source and licence labels come
      from RepositoryUrl and PackageLicenseExpression.
    -->
    <ContainerTitle>Quartz.NET Dashboard</ContainerTitle>
    <ContainerDescription>The Quartz.NET dashboard, configured from Quartz__Dashboard__* environment variables</ContainerDescription>
    <ContainerDocumentationUrl>https://www.quartz-scheduler.net/documentation/quartz-4.x/packages/dashboard-host.html</ContainerDocumentationUrl>
  </PropertyGroup>

  <ItemGroup>
    <ContainerPort Include="8080" Type="tcp" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The connection-string reading Quartz.Aspire does, so a store-attached target with no Provider is
      recognised by the same rules and refused by the same message.
    -->
    <Compile Include="..\Quartz.Aspire\ConnectionStringProviderInference.cs" Link="ConnectionStringProviderInference.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Quartz.Dashboard\Quartz.Dashboard.csproj" />
    <ProjectReference Include="..\Quartz.Serialization.Newtonsoft\Quartz.Serialization.Newtonsoft.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The six drivers Quartz describes, so an attached store can be any of the six databases. -->
    <PackageReference Include="FirebirdSql.Data.FirebirdClient" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Data.SQLite" />
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <!-- GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx: the Oracle and SQL Server drivers bring a vulnerable copy. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <!--
    The static web assets go back into the package after the tool's own publish has taken them out. From
    the .NET 11 SDK on, NuGet packs a single-targeted project in the instance it built, where the .NET 10
    SDK used one of its own per framework. A tool package publishes as it packs, and the publish's
    _CleanupReferencedProjectItemGroups removes every static web asset from Content, which now includes
    the staticwebassets/ files IncludeStaticWebAssetsPackItems added for the package a moment before. The
    package then named three assets in build/Microsoft.AspNetCore.StaticWebAssets.props and carried none,
    and VerifyPackedStaticWebAssets refused it. On the .NET 10 SDK nothing was taken out, and this puts
    back what is already there. This target goes once the SDK has the fix for dotnet/sdk#57154.
  -->
  <Target Name="_QuartzRestoreStaticWebAssetsPackItems" BeforeTargets="_GetPackageFiles" Condition="'@(_StaticWebAssetsFilesToPack)' != ''">
    <ItemGroup>
      <Content Remove="@(_StaticWebAssetsFilesToPack)" />
      <Content Include="@(_StaticWebAssetsFilesToPack)" Pack="true" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    </ItemGroup>
  </Target>

</Project>
