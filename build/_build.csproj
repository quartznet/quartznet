<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace></RootNamespace>
    <NoWarn>CS0649;CS0169</NoWarn>
    <FalloutRootDirectory>..</FalloutRootDirectory>
    <FalloutScriptDirectory>..</FalloutScriptDirectory>
    <FalloutTelemetryVersion>1</FalloutTelemetryVersion>
    <FalloutExcludeConfig>true</FalloutExcludeConfig>
    <FalloutExcludeDirectoryBuild>true</FalloutExcludeDirectoryBuild>
    <FalloutExcludeLogs>true</FalloutExcludeLogs>
    <IsPackable>false</IsPackable>
    <SonarQubeExclude>true</SonarQubeExclude>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fallout.Common" Version="10.4.0" />

    <!--
      SDK 10.0.400 ships NuGet.Frameworks 7.9.0.0 and its targets bind that assembly by strong
      name. Fallout.Common resolves 6.14.3 transitively through NuGet.Packaging, and an app-local
      assembly wins over the one MSBuildLocator registers, so the older copy shadows the SDK's and
      every in-process project evaluation throws. Pinned forward rather than back: the runtime is
      happy binding a higher version, so an SDK that still asks for 6.x is satisfied by 7.9.0 too.
      Remove once Fallout brings a NuGet.Packaging new enough to pull this in itself
      (Fallout-build/Fallout#638).
    -->
    <PackageReference Include="NuGet.Frameworks" Version="7.9.0" />

    <!--
      Fallout resolves both at 10.0.10, which the October 2026 advisories cover:
      GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx for Pkcs, GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj and
      GHSA-r955-8q5j-3h83 for Xml. Raised to the fixed 10.0.13; remove once Fallout brings a fixed version.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

</Project>
