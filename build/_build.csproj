<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace></RootNamespace>
    <NoWarn>CS0649;CS0169</NoWarn>
    <FalloutRootDirectory>..</FalloutRootDirectory>
    <FalloutScriptDirectory>..</FalloutScriptDirectory>
    <FalloutTelemetryVersion>1</FalloutTelemetryVersion>
    <FalloutExcludeConfig>true</FalloutExcludeConfig>
    <FalloutExcludeDirectoryBuild>true</FalloutExcludeDirectoryBuild>
    <FalloutExcludeLogs>true</FalloutExcludeLogs>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <SonarQubeExclude>true</SonarQubeExclude>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The net11.0 consumer Net11ConsumerSmoke copies out of the repository and builds with the .NET 11 SDK
      (Build.Net11.cs). Its sources are an application's, not this project's.
    -->
    <Compile Remove="net11-consumer/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fallout.Components" Version="10.5.0" />

    <!--
      The engine behind the DocsSnippets targets. The library, not the mdsnippets command line tool:
      the tool's directory filter never scans a directory named 'packages', which is where the package
      pages live. See build/Build.Docs.Snippets.cs.
    -->
    <PackageReference Include="MarkdownSnippets" Version="29.0.0" />

    <PackageReference Include="Semver" Version="3.0.0" />

  </ItemGroup>

</Project>
